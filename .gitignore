/target
**/*.rs.bk
# Local-only scratch space — holds signing/notary credentials, never commit.
/ignore/
*.pdb
.DS_Store
.env
.env.local
node_modules
.wrangler
build/
edge/dist/
# the card pages' static files, copied in by `npm -C edge run card-assets`
edge/public/
.agents
.claude
CLAUDE.md
/scripts/**/__pycache__/
.dev.vars
.dev.vars.*

# Packaging sources live in dist/ (icons, entitlements, installer configs):
# keep them visible even where a global gitignore lists dist/.
!/dist/
!/dist/icon/
