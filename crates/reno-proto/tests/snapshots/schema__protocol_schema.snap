              },
              {
                "description": "There is no version to compare: not installed, or the CLI did not report one.",
                "properties": {
                  "type": {
                    "const": "unchecked",
                    "type": "string"
                  }
                },
                "required": [
                  "type"
                ],
                "type": "object"
              }
            ]
          },
          "VersionRange": {
            "description": "Harness CLI versions an adapter supports.",
            "properties": {
              "min": {
                "description": "Oldest supported version.",
                "type": "string"
              },
              "verified": {
                "description": "Newest version the conformance suite passed against.",
                "type": "string"
              }
            },
            "required": [
              "min",
              "verified"
            ],
            "type": "object"
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "description": "Result of `executor.install`.",
        "properties": {
          "executor": {
            "$ref": "#/$defs/ExecutorInfo",
            "description": "The executor after the install and the probe that followed it."
          }
        },
        "required": [
          "executor"
        ],
        "title": "ExecutorInstallResult",
        "type": "object"
      }
    },
    {
      "name": "executor.frames",
      "params": {
        "$defs": {
          "ExecutorId": {
            "pattern": "^[A-Za-z0-9._-]{1,64}$",
            "type": "string"
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "description": "Params of `executor.frames`.",
        "properties": {
          "id": {
            "anyOf": [
              {
                "$ref": "#/$defs/ExecutorId"
              },
              {
                "type": "null"
              }
            ],
            "description": "The executor to report; every executor when absent."
          }
        },
        "title": "ExecutorFramesParams",
        "type": "object"
      },
      "result": {
        "$defs": {
          "ExecutorFrameCounts": {
            "description": "The unrecognised frames of one executor.",
            "properties": {
              "cliVersion": {
                "description": "The CLI version of the executor's last probe, when it had one: the version the kinds\nbelow were first seen under.",
                "type": [
                  "string",
                  "null"
                ]
              },
              "frames": {
                "description": "The kinds, by name. Bounded: a harness cannot grow the list without limit.",
                "items": {
                  "$ref": "#/$defs/UnknownFrameKind"
                },
                "type": "array"
              },
              "id": {
                "$ref": "#/$defs/ExecutorId",
                "description": "The executor."
              }
            },
            "required": [
              "id",
              "frames"
            ],
            "type": "object"
          },
          "ExecutorId": {
            "pattern": "^[A-Za-z0-9._-]{1,64}$",
            "type": "string"
          },
          "UnknownFrameKind": {
            "description": "One kind of frame an executor's wire layer did not recognise.",
            "properties": {
              "count": {
                "description": "How many frames of this kind arrived since the daemon started, or since the executor's CLI\nversion last changed.",
                "format": "uint64",
                "minimum": 0,
                "type": "integer"
              },
              "firstSeenMs": {
                "description": "When the daemon first saw this kind under the executor's current CLI version, in\nmilliseconds since the Unix epoch.",
                "format": "uint64",
                "minimum": 0,
                "type": "integer"
              },
              "kind": {
                "description": "The kind, as the driver names it (`type:foo`, `method:bar`).",
                "type": "string"
              }
            },
            "required": [
              "kind",
              "count",
              "firstSeenMs"
            ],
            "type": "object"
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "description": "Result of `executor.frames`.",
        "properties": {
          "executors": {
            "description": "One entry per executor, by id. An executor that never saw an unknown frame has an empty\n`frames`.",
            "items": {
              "$ref": "#/$defs/ExecutorFrameCounts"
            },
            "type": "array"
          }
        },
        "required": [
          "executors"
        ],
        "title": "ExecutorFramesResult",
        "type": "object"
      }
    },
    {
      "name": "agent.auth",
      "params": {
        "$defs": {
          "RunId": {
            "pattern": "^run_[A-Za-z0-9]{1,64}$",
            "type": "string"
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "description": "Params of `agent.auth`.",
        "properties": {
          "runId": {
            "$ref": "#/$defs/RunId",
            "description": "The run the token was minted for."
          },
          "token": {
            "description": "The run token (the contents of the file named by [`ENV_TOKEN_FILE`]). Never logged.",
            "type": "string"
          }
        },
        "required": [
          "runId",
          "token"
        ],
        "title": "AgentAuthParams",
        "type": "object"
      },
      "result": {
        "$defs": {
          "RunId": {
            "pattern": "^run_[A-Za-z0-9]{1,64}$",
            "type": "string"
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "description": "Result of `agent.auth`.",
        "properties": {
          "bot": {
            "description": "The bot the run is pinned to, if any.",
            "type": [
              "string",
              "null"
            ]
          },
          "runId": {
            "$ref": "#/$defs/RunId",
            "description": "The run the connection now speaks for."
          },
          "scope": {
            "description": "The board scope this run reads and writes: `bot:<name>`, or `run:<id>` for a run with no\nbot.",
            "type": "string"
          }
        },
        "required": [
          "runId",
          "scope"
        ],
        "title": "AgentAuthResult",
        "type": "object"
      }
    },
    {
      "name": "agent.report",
      "params": {
        "$defs": {
          "ReportStatus": {
            "description": "How a run says its work stands.",
            "oneOf": [
              {
                "const": "progress",
                "description": "Work is going on; this is a checkpoint.",
                "type": "string"
              },
              {
                "const": "done",
                "description": "The work is finished.",
                "type": "string"
              },
              {
                "const": "blocked",
                "description": "The run cannot go on without something it does not have.",
                "type": "string"
              },
              {
                "const": "failed",
                "description": "The work failed.",
                "type": "string"
              }
            ]
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "description": "Params of `agent.report`.",
        "properties": {
          "details": {
            "description": "Anything longer, for the transcript.",
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "$ref": "#/$defs/ReportStatus",
            "description": "How the work stands."
          },
          "summary": {
            "description": "One short paragraph.",
            "type": "string"
          }
        },
        "required": [
          "status",
          "summary"
        ],
        "title": "AgentReportParams",
        "type": "object"
      },
      "result": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "description": "Result of `agent.report`.",
        "title": "AgentReportResult",
        "type": "object"
      }
    },
    {
      "name": "agent.request_approval",
      "params": {
        "$defs": {
          "ActionClass": {
            "description": "What kind of action an approval is about.",
            "oneOf": [
              {
                "const": "read",
                "description": "Reading files.",
                "type": "string"
              },
              {
                "const": "edit",
                "description": "Editing files.",
                "type": "string"
              },
              {
                "const": "command",
                "description": "Running a command.",
                "type": "string"
              },
              {
                "const": "network",
                "description": "Network access.",
                "type": "string"
              },
              {
                "const": "mcp_tool",
                "description": "An MCP tool call.",
                "type": "string"
              },
              {
                "const": "other",
                "description": "Anything else.",
                "type": "string"
              }
            ]
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "description": "Params of `agent.request_approval`.",
        "properties": {
          "action": {
            "$ref": "#/$defs/ActionClass",
            "description": "The class of the action to be approved."
          },
          "command": {
            "description": "The command line, for a command action.",
            "type": [
              "string",
              "null"
            ]
          },
          "paths": {
            "default": [],
            "description": "The paths the action touches.",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "reason": {
            "description": "Why the run wants to do it.",
            "type": "string"
          }
        },
        "required": [
          "action",
          "reason"
        ],
        "title": "AgentApprovalParams",
        "type": "object"
      },
      "result": {
        "$defs": {
          "ApprovalOutcome": {
            "description": "How an approval request ended: the executor was told yes or no.",
            "oneOf": [
              {
                "const": "approved",
                "description": "The action may proceed.",
                "type": "string"
              },
              {
                "const": "denied",
                "description": "The action is refused.",
                "type": "string"
              }
            ]
          },
          "ResolvedBy": {
            "description": "Who or what resolved an approval request, and so why the transcript shows the outcome it\ndoes.",
            "oneOf": [
              {
                "description": "A person decided it.",
                "properties": {
                  "type": {
                    "const": "human",
                    "type": "string"
                  }
                },
                "required": [
                  "type"
                ],
                "type": "object"
              },
              {
                "description": "A rule decided it, with no question asked. `name` is a policy rule's `note`, or `rules[N]`\nwhen it has none, or `default` when no rule matched and the policy's default effect\napplied; `standing:<rule id>` for a standing rule a person made (`rule.list`); or\n`builtin:reno-mcp` for a call to one of Reno's own MCP tools.",
                "properties": {
                  "name": {
                    "description": "The rule's name.",
                    "type": "string"
                  },
                  "type": {
                    "const": "rule",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "name"
                ],
                "type": "object"
              },
              {
                "description": "Nobody decided before the approval's time limit, or the run ended or the daemon\nrestarted first. Always an outcome of `denied`.",
                "properties": {
                  "type": {
                    "const": "expired",
                    "type": "string"
                  }
                },
                "required": [
                  "type"
                ],
                "type": "object"
              },
              {
                "description": "The same action was denied earlier in this run, so it was denied again unasked.",
                "properties": {
                  "type": {
                    "const": "repeat_denial",
                    "type": "string"
                  }
                },
                "required": [
                  "type"
                ],
                "type": "object"
              }
            ]
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "description": "Result of `agent.request_approval`: how the request ended.",
        "properties": {
          "by": {
            "$ref": "#/$defs/ResolvedBy",
            "description": "Who or what decided."
          },
          "decision": {
            "$ref": "#/$defs/ApprovalOutcome",
            "description": "Whether the action may go ahead."
          },
          "message": {
            "description": "For a denial, the reason, when one was given.",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "decision",
          "by"
        ],
        "title": "AgentApprovalResult",
        "type": "object"
      }
    },
    {
      "name": "agent.board_read",
      "params": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "description": "Params of `agent.board_read`.",
        "properties": {
          "key": {
            "description": "The key to read. Without one, every key of the scope is listed (without values).",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "title": "AgentBoardReadParams",
        "type": "object"
      },
      "result": {
        "$defs": {
          "BoardEntry": {
            "description": "One entry of a board scope.",
            "properties": {
              "key": {
                "description": "The key.",
                "type": "string"
              },
              "size": {
                "description": "Size of the value in bytes.",
                "format": "uint64",
                "minimum": 0,
                "type": "integer"
              },
              "updatedAtMs": {
                "description": "When it was last written, in milliseconds since the Unix epoch.",
                "format": "uint64",
                "minimum": 0,
                "type": "integer"
              },
              "value": {
                "description": "The value. Absent in a listing.",
                "type": [
                  "string",
                  "null"
                ]
              },
              "version": {
                "description": "How many times the key has been written; the first write is version 1.",
                "format": "uint64",
                "minimum": 0,
                "type": "integer"
              }
            },
            "required": [
              "key",
              "version",
              "size",
              "updatedAtMs"
            ],
            "type": "object"
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "description": "Result of `agent.board_read`.",
        "properties": {
          "entries": {
            "description": "The entry asked for (empty when the key does not exist), or every entry of the scope.",
            "items": {
              "$ref": "#/$defs/BoardEntry"
            },
            "type": "array"
          },
          "scope": {
            "description": "The scope that was read.",
            "type": "string"
          }
        },
        "required": [
          "scope",
          "entries"
        ],
        "title": "AgentBoardReadResult",
        "type": "object"
      }
    },
    {
      "name": "agent.board_write",
      "params": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "description": "Params of `agent.board_write`.",
        "properties": {
          "expectedVersion": {
            "description": "The version the writer last saw (0 for a key that must not exist yet). When it is not the\ncurrent version the write is refused with the current entry. Without it the write always\nsucceeds.",
            "format": "uint64",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "key": {
            "description": "The key.",
            "type": "string"
          },
          "value": {
            "description": "The value, at most [`BOARD_VALUE_MAX_BYTES`] bytes.",
            "type": "string"
          }
        },
        "required": [
          "key",
          "value"
        ],
        "title": "AgentBoardWriteParams",
        "type": "object"
      },
      "result": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "description": "Result of `agent.board_write`.",
        "properties": {
          "scope": {
            "description": "The scope written.",
            "type": "string"
          },
          "version": {
            "description": "The key's version after the write.",
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "scope",
          "version"
        ],
        "title": "AgentBoardWriteResult",
        "type": "object"
      }
    }
  ],
  "notifications": [
    {
      "name": "sub.gap",
      "params": {
        "$defs": {
          "Seq": {
            "description": "A per-run event sequence number. A run's journal numbers its events from 1 without gaps; a\n`from` of `Seq(0)` therefore means \"from the start\".",
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "SubscriptionId": {
            "pattern": "^sub_[A-Za-z0-9]{1,64}$",
            "type": "string"
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "description": "Params of the `sub.gap` notification (ARCH-12).",
        "properties": {
          "resumeFrom": {
            "$ref": "#/$defs/Seq",
            "description": "Re-subscribe with `fromSeq` set to this to continue without loss."
          },
          "subscription": {
            "$ref": "#/$defs/SubscriptionId",
            "description": "The subscription that fell behind and was cut off."
          }
        },
        "required": [
          "subscription",
          "resumeFrom"
        ],
        "title": "SubGapParams",
        "type": "object"
      }
    }
  ],
  "protocolVersion": 1,
  "subscriptions": [
    {
      "item": {
        "$defs": {
          "ActionClass": {
            "description": "What kind of action an approval is about.",
            "oneOf": [
              {
                "const": "read",
                "description": "Reading files.",
                "type": "string"
              },
              {
                "const": "edit",
                "description": "Editing files.",
                "type": "string"
              },
              {
                "const": "command",
                "description": "Running a command.",
                "type": "string"
              },
              {
                "const": "network",
                "description": "Network access.",
                "type": "string"
              },
              {
                "const": "mcp_tool",
                "description": "An MCP tool call.",
                "type": "string"
              },
              {
                "const": "other",
                "description": "Anything else.",
                "type": "string"
              }
            ]
          },
          "ApprovalOutcome": {
            "description": "How an approval request ended: the executor was told yes or no.",
            "oneOf": [
              {
                "const": "approved",
                "description": "The action may proceed.",
                "type": "string"
              },
              {
                "const": "denied",
                "description": "The action is refused.",
                "type": "string"
              }
            ]
          },
          "ApprovalSubject": {
            "description": "The exact thing a human is asked to approve.",
            "properties": {
              "action": {
                "$ref": "#/$defs/ActionClass",
                "description": "Class of the action."
              },
              "command": {
                "description": "The command line, for command actions.",
                "type": [
                  "string",
                  "null"
                ]
              },
              "paths": {
                "default": [],
                "description": "Paths the action touches.",
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "raw": {
                "default": null,
                "description": "The harness's own request, kept for the audit record."
              },
              "tool": {
                "description": "Tool the action goes through.",
                "type": "string"
              }
            },
            "required": [
              "action",
              "tool"
            ],
            "type": "object"
          },
          "BudgetKind": {
            "description": "What a budget limits.",
            "oneOf": [
              {
                "const": "wall_time",
                "description": "How long one run may take (`budget.max_wall_time`). Limits are in milliseconds.",
                "type": "string"
              },
              {
                "const": "tokens",
                "description": "What a bot may spend per local day (`budget.daily_token_ceiling`). Limits are in tokens:\ninput, output and cache writes in full, and cache reads at a fraction of their count\n(`BudgetStatusResult::cache_read_weight_permille`).",
                "type": "string"
              }
            ]
          },
          "CancelledBy": {
            "description": "Who cancelled a run.",
            "oneOf": [
              {
                "const": "user",
                "description": "A person (`run.cancel`).",
                "type": "string"
              },
              {
                "const": "pause",
                "description": "The kill switch (`budget.pause` with `stopLive`).",
                "type": "string"
              }
            ]
          },
          "ExecEvent": {
            "description": "One event from a running executor. A failing harness yields `Done { stop: Error }`; the\nstream itself never errors mid-run.",
            "oneOf": [
              {
                "description": "The harness session began.",
                "properties": {
                  "model": {
                    "description": "Model actually in use.",
                    "type": "string"
                  },
                  "session": {
                    "$ref": "#/$defs/SessionRef",
                    "description": "Handle for resuming this session."
                  },
                  "type": {
                    "const": "started",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "session",
                  "model"
                ],
                "type": "object"
              },
              {
                "description": "Assistant text.",
                "properties": {
                  "text": {
                    "description": "The text chunk.",
                    "type": "string"
                  },
                  "type": {
                    "const": "text",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "text"
                ],
                "type": "object"
              },
              {
                "description": "Model reasoning text.",
                "properties": {
                  "text": {
                    "description": "The reasoning chunk.",
                    "type": "string"
                  },
                  "type": {
                    "const": "reasoning",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "text"
                ],
                "type": "object"
              },
              {
                "description": "A tool call began.",
                "properties": {
                  "call": {
                    "$ref": "#/$defs/ToolCall",
                    "description": "The call."
                  },
                  "id": {
                    "description": "Call id, matched by `ToolResult`.",
                    "type": "string"
                  },
                  "type": {
                    "const": "tool",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "id",
                  "call"
                ],
                "type": "object"
              },
              {
                "description": "A tool call finished.",
                "properties": {
                  "id": {
                    "description": "Id of the call.",
                    "type": "string"
                  },
                  "ok": {
                    "description": "Whether it succeeded.",
                    "type": "boolean"
                  },
                  "summary": {
                    "description": "Short human-readable outcome.",
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "type": {
                    "const": "tool_result",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "id",
                  "ok"
                ],
                "type": "object"
              },
              {
                "description": "Tokens used since the previous `Usage` of the run (executors report per turn, or once at\nthe end). The daemon adds them up: a bot's daily token budget is the sum of its runs'.\n\nThe four counts are disjoint: `input_tokens` is the input that was neither read from nor\nwritten to the prompt cache, so the whole input of a call is\n`input_tokens + cache_read_tokens + cache_write_tokens`.",
                "properties": {
                  "cacheReadTokens": {
                    "description": "Input tokens served from the prompt cache (about a tenth of the price of input).\nAbsent means 0, as does an executor that does not report it.",
                    "format": "uint64",
                    "minimum": 0,
                    "type": "integer"
                  },
                  "cacheWriteTokens": {
                    "description": "Input tokens written to the prompt cache. Absent means 0.",
                    "format": "uint64",
                    "minimum": 0,
                    "type": "integer"
                  },
                  "inputTokens": {
                    "description": "Input tokens that were not served from or written to the prompt cache.",
                    "format": "uint64",
                    "minimum": 0,
                    "type": "integer"
                  },
                  "outputTokens": {
                    "description": "Output tokens.",
                    "format": "uint64",
                    "minimum": 0,
                    "type": "integer"
                  },
                  "type": {
                    "const": "usage",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "inputTokens",
                  "outputTokens"
                ],
                "type": "object"
              },
              {
                "description": "The harness asks a human questions.",
                "properties": {
                  "questions": {
                    "description": "The questions.",
                    "items": {
                      "$ref": "#/$defs/Question"
                    },
                    "type": "array"
                  },
                  "requestId": {
                    "description": "Id the answer is sent against.",
                    "type": "string"
                  },
                  "type": {
                    "const": "needs_input",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "requestId",
                  "questions"
                ],
                "type": "object"
              },
              {
                "description": "The harness asks a human to approve an action.",
                "properties": {
                  "requestId": {
                    "description": "Id the decision is sent against.",
                    "type": "string"
                  },
                  "subject": {
                    "$ref": "#/$defs/ApprovalSubject",
                    "description": "What is being approved."
                  },
                  "type": {
                    "const": "needs_approval",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "requestId",
                  "subject"
                ],
                "type": "object"
              },
              {
                "description": "An approval request was resolved, by a person, a policy rule, a time limit or the\nrepeat-denial rule. Follows the `NeedsApproval` it answers, so a transcript shows why the\nharness was told yes or no. Only daemons that negotiate the `approval.history` feature\nemit it.",
                "properties": {
                  "by": {
                    "$ref": "#/$defs/ResolvedBy",
                    "description": "Who or what decided."
                  },
                  "decision": {
                    "$ref": "#/$defs/ApprovalOutcome",
                    "description": "What the harness was told."
                  },
                  "message": {
                    "description": "For a denial, the reason: a rule's message, or the one a human gave with\n`approval.decide`. It also goes to the harness where the harness can take text; the\nharness's own decision type carries none, so this is where the reason is kept.",
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "requestId": {
                    "description": "The `request_id` of the `NeedsApproval` this answers.",
                    "type": "string"
                  },
                  "type": {
                    "const": "approval_resolved",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "requestId",
                  "decision",
                  "by"
                ],
                "type": "object"
              },
              {
                "description": "A message from the human, added by `run.steer`. Only daemons that negotiate the\n`run.steer` feature emit it.",
                "properties": {
                  "text": {
                    "description": "The message text.",
                    "type": "string"
                  },
                  "type": {
                    "const": "user_message",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "text"
                ],
                "type": "object"
              },
              {
                "description": "The run called Reno's `report` tool: a structured status, shown in the transcript. Only\ndaemons that negotiate the `agent` feature emit it.",
                "properties": {
                  "details": {
                    "description": "Anything longer.",
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "status": {
                    "$ref": "#/$defs/ReportStatus",
                    "description": "How the work stands."
                  },
                  "summary": {
                    "description": "A short summary.",
                    "type": "string"
                  },
                  "type": {
                    "const": "agent_report",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "status",
                  "summary"
                ],
                "type": "object"
              },
              {
                "description": "The run ended; always the last event.",
                "properties": {
                  "diagnostic": {
                    "description": "Failure detail, when `stop` is `error`. For people: read `reason` to decide.",
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "reason": {
                    "anyOf": [
                      {
                        "$ref": "#/$defs/StopDetail"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "description": "The typed reason, when the daemon knows one (a budget, a refused start, a cancel, a\nshutdown). Absent from an executor's own `Done` and from daemons that predate it."
                  },
                  "result": {
                    "description": "Final result text.",
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "stop": {
                    "$ref": "#/$defs/StopReason",
                    "description": "Why it stopped."
                  },
                  "type": {
                    "const": "done",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "stop"
                ],
                "type": "object"
              },
              {
                "description": "The run was resumed: a new attempt continues the harness session. Follows the\n`Done` of the attempt that ended, and precedes the new attempt's `Started`. Only daemons\nthat negotiate the `run.resume` feature emit it.",
                "properties": {
                  "fromAttempt": {
                    "description": "The attempt that ended and is continued.",
                    "format": "uint32",
                    "minimum": 0,
                    "type": "integer"
                  },
                  "session": {
                    "$ref": "#/$defs/SessionRef",
                    "description": "The session the new attempt resumes."
                  },
                  "type": {
                    "const": "resumed",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "fromAttempt",
                  "session"
                ],
                "type": "object"
              }
            ]
          },
          "Question": {
            "description": "One question put to a human by a harness.",
            "properties": {
              "id": {
                "description": "Identifier the answer refers to.",
                "type": "string"
              },
              "multiSelect": {
                "default": false,
                "description": "Whether more than one option may be chosen.",
                "type": "boolean"
              },
              "options": {
                "default": [],
                "description": "Suggested answers; empty for free text.",
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "prompt": {
                "description": "The question text.",
                "type": "string"
              }
            },
            "required": [
              "id",
              "prompt"
            ],
            "type": "object"
          },
          "ReportStatus": {
            "description": "How a run says its work stands.",
            "oneOf": [
              {
                "const": "progress",
                "description": "Work is going on; this is a checkpoint.",
                "type": "string"
              },
              {
                "const": "done",
                "description": "The work is finished.",
                "type": "string"
              },
              {
                "const": "blocked",
                "description": "The run cannot go on without something it does not have.",
                "type": "string"
              },
              {
                "const": "failed",
                "description": "The work failed.",
                "type": "string"
              }
            ]
          },
          "ResolvedBy": {
            "description": "Who or what resolved an approval request, and so why the transcript shows the outcome it\ndoes.",
            "oneOf": [
              {
                "description": "A person decided it.",
                "properties": {
                  "type": {
                    "const": "human",
                    "type": "string"
                  }
                },
                "required": [
                  "type"
                ],
                "type": "object"
              },
              {
                "description": "A rule decided it, with no question asked. `name` is a policy rule's `note`, or `rules[N]`\nwhen it has none, or `default` when no rule matched and the policy's default effect\napplied; `standing:<rule id>` for a standing rule a person made (`rule.list`); or\n`builtin:reno-mcp` for a call to one of Reno's own MCP tools.",
                "properties": {
                  "name": {
                    "description": "The rule's name.",
                    "type": "string"
                  },
                  "type": {
                    "const": "rule",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "name"
                ],
                "type": "object"
              },
              {
                "description": "Nobody decided before the approval's time limit, or the run ended or the daemon\nrestarted first. Always an outcome of `denied`.",
                "properties": {
                  "type": {
                    "const": "expired",
                    "type": "string"
                  }
                },
                "required": [
                  "type"
                ],
                "type": "object"
              },
              {
                "description": "The same action was denied earlier in this run, so it was denied again unasked.",
                "properties": {
                  "type": {
                    "const": "repeat_denial",
                    "type": "string"
                  }
                },
                "required": [
                  "type"
                ],
                "type": "object"
              }
            ]
          },
          "Seq": {
            "description": "A per-run event sequence number. A run's journal numbers its events from 1 without gaps; a\n`from` of `Seq(0)` therefore means \"from the start\".",
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "SessionRef": {
            "description": "An opaque handle a harness gives for resuming a conversation.",
            "type": "string"
          },
          "StartRefusal": {
            "description": "Why a run could not start. A run that is refused never reached its harness.",
            "oneOf": [
              {
                "const": "not_installed",
                "description": "The executor's harness is not installed (or is too old to use).",
                "type": "string"
              },
              {
                "const": "not_signed_in",
                "description": "The executor's harness is not signed in.",
                "type": "string"
              },
              {
                "const": "no_eligible_executor",
                "description": "No executor can honour the run: an access mode or sandbox level nobody offers, or a task\nthat named no executor and has no default to go to.",
                "type": "string"
              },
              {
                "const": "workspace_refused",
                "description": "The run's workspace could not be prepared: a write run with no git repository to isolate\nit in, or git failing.",
                "type": "string"
              },
              {
                "const": "secret_missing",
                "description": "A secret the run's bot lists is not set, or the secret store cannot be read (a locked\nKeychain). A person has to act: `reno secret set <NAME>`.",
                "type": "string"
              },
              {
                "const": "invalid",
                "description": "Anything else that stopped the start: an unknown executor, an unreadable bot definition,\na task with no working directory, a spec the executor rejected.",
                "type": "string"
              }
            ]
          },
          "StopDetail": {
            "description": "The typed reason behind a run's last stop, beside the human `diagnostic`. A client decides\nwhat to show from this and never from the diagnostic's text.",
            "oneOf": [
              {
                "description": "A budget stopped the run.",
                "properties": {
                  "kind": {
                    "$ref": "#/$defs/BudgetKind",
                    "description": "Which limit."
                  },
                  "limit": {
                    "description": "The limit: milliseconds for `wall_time`, tokens for `tokens`.",
                    "format": "uint64",
                    "minimum": 0,
                    "type": "integer"
                  },
                  "type": {
                    "const": "budget_exceeded",
                    "type": "string"
                  },
                  "used": {
                    "description": "What had been used when it was noticed, in the same unit.",
                    "format": "uint64",
                    "minimum": 0,
                    "type": "integer"
                  }
                },
                "required": [
                  "type",
                  "kind",
                  "limit",
                  "used"
                ],
                "type": "object"
              },
              {
                "description": "The run never started: `failure` says why, `detail` is the daemon's words for a person.",
                "properties": {
                  "detail": {
                    "description": "The refusal as a sentence.",
                    "type": "string"
                  },
                  "failure": {
                    "$ref": "#/$defs/StartRefusal",
                    "description": "The kind of refusal."
                  },
                  "type": {
                    "const": "start_refused",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "failure",
                  "detail"
                ],
                "type": "object"
              },
              {
                "description": "Someone cancelled the run.",
                "properties": {
                  "by": {
                    "$ref": "#/$defs/CancelledBy",
                    "description": "Who."
                  },
                  "type": {
                    "const": "cancelled",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "by"
                ],
                "type": "object"
              },
              {
                "description": "The daemon was shutting down. The run is resumed at the next start when it may be.",
                "properties": {
                  "type": {
                    "const": "shutdown",
                    "type": "string"
                  }
                },
                "required": [
                  "type"
                ],
                "type": "object"
              },
              {
                "description": "The daemon died with the run live; recovery found it at the next start.",
                "properties": {
                  "type": {
                    "const": "crashed",
                    "type": "string"
                  }
                },
                "required": [
                  "type"
                ],
                "type": "object"
              },
              {
                "description": "The executor ended the run itself, as interrupted, without being asked to.",
                "properties": {
                  "type": {
                    "const": "executor_stopped",
                    "type": "string"
                  }
                },
                "required": [
                  "type"
                ],
                "type": "object"
              }
            ]
          },
          "StopReason": {
            "description": "Why an executor stopped, carried by `ExecEvent::Done`.",
            "oneOf": [
              {
                "const": "completed",
                "description": "The harness finished its turn normally.",
                "type": "string"
              },
              {
                "const": "interrupted",
                "description": "The harness was stopped before finishing.",
                "type": "string"
              },
              {
                "const": "error",
                "description": "The harness failed. A failing harness ends with this, never with a stream error.",
                "type": "string"
              },
              {
                "const": "refusal",
                "description": "The model declined the request.",
                "type": "string"
              },
              {
                "const": "max_tokens",
                "description": "The model hit its output limit.",
                "type": "string"
              }
            ]
          },
          "ToolCall": {
            "description": "A tool invocation as far as Reno needs to know it.",
            "properties": {
              "class": {
                "$ref": "#/$defs/ActionClass",
                "default": "other",
                "description": "What kind of action this is, the same vocabulary approvals use. Every executor fills it,\nso views and policy never need a harness's own tool names. Absent on the wire means\n[`ActionClass::Other`]."
              },
              "input": {
                "default": null,
                "description": "The tool's input, verbatim."
              },
              "name": {
                "description": "Tool name as the harness reports it (`Bash`, `exec`, `mcp__server__tool`, …). Names\ndiffer between harnesses; use [`ToolCall::class`] to treat calls alike.",
                "type": "string"
              }
            },
            "required": [
              "name"
            ],
            "type": "object"
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "description": "One item of the `run.events` subscription.",
        "properties": {
          "event": {
            "$ref": "#/$defs/ExecEvent",
            "description": "The event."
          },
          "seq": {
            "$ref": "#/$defs/Seq",
            "description": "Position in the run's journal, counted from 1."
          }
        },
        "required": [
          "seq",
          "event"
        ],
        "title": "RunEventItem",
        "type": "object"
      },
      "name": "run.events",
      "params": {
        "$defs": {
          "RunId": {
            "pattern": "^run_[A-Za-z0-9]{1,64}$",
            "type": "string"
          },
          "Seq": {
            "description": "A per-run event sequence number. A run's journal numbers its events from 1 without gaps; a\n`from` of `Seq(0)` therefore means \"from the start\".",
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "description": "Params of the `run.events` subscription.",
        "properties": {
          "fromSeq": {
            "anyOf": [
              {
                "$ref": "#/$defs/Seq"
              },
              {
                "type": "null"
              }
            ],
            "description": "First sequence number to deliver, **inclusive** — the value a `sub.gap` names as\n`resumeFrom`. A run's journal numbers its events from 1, so `0` and an absent value both\nstart from the beginning."
          },
          "runId": {
            "$ref": "#/$defs/RunId",
            "description": "The run to follow."
          }
        },
        "required": [
          "runId"
        ],
        "title": "RunEventsParams",
        "type": "object"
      }
    },
    {
      "item": {
        "$defs": {
          "BotPin": {
            "description": "The version of a bot's definition a run is pinned to.",
            "properties": {
              "name": {
                "description": "The bot's name.",
                "type": "string"
              },
              "version": {
                "description": "The version of its definition when the run was submitted.",
                "format": "uint32",
                "minimum": 0,
                "type": "integer"
              }
            },
            "required": [
              "name",
              "version"
            ],
            "type": "object"
          },
          "BudgetKind": {
            "description": "What a budget limits.",
            "oneOf": [
              {
                "const": "wall_time",
                "description": "How long one run may take (`budget.max_wall_time`). Limits are in milliseconds.",
                "type": "string"
              },
              {
                "const": "tokens",
                "description": "What a bot may spend per local day (`budget.daily_token_ceiling`). Limits are in tokens:\ninput, output and cache writes in full, and cache reads at a fraction of their count\n(`BudgetStatusResult::cache_read_weight_permille`).",
                "type": "string"
              }
            ]
          },
          "CancelledBy": {
            "description": "Who cancelled a run.",
            "oneOf": [
              {
                "const": "user",
                "description": "A person (`run.cancel`).",
                "type": "string"
              },
              {
                "const": "pause",
                "description": "The kill switch (`budget.pause` with `stopLive`).",
                "type": "string"
              }
            ]
          },
          "ExecutorId": {
            "pattern": "^[A-Za-z0-9._-]{1,64}$",
            "type": "string"
          },
          "NotResumed": {
            "description": "Why a run was not resumed, or cannot be: set on an `interrupted` run that recovery looked at\nand left, and the reason `run.resume` gives when it refuses.",
            "oneOf": [
              {
                "description": "A person cancelled it; their word stands.",
                "properties": {
                  "type": {
                    "const": "cancelled",
                    "type": "string"
                  }
                },
                "required": [
                  "type"
                ],
                "type": "object"
              },
              {
                "description": "The kill switch stopped it.",
                "properties": {
                  "type": {
                    "const": "paused",
                    "type": "string"
                  }
                },
                "required": [
                  "type"
                ],
                "type": "object"
              },
              {
                "description": "A budget stopped it; resuming would spend the same budget again.",
                "properties": {
                  "type": {
                    "const": "budget_stopped",
                    "type": "string"
                  }
                },
                "required": [
                  "type"
                ],
                "type": "object"
              },
              {
                "description": "The executor ended it by itself; a loop of those is not retried unasked.",
                "properties": {
                  "type": {
                    "const": "executor_stopped",
                    "type": "string"
                  }
                },
                "required": [
                  "type"
                ],
                "type": "object"
              },
              {
                "description": "It never started on an executor.",
                "properties": {
                  "type": {
                    "const": "start_refused",
                    "type": "string"
                  }
                },
                "required": [
                  "type"
                ],
                "type": "object"
              },
              {
                "description": "The harness never reported a session, so there is nothing to resume.",
                "properties": {
                  "type": {
                    "const": "no_session",
                    "type": "string"
                  }
                },
                "required": [
                  "type"
                ],
                "type": "object"
              },
              {
                "description": "The run's executor does not declare resume support.",
                "properties": {
                  "executor": {
                    "$ref": "#/$defs/ExecutorId",
                    "description": "The executor."
                  },
                  "type": {
                    "const": "executor_cannot_resume",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "executor"
                ],
                "type": "object"
              },
              {
                "description": "The run's executor is not registered in this daemon.",
                "properties": {
                  "executor": {
                    "$ref": "#/$defs/ExecutorId",
                    "description": "The executor."
                  },
                  "type": {
                    "const": "executor_missing",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "executor"
                ],
                "type": "object"
              },
              {
                "description": "The run's bot has `resume = \"never\"`.",
                "properties": {
                  "bot": {
                    "description": "The bot.",
                    "type": "string"
                  },
                  "type": {
                    "const": "bot_forbids",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "bot"
                ],
                "type": "object"
              },
              {
                "description": "The run has used its attempts.",
                "properties": {
                  "attempts": {
                    "description": "Attempts made.",
                    "format": "uint32",
                    "minimum": 0,
                    "type": "integer"
                  },
                  "max": {
                    "description": "Attempts allowed.",
                    "format": "uint32",
                    "minimum": 0,
                    "type": "integer"
                  },
                  "type": {
                    "const": "attempts_exhausted",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "attempts",
                  "max"
                ],
                "type": "object"
              },
              {
                "description": "The run is past its wall-time budget.",
                "properties": {
                  "limitMs": {
                    "description": "The limit, in milliseconds.",
                    "format": "uint64",
                    "minimum": 0,
                    "type": "integer"
                  },
                  "type": {
                    "const": "wall_time_spent",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "limitMs"
                ],
                "type": "object"
              },
              {
                "description": "The run's executor has not finished stopping; ask again in a moment.",
                "properties": {
                  "type": {
                    "const": "still_stopping",
                    "type": "string"
                  }
                },
                "required": [
                  "type"
                ],
                "type": "object"
              },
              {
                "description": "Only `interrupted` runs, and `failed` ones that have a session, can be resumed.",
                "properties": {
                  "status": {
                    "$ref": "#/$defs/RunStatus",
                    "description": "The run's status."
                  },
                  "type": {
                    "const": "wrong_status",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "status"
                ],
                "type": "object"
              }
            ]
          },
          "RunId": {
            "pattern": "^run_[A-Za-z0-9]{1,64}$",
            "type": "string"
          },
          "RunStatus": {
            "description": "Where a run is in its lifecycle. Serialised as a snake_case string.",
            "oneOf": [
              {
                "const": "queued",
                "description": "Waiting for a dispatcher to claim it.",
                "type": "string"
              },
              {
                "const": "leased",
                "description": "Claimed under a lease and fence; the executor is not yet running.",
                "type": "string"
              },
              {
                "const": "running",
                "description": "The executor is working.",
                "type": "string"
              },
              {
                "const": "waiting_input",
                "description": "Paused on an `ExecEvent::NeedsInput`.",
                "type": "string"
              },
              {
                "const": "waiting_approval",
                "description": "Paused on an `ExecEvent::NeedsApproval`.",
                "type": "string"
              },
              {
                "const": "evaluating",
                "description": "The harness finished; checks and verdicts are being gathered.",
                "type": "string"
              },
              {
                "const": "succeeded",
                "description": "Evaluation passed. Terminal.",
                "type": "string"
              },
              {
                "const": "failed",
                "description": "Evaluation failed or the harness errored. Terminal, except that a retry re-queues it.",
                "type": "string"
              },
              {
                "const": "interrupted",
                "description": "The daemon or executor stopped mid-run; resume or human review decides what follows.",
                "type": "string"
              },
              {
                "const": "cancelled",
                "description": "Cancelled before or after interruption. Terminal.",
                "type": "string"
              }
            ]
          },
          "RunSummary": {
            "description": "One run, as shown in lists and watches.",
            "properties": {
              "attempt": {
                "description": "Attempt number, from 1.",
                "format": "uint32",
                "minimum": 0,
                "type": "integer"
              },
              "bot": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/BotPin"
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "The bot the run was submitted for, and the version of its definition the run is pinned\nto. Absent for a run submitted without a bot."
              },
              "createdAtMs": {
                "description": "Creation time, in milliseconds since the Unix epoch.",
                "format": "uint64",
                "minimum": 0,
                "type": "integer"
              },
              "executor": {
                "$ref": "#/$defs/ExecutorId",
                "description": "The executor running it."
              },
              "model": {
                "description": "The model the run was asked for, or the one the executor reported once it started.",
                "type": [
                  "string",
                  "null"
                ]
              },
              "notResumed": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/NotResumed"
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "Why an `interrupted` run was not resumed, once the daemon has looked. Absent while the\nrun may still be resumed, and for any run that is not interrupted. Needs feature\n`run.resume`."
              },
              "prompt": {
                "description": "The prompt the task was submitted with. Absent from daemons that predate it. In\n`run.list` and `runs.watch` it is cut to [`PROMPT_SUMMARY_CHARS`] characters, ending in\n`…` when cut; `run.get` returns it whole.",
                "type": [
                  "string",
                  "null"
                ]
              },
              "runId": {
                "$ref": "#/$defs/RunId",
                "description": "The run."
              },
              "session": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/SessionRef"
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "The harness session of the run, once its executor has reported one: what a resume\ncontinues. Needs feature `run.resume`."
              },
              "status": {
                "$ref": "#/$defs/RunStatus",
                "description": "Current lifecycle state."
              },
              "stop": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/StopDetail"
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "The typed reason behind the run's last stop, when the daemon knows one: a budget, a\nrefused start, a cancel, a shutdown, a crash. Needs feature `run.stop_detail`."
              },
              "stopReason": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/StopReason"
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "Why it stopped, once it has."
              },
              "taskId": {
                "$ref": "#/$defs/TaskId",
                "description": "The task it attempts."
              },
              "title": {
                "description": "First line of the prompt, for display.",
                "type": "string"
              },
              "updatedAtMs": {
                "description": "Last state change, in milliseconds since the Unix epoch.",
                "format": "uint64",
                "minimum": 0,
                "type": "integer"
              }
            },
            "required": [
              "runId",
              "taskId",
              "executor",
              "status",
              "attempt",
              "title",
              "createdAtMs",
              "updatedAtMs"
            ],
            "type": "object"
          },
          "SessionRef": {
            "description": "An opaque handle a harness gives for resuming a conversation.",
            "type": "string"
          },
          "StartRefusal": {
            "description": "Why a run could not start. A run that is refused never reached its harness.",
            "oneOf": [
              {
                "const": "not_installed",
                "description": "The executor's harness is not installed (or is too old to use).",
                "type": "string"
              },
              {
                "const": "not_signed_in",
                "description": "The executor's harness is not signed in.",
                "type": "string"
              },
              {
                "const": "no_eligible_executor",
                "description": "No executor can honour the run: an access mode or sandbox level nobody offers, or a task\nthat named no executor and has no default to go to.",
                "type": "string"
              },
              {
                "const": "workspace_refused",
                "description": "The run's workspace could not be prepared: a write run with no git repository to isolate\nit in, or git failing.",
                "type": "string"
              },
              {
                "const": "secret_missing",
                "description": "A secret the run's bot lists is not set, or the secret store cannot be read (a locked\nKeychain). A person has to act: `reno secret set <NAME>`.",
                "type": "string"
              },
              {
                "const": "invalid",
                "description": "Anything else that stopped the start: an unknown executor, an unreadable bot definition,\na task with no working directory, a spec the executor rejected.",
                "type": "string"
              }
            ]
          },
          "StopDetail": {
            "description": "The typed reason behind a run's last stop, beside the human `diagnostic`. A client decides\nwhat to show from this and never from the diagnostic's text.",
            "oneOf": [
              {
                "description": "A budget stopped the run.",
                "properties": {
                  "kind": {
                    "$ref": "#/$defs/BudgetKind",
                    "description": "Which limit."
                  },
                  "limit": {
                    "description": "The limit: milliseconds for `wall_time`, tokens for `tokens`.",
                    "format": "uint64",
                    "minimum": 0,
                    "type": "integer"
                  },
                  "type": {
                    "const": "budget_exceeded",
                    "type": "string"
                  },
                  "used": {
                    "description": "What had been used when it was noticed, in the same unit.",
                    "format": "uint64",
                    "minimum": 0,
                    "type": "integer"
                  }
                },
                "required": [
                  "type",
                  "kind",
                  "limit",
                  "used"
                ],
                "type": "object"
              },
              {
                "description": "The run never started: `failure` says why, `detail` is the daemon's words for a person.",
                "properties": {
                  "detail": {
                    "description": "The refusal as a sentence.",
                    "type": "string"
                  },
                  "failure": {
                    "$ref": "#/$defs/StartRefusal",
                    "description": "The kind of refusal."
                  },
                  "type": {
                    "const": "start_refused",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "failure",
                  "detail"
                ],
                "type": "object"
              },
              {
                "description": "Someone cancelled the run.",
                "properties": {
                  "by": {
                    "$ref": "#/$defs/CancelledBy",
                    "description": "Who."
                  },
                  "type": {
                    "const": "cancelled",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "by"
                ],
                "type": "object"
              },
              {
                "description": "The daemon was shutting down. The run is resumed at the next start when it may be.",
                "properties": {
                  "type": {
                    "const": "shutdown",
                    "type": "string"
                  }
                },
                "required": [
                  "type"
                ],
                "type": "object"
              },
              {
                "description": "The daemon died with the run live; recovery found it at the next start.",
                "properties": {
                  "type": {
                    "const": "crashed",
                    "type": "string"
                  }
                },
                "required": [
                  "type"
                ],
                "type": "object"
              },
              {
                "description": "The executor ended the run itself, as interrupted, without being asked to.",
                "properties": {
                  "type": {
                    "const": "executor_stopped",
                    "type": "string"
                  }
                },
                "required": [
                  "type"
                ],
                "type": "object"
              }
            ]
          },
          "StopReason": {
            "description": "Why an executor stopped, carried by `ExecEvent::Done`.",
            "oneOf": [
              {
                "const": "completed",
                "description": "The harness finished its turn normally.",
                "type": "string"
              },
              {
                "const": "interrupted",
                "description": "The harness was stopped before finishing.",
                "type": "string"
              },
              {
                "const": "error",
                "description": "The harness failed. A failing harness ends with this, never with a stream error.",
                "type": "string"
              },
              {
                "const": "refusal",
                "description": "The model declined the request.",
                "type": "string"
              },
              {
                "const": "max_tokens",
                "description": "The model hit its output limit.",
                "type": "string"
              }
            ]
          },
          "TaskId": {
            "pattern": "^task_[A-Za-z0-9]{1,64}$",
            "type": "string"
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "description": "One item of the `runs.watch` subscription: the whole current list (latest value wins). The\nfirst item is always the current list, sent immediately on subscribe.",
        "properties": {
          "runs": {
            "description": "Current runs, newest first.",
            "items": {
              "$ref": "#/$defs/RunSummary"
            },
            "type": "array"
          }
        },
        "required": [
          "runs"
        ],
        "title": "RunsSnapshot",
        "type": "object"
      },
      "name": "runs.watch",
      "params": {
        "$defs": {
          "RunStatus": {
            "description": "Where a run is in its lifecycle. Serialised as a snake_case string.",
            "oneOf": [
              {
                "const": "queued",
                "description": "Waiting for a dispatcher to claim it.",
                "type": "string"
              },
              {
                "const": "leased",
                "description": "Claimed under a lease and fence; the executor is not yet running.",
                "type": "string"
              },
              {
                "const": "running",
                "description": "The executor is working.",
                "type": "string"
              },
              {
                "const": "waiting_input",
                "description": "Paused on an `ExecEvent::NeedsInput`.",
                "type": "string"
              },
              {
                "const": "waiting_approval",
                "description": "Paused on an `ExecEvent::NeedsApproval`.",
                "type": "string"
              },
              {
                "const": "evaluating",
                "description": "The harness finished; checks and verdicts are being gathered.",
                "type": "string"
              },
              {
                "const": "succeeded",
                "description": "Evaluation passed. Terminal.",
                "type": "string"
              },
              {
                "const": "failed",
                "description": "Evaluation failed or the harness errored. Terminal, except that a retry re-queues it.",
                "type": "string"
              },
              {
                "const": "interrupted",
                "description": "The daemon or executor stopped mid-run; resume or human review decides what follows.",
                "type": "string"
              },
              {
                "const": "cancelled",
                "description": "Cancelled before or after interruption. Terminal.",
                "type": "string"
              }
            ]
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "description": "Params of the `runs.watch` subscription.",
        "properties": {
          "status": {
            "description": "Only runs in one of these states; all runs when absent.",
            "items": {
              "$ref": "#/$defs/RunStatus"
            },
            "type": [
              "array",
              "null"
            ]
          }
        },
        "title": "RunsWatchParams",
        "type": "object"
      }
    },
    {
      "item": {
        "$defs": {
          "ActionClass": {
            "description": "What kind of action an approval is about.",
            "oneOf": [
              {
                "const": "read",
                "description": "Reading files.",
                "type": "string"
              },
              {
                "const": "edit",
                "description": "Editing files.",
                "type": "string"
              },
              {
                "const": "command",
                "description": "Running a command.",
                "type": "string"
              },
              {
                "const": "network",
                "description": "Network access.",
                "type": "string"
              },
              {
                "const": "mcp_tool",
                "description": "An MCP tool call.",
                "type": "string"
              },
              {
                "const": "other",
                "description": "Anything else.",
                "type": "string"
              }
            ]
          },
          "Approval": {
            "description": "An action a harness is held on, waiting for a human decision.",
            "properties": {
              "id": {
                "$ref": "#/$defs/ApprovalId",
                "description": "The approval, as `approval.decide` refers to it."
              },
              "requestedAtMs": {
                "description": "When the action was held, in milliseconds since the Unix epoch.",
                "format": "uint64",
                "minimum": 0,
                "type": "integer"
              },
              "runId": {
                "$ref": "#/$defs/RunId",
                "description": "The run that is held."
              },
              "subject": {
                "$ref": "#/$defs/ApprovalSubject",
                "description": "Exactly what is being approved."
              }
            },
            "required": [
              "id",
              "runId",
              "subject",
              "requestedAtMs"
            ],
            "type": "object"
          },
          "ApprovalId": {
            "pattern": "^appr_[A-Za-z0-9]{1,64}$",
            "type": "string"
          },
          "ApprovalSubject": {
            "description": "The exact thing a human is asked to approve.",
            "properties": {
              "action": {
                "$ref": "#/$defs/ActionClass",
                "description": "Class of the action."
              },
              "command": {
                "description": "The command line, for command actions.",
                "type": [
                  "string",
                  "null"
                ]
              },
              "paths": {
                "default": [],
                "description": "Paths the action touches.",
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "raw": {
                "default": null,
                "description": "The harness's own request, kept for the audit record."
              },
              "tool": {
                "description": "Tool the action goes through.",
                "type": "string"
              }
            },
            "required": [
              "action",
              "tool"
            ],
            "type": "object"
          },
          "RunId": {
            "pattern": "^run_[A-Za-z0-9]{1,64}$",
            "type": "string"
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "description": "One item of the `approvals.watch` subscription: the whole pending list (latest value wins).\nThe first item is the list as it stands when the subscription starts.",
        "properties": {
          "approvals": {
            "description": "Pending approvals, oldest first.",
            "items": {
              "$ref": "#/$defs/Approval"
            },
            "type": "array"
          }
        },
        "required": [
          "approvals"
        ],
        "title": "ApprovalsSnapshot",
        "type": "object"
      },
      "name": "approvals.watch",
      "params": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "description": "Params of the `approvals.watch` subscription.",
        "title": "ApprovalsWatchParams",
        "type": "object"
      }
    },
    {
      "item": {
        "$defs": {
          "DefError": {
            "description": "One problem with a definition, located by file and by a path inside it.\n\nDisplays as `bots/keeper.toml: executors[2]: unknown executor \"x\"`. A problem with the file\nas a whole has an empty `path` and displays as `bots/keeper.toml: <message>`.",
            "properties": {
              "file": {
                "description": "The file, relative to the definitions root.",
                "type": "string"
              },
              "message": {
                "description": "What is wrong, for a person.",
                "type": "string"
              },
              "path": {
                "description": "The field inside it, such as `executors[2]` or `target.bot`; empty for the whole file.",
                "type": "string"
              }
            },
            "required": [
              "file",
              "message"
            ],
            "type": "object"
          },
          "DefKind": {
            "description": "The kinds of definition this version loads. Teams and flows join with their tasks.",
            "oneOf": [
              {
                "const": "bot",
                "description": "A bot: `bots/<name>.toml`.",
                "type": "string"
              },
              {
                "const": "trigger",
                "description": "A trigger: `triggers/<name>.toml`.",
                "type": "string"
              },
              {
                "const": "policy",
                "description": "The policy: `policy.toml`.",
                "type": "string"
              }
            ]
          },
          "DefSummary": {
            "description": "One stored version of one definition, without its body.",
            "properties": {
              "createdAtMs": {
                "description": "When this version was first stored, in milliseconds since the Unix epoch.",
                "format": "uint64",
                "minimum": 0,
                "type": "integer"
              },
              "hash": {
                "description": "The content hash of the version: 64 lowercase hex digits.",
                "type": "string"
              },
              "kind": {
                "$ref": "#/$defs/DefKind",
                "description": "The kind."
              },
              "name": {
                "description": "The name; `policy` for the policy.",
                "type": "string"
              },
              "version": {
                "description": "The version, counted from 1 per name.",
                "format": "uint32",
                "minimum": 0,
                "type": "integer"
              }
            },
            "required": [
              "kind",
              "name",
              "version",
              "hash",
              "createdAtMs"
            ],
            "type": "object"
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "description": "The current definitions and the problems with the files, as the daemon holds them.\n\nWhen `errors` is not empty the files on disk do not validate, and `defs` is the last set that\ndid: the daemon keeps running on it until the files are fixed.",
        "properties": {
          "defs": {
            "description": "The current version of every definition, by kind and then name.",
            "items": {
              "$ref": "#/$defs/DefSummary"
            },
            "type": "array"
          },
          "errors": {
            "default": [],
            "description": "Every problem found in the last load; empty when the files are valid.",
            "items": {
              "$ref": "#/$defs/DefError"
            },
            "type": "array"
          }
        },
        "required": [
          "defs"
        ],
        "title": "DefsSnapshot",
        "type": "object"
      },
      "name": "defs.watch",
      "params": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "description": "Params of the `defs.watch` subscription: none.",
        "title": "DefsWatchParams",
        "type": "object"
      }
    },
    {
      "item": {
        "$defs": {
          "RunId": {
            "pattern": "^run_[A-Za-z0-9]{1,64}$",
            "type": "string"
          },
          "TriggerInfo": {
            "description": "One trigger and its state.",
            "properties": {
              "backoffUntilMs": {
                "description": "Until when it is backed off.",
                "format": "uint64",
                "minimum": 0,
                "type": [
                  "integer",
                  "null"
                ]
              },
              "bot": {
                "description": "The bot it starts.",
                "type": "string"
              },
              "cwd": {
                "description": "The working directory its definition names, as written (`~/` is not expanded). Absent\nwhen the runs use the daemon's own workspace.",
                "type": [
                  "string",
                  "null"
                ]
              },
              "error": {
                "description": "Why it cannot run, when `status` is `failed`.",
                "type": [
                  "string",
                  "null"
                ]
              },
              "failures": {
                "description": "Consecutive account-level failures to start; `0` when healthy.",
                "format": "uint32",
                "minimum": 0,
                "type": "integer"
              },
              "kind": {
                "description": "The `kind` of its `when`: `at`, `after`, `every`, `cron`, `fs` or `manual`.",
                "type": "string"
              },
              "lastFiredAtMs": {
                "description": "When it last started a run (or merged into one).",
                "format": "uint64",
                "minimum": 0,
                "type": [
                  "integer",
                  "null"
                ]
              },
              "lastRunId": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/RunId"
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "The run it last started."
              },
              "name": {
                "description": "The trigger's name.",
                "type": "string"
              },
              "nextDueAtMs": {
                "description": "When it fires next. Absent for `fs`, `manual`, a finished one-shot and a disabled trigger.",
                "format": "uint64",
                "minimum": 0,
                "type": [
                  "integer",
                  "null"
                ]
              },
              "status": {
                "$ref": "#/$defs/TriggerStatus",
                "description": "Where it stands."
              },
              "version": {
                "description": "The version of the definition in force.",
                "format": "uint32",
                "minimum": 0,
                "type": "integer"
              }
            },
            "required": [
              "name",
              "kind",
              "bot",
              "version",
              "status",
              "failures"
            ],
            "type": "object"
          },
          "TriggerStatus": {
            "description": "Where a trigger stands.",
            "oneOf": [
              {
                "const": "scheduled",
                "description": "Waiting for its next due time (`nextDueAtMs`).",
                "type": "string"
              },
              {
                "const": "watching",
                "description": "Watching files (`fs`).",
                "type": "string"
              },
              {
                "const": "manual",
                "description": "Fires only when asked (`manual`).",
                "type": "string"
              },
              {
                "const": "done",
                "description": "A one-shot (`at`, `after`) that has fired.",
                "type": "string"
              },
              {
                "const": "backed_off",
                "description": "Backed off after repeated failures to start; fires again at `backoffUntilMs`.",
                "type": "string"
              },
              {
                "const": "disabled",
                "description": "Disabled in its definition.",
                "type": "string"
              },
              {
                "const": "failed",
                "description": "Cannot run: see `error`.",
                "type": "string"
              }
            ]
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "description": "One item of the `triggers.watch` subscription: every trigger and its state (latest value\nwins). The first item is the list as it stands when the subscription starts.",
        "properties": {
          "triggers": {
            "description": "Every trigger in the definitions in force, by name.",
            "items": {
              "$ref": "#/$defs/TriggerInfo"
            },
            "type": "array"
          }
        },
        "required": [
          "triggers"
        ],
        "title": "TriggersSnapshot",
        "type": "object"
      },
      "name": "triggers.watch",
      "params": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "description": "Params of the `triggers.watch` subscription.",
        "title": "TriggersWatchParams",
        "type": "object"
      }
    },
    {
      "item": {
        "$defs": {
          "AccessMode": {
            "description": "How much a harness may do without asking. Never run with more than requested (ARCH-15).",
            "oneOf": [
              {
                "const": "supervised",
                "description": "Every consequential action needs approval.",
                "type": "string"
              },
              {
                "const": "auto_accept_edits",
                "description": "File edits proceed; commands and network still ask.",
                "type": "string"
              },
              {
                "const": "full_access",
                "description": "The harness asks nothing.",
                "type": "string"
              }
            ]
          },
          "ExecutorCaps": {
            "description": "What an executor declares it can do. Nothing is trusted beyond this (ARCH-15).",
            "properties": {
              "accessModes": {
                "description": "Access modes the executor can honour.",
                "items": {
                  "$ref": "#/$defs/AccessMode"
                },
                "type": "array"
              },
              "deterministicTurnEnd": {
                "description": "Whether the end of a turn is reported deterministically.",
                "type": "boolean"
              },
              "isolatesUserConfig": {
                "default": false,
                "description": "Whether a run is kept from loading the owner's personal configuration for that harness\n(its user-level settings, hooks, plugins, memory and instructions) unless the bot opts in\n(`inherit_user_config`). Only claimed where the driver enforces it; false means a run\nloads whatever the owner's own CLI would (ARCH-15).",
                "type": "boolean"
              },
              "mcpInjection": {
                "description": "False means it cannot join a team or use boards.",
                "type": "boolean"
              },
              "modelAliases": {
                "description": "Names the CLI accepts for a model besides the ids in `models`: short aliases that\nresolve on the CLI's side (`sonnet`, `opus`), so they are never reported as unknown.\nEmpty when the harness has none.",
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "models": {
                "description": "Models on offer.",
                "items": {
                  "$ref": "#/$defs/ModelInfo"
                },
                "type": "array"
              },
              "planMode": {
                "description": "Whether a plan mode exists.",
                "type": "boolean"
              },
              "resume": {
                "description": "Whether sessions can be resumed.",
                "type": "boolean"
              },
              "sandboxLevels": {
                "description": "Sandbox levels the executor can honour: a run is only started at a level listed here. An\nexecutor with no sandbox of its own honours only `Unrestricted`.",
                "items": {
                  "$ref": "#/$defs/SandboxLevel"
                },
                "type": "array"
              },
              "steering": {
                "$ref": "#/$defs/Steering",
                "description": "When steering messages can land."
              },
              "structuredOutput": {
                "description": "Whether `output_schema` is honoured.",
                "type": "boolean"
              }
            },
            "required": [
              "steering",
              "resume",
              "accessModes",
              "sandboxLevels",
              "mcpInjection",
              "structuredOutput",
              "deterministicTurnEnd",
              "planMode",
              "models"
            ],
            "type": "object"
          },
          "ExecutorDescriptor": {
            "description": "An installed harness and what it can do.",
            "properties": {
              "adapterVersion": {
                "description": "Driver version plus the detected harness CLI version.",
                "type": "string"
              },
              "caps": {
                "$ref": "#/$defs/ExecutorCaps",
                "description": "Declared capabilities."
              },
              "cliVerified": {
                "$ref": "#/$defs/VersionRange",
                "description": "Supported harness CLI versions."
              },
              "contractVersion": {
                "description": "Version of the Reno executor contract the adapter implements.",
                "format": "uint32",
                "minimum": 0,
                "type": "integer"
              },
              "id": {
                "$ref": "#/$defs/ExecutorId",
                "description": "Executor id, for example `claude-code`."
              }
            },
            "required": [
              "id",
              "contractVersion",
              "adapterVersion",
              "cliVerified",
              "caps"
            ],
            "type": "object"
          },
          "ExecutorHealth": {
            "description": "What the daemon last found out about one executor.",
            "properties": {
              "checkedAtMs": {
                "description": "When the probe finished, in milliseconds since the Unix epoch.",
                "format": "uint64",
                "minimum": 0,
                "type": "integer"
              },
              "installed": {
                "$ref": "#/$defs/InstallStatus",
                "description": "Whether and where the harness is installed."
              },
              "models": {
                "$ref": "#/$defs/ModelCatalog",
                "description": "The models on offer, and whether they came from the live harness or the adapter's list."
              },
              "signedIn": {
                "$ref": "#/$defs/SignedIn",
                "description": "Whether the harness is signed in."
              },
              "versionGate": {
                "$ref": "#/$defs/VersionGate",
                "description": "The installed version against the verified range."
              }
            },
            "required": [
              "installed",
              "versionGate",
              "signedIn",
              "models",
              "checkedAtMs"
            ],
            "type": "object"
          },
          "ExecutorId": {
            "pattern": "^[A-Za-z0-9._-]{1,64}$",
            "type": "string"
          },
          "ExecutorInfo": {
            "description": "One executor as `executor.list` shows it.",
            "properties": {
              "descriptor": {
                "$ref": "#/$defs/ExecutorDescriptor",
                "description": "What the executor declares it can do. Its `caps.models` is the list `health.models`\nlabels: the live list when a probe got one, else the curated list."
              },
              "health": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/ExecutorHealth"
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "The last probe. Absent until the first probe of this executor has finished."
              }
            },
            "required": [
              "descriptor"
            ],
            "type": "object"
          },
          "InstallStatus": {
            "description": "Whether the harness can be launched, and from where.",
            "oneOf": [
              {
                "description": "A launchable program was found.",
                "properties": {
                  "path": {
                    "description": "The program a run would launch.",
                    "type": "string"
                  },
                  "type": {
                    "const": "installed",
                    "type": "string"
                  },
                  "version": {
                    "description": "Its version, when it could be read.",
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                },
                "required": [
                  "type",
                  "path"
                ],
                "type": "object"
              },
              {
                "description": "Nothing launchable.",
                "properties": {
                  "type": {
                    "const": "not_installed",
                    "type": "string"
                  },
                  "why": {
                    "$ref": "#/$defs/NotInstalledReason",
                    "description": "Why."
                  }
                },
                "required": [
                  "type",
                  "why"
                ],
                "type": "object"
              }
            ]
          },
          "ModelCatalog": {
            "description": "The models an executor offers and where the list came from.",
            "properties": {
              "models": {
                "description": "The models.",
                "items": {
                  "$ref": "#/$defs/ModelInfo"
                },
                "type": "array"
              },
              "source": {
                "$ref": "#/$defs/ModelSource",
                "description": "Where the list came from."
              }
            },
            "required": [
              "source",
              "models"
            ],
            "type": "object"
          },
          "ModelInfo": {
            "description": "A model an executor offers.",
            "properties": {
              "displayName": {
                "description": "Display name.",
                "type": [
                  "string",
                  "null"
                ]
              },
              "id": {
                "description": "Model id as passed to the harness.",
                "type": "string"
              }
            },
            "required": [
              "id"
            ],
            "type": "object"
          },
          "ModelSource": {
            "description": "Where a list of models came from.",
            "oneOf": [
              {
                "const": "curated",
                "description": "The adapter's built-in list.",
                "type": "string"
              },
              {
                "const": "live",
                "description": "Asked of the live harness by the last probe.",
                "type": "string"
              }
            ]
          },
          "NotInstalledReason": {
            "description": "Why a harness cannot be launched.",
            "oneOf": [
              {
                "description": "No program was found where the driver looks.",
                "properties": {
                  "hint": {
                    "description": "Where it looks and how to get it, for a person.",
                    "type": "string"
                  },
                  "type": {
                    "const": "not_found",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "hint"
                ],
                "type": "object"
              },
              {
                "description": "The agent's launcher needs a managed install (an adapter package or a release archive)\nthat has not been done. A run never installs: this is an explicit step.",
                "properties": {
                  "type": {
                    "const": "needs_install",
                    "type": "string"
                  },
                  "what": {
                    "description": "What would be installed.",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "what"
                ],
                "type": "object"
              },
              {
                "description": "Something is there but cannot be launched (an override that points at nothing, a file\nthat is not executable).",
                "properties": {
                  "detail": {
                    "description": "What is wrong with it.",
                    "type": "string"
                  },
                  "type": {
                    "const": "unusable",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "detail"
                ],
                "type": "object"
              },
              {
                "description": "The probe itself failed, so nothing is known.",
                "properties": {
                  "detail": {
                    "description": "What happened.",
                    "type": "string"
                  },
                  "type": {
                    "const": "probe_failed",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "detail"
                ],
                "type": "object"
              }
            ]
          },
          "SandboxLevel": {
            "description": "The sandbox the harness itself enforces around its tools: a ceiling below the access mode.\nA run that asks for `ReadOnly` or `WorkspaceWrite` goes only to an executor that enforces that\nlevel; `Unrestricted` asks for no ceiling beyond the access mode, so every executor can take it.",
            "oneOf": [
              {
                "const": "read_only",
                "description": "No writes.",
                "type": "string"
              },
              {
                "const": "workspace_write",
                "description": "Writes confined to the workspace.",
                "type": "string"
              },
              {
                "const": "unrestricted",
                "description": "No sandbox ceiling beyond the access mode (and the run's worktree).",
                "type": "string"
              }
            ]
          },
          "SignedIn": {
            "description": "Whether the harness has a login.",
            "oneOf": [
              {
                "description": "A login exists.",
                "properties": {
                  "account": {
                    "description": "Who, when the harness says.",
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "type": {
                    "const": "yes",
                    "type": "string"
                  }
                },
                "required": [
                  "type"
                ],
                "type": "object"
              },
              {
                "description": "No login: not eligible.",
                "properties": {
                  "hint": {
                    "description": "What to do about it.",
                    "type": "string"
                  },
                  "type": {
                    "const": "no",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "hint"
                ],
                "type": "object"
              },
              {
                "description": "The harness offers no way to tell without running a model call. Stays eligible.",
                "properties": {
                  "type": {
                    "const": "unknown",
                    "type": "string"
                  }
                },
                "required": [
                  "type"
                ],
                "type": "object"
              }
            ]
          },
          "Steering": {
            "description": "When a running harness can accept a steering message.",
            "oneOf": [
              {
                "const": "none",
                "description": "Cannot be steered mid-run.",
                "type": "string"
              },
              {
                "const": "turn_boundary",
                "description": "Steering lands at the next turn.",
                "type": "string"
              },
              {
                "const": "step_boundary",
                "description": "Steering lands at the next step.",
                "type": "string"
              }
            ]
          },
          "VersionGate": {
            "description": "The installed version against the adapter's verified range.",
            "oneOf": [
              {
                "description": "At least the minimum, and no newer than the last version the adapter was verified on.",
                "properties": {
                  "type": {
                    "const": "ok",
                    "type": "string"
                  }
                },
                "required": [
                  "type"
                ],
                "type": "object"
              },
              {
                "description": "Older than the minimum the adapter supports: not eligible.",
                "properties": {
                  "min": {
                    "description": "The oldest supported version.",
                    "type": "string"
                  },
                  "type": {
                    "const": "too_old",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "min"
                ],
                "type": "object"
              },
              {
                "description": "Newer than the last version the adapter was verified on: eligible, but unproven.",
                "properties": {
                  "type": {
                    "const": "untested",
                    "type": "string"
                  },
                  "verified": {
                    "description": "The newest version the conformance suite passed on.",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "verified"
                ],
                "type": "object"
              },
              {
                "description": "There is no version to compare: not installed, or the CLI did not report one.",
                "properties": {
                  "type": {
                    "const": "unchecked",
                    "type": "string"
                  }
                },
                "required": [
                  "type"
                ],
                "type": "object"
              }
            ]
          },
          "VersionRange": {
            "description": "Harness CLI versions an adapter supports.",
            "properties": {
              "min": {
                "description": "Oldest supported version.",
                "type": "string"
              },
              "verified": {
                "description": "Newest version the conformance suite passed against.",
                "type": "string"
              }
            },
            "required": [
              "min",
              "verified"
            ],
            "type": "object"
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "description": "One item of the `executors.watch` subscription: every executor and its last health (latest\nvalue wins). The first item is the list as it stands when the subscription starts.",
        "properties": {
          "executors": {
            "description": "The executors, by id.",
            "items": {
              "$ref": "#/$defs/ExecutorInfo"
            },
            "type": "array"
          }
        },
        "required": [
          "executors"
        ],
        "title": "ExecutorsSnapshot",
        "type": "object"
      },
      "name": "executors.watch",
      "params": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "description": "Params of the `executors.watch` subscription.",
        "title": "ExecutorsWatchParams",
        "type": "object"
      }
    }
  ]
}
