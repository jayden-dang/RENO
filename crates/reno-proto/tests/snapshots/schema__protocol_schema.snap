---
source: crates/reno-proto/tests/schema.rs
expression: protocol_schema()
---
{
  "definitions": {
    "bot": {
      "$defs": {
        "AccessMode": {
          "description": "How much a harness may do without asking. Never run with more than requested (ARCH-15).",
          "oneOf": [
            {
              "const": "supervised",
              "description": "Every consequential action needs approval.",
              "type": "string"
            },
            {
              "const": "auto_accept_edits",
              "description": "File edits proceed; commands and network still ask.",
              "type": "string"
            },
            {
              "const": "full_access",
              "description": "The harness asks nothing.",
              "type": "string"
            }
          ]
        },
        "Budget": {
          "additionalProperties": false,
          "description": "The limits on one bot's runs (ARCHITECTURE section 8, item 6). Enforcement is T1.7.",
          "properties": {
            "daily_token_ceiling": {
              "description": "Tokens the bot may spend per day; no ceiling when absent.",
              "format": "uint64",
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            },
            "max_concurrent_runs": {
              "default": 1,
              "description": "Runs of this bot live at once. At least 1.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "max_wall_time": {
              "default": "45m",
              "description": "The longest one run may take, as a duration such as `45m`.",
              "type": "string"
            }
          },
          "type": "object"
        },
        "ExecutorId": {
          "pattern": "^[A-Za-z0-9._-]{1,64}$",
          "type": "string"
        },
        "ResumePolicy": {
          "description": "What a bot allows the daemon to do with its interrupted runs.",
          "oneOf": [
            {
              "const": "auto",
              "description": "Resume an interrupted run on its own when it can be.",
              "type": "string"
            },
            {
              "const": "never",
              "description": "Leave an interrupted run for a person.",
              "type": "string"
            }
          ]
        },
        "SandboxLevel": {
          "description": "The sandbox the harness itself enforces around its tools: a ceiling below the access mode.\nA run that asks for `ReadOnly` or `WorkspaceWrite` goes only to an executor that enforces that\nlevel; `Unrestricted` asks for no ceiling beyond the access mode, so every executor can take it.",
          "oneOf": [
            {
              "const": "read_only",
              "description": "No writes.",
              "type": "string"
            },
            {
              "const": "workspace_write",
              "description": "Writes confined to the workspace.",
              "type": "string"
            },
            {
              "const": "unrestricted",
              "description": "No sandbox ceiling beyond the access mode (and the run's worktree).",
              "type": "string"
            }
          ]
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "A bot: the instructions it works from and the limits it works within.\n\n```toml\nname = \"keeper\"\ninstructions = \"\"\"\nKeep dependencies current. Never push without a human.\n\"\"\"\nexecutors = [\"claude-code\", \"codex\"]   # most preferred first\naccess = \"supervised\"\nsandbox = \"workspace_write\"          # optional: only executors that enforce it\nteam = \"core\"                          # optional\ntriggers = [\"nightly\"]                 # names of triggers/<name>.toml\nin_place_writes = false                # optional: allow writes in a non-git directory\nsecrets = [\"GITHUB_TOKEN\"]             # optional: Keychain secrets its runs get as env vars\nresume = \"auto\"                        # optional: \"auto\" (default) or \"never\"\nmodel = \"claude-sonnet-4-6\"            # optional: the executor's default when left out\ninherit_user_config = false            # optional: true loads the owner's personal config\n\n[budget]\nmax_concurrent_runs = 2\nmax_wall_time = \"45m\"\ndaily_token_ceiling = 2000000          # optional\n```",
      "properties": {
        "access": {
          "$ref": "#/$defs/AccessMode",
          "default": "supervised",
          "description": "How much a run may do without asking. Defaults to the strictest, `supervised`."
        },
        "budget": {
          "$ref": "#/$defs/Budget",
          "default": {
            "max_concurrent_runs": 1,
            "max_wall_time": "45m"
          },
          "description": "The limits on this bot's runs."
        },
        "executors": {
          "description": "Executors in order of preference. At least one.",
          "items": {
            "$ref": "#/$defs/ExecutorId"
          },
          "type": "array"
        },
        "in_place_writes": {
          "description": "Let this bot's write runs work directly in the directory they target when it is not a git\nrepository. Off by default: a write run on a non-git directory is refused, because there\nis no worktree to isolate it in. A git repository is never written in place.",
          "type": "boolean"
        },
        "inherit_user_config": {
          "description": "Let this bot's runs load the owner's personal configuration for their harness. Off by\ndefault: a run is isolated from it, so the owner's own hooks, plugins, memory and\ninstructions do not reach the bot. Only executors that declare\n`isolates_user_config` (Claude Code, Codex) can isolate; the others load it either way,\nand say so on their descriptor. Reno's own MCP server and its policy apply in both modes.",
          "type": "boolean"
        },
        "instructions": {
          "description": "What the bot is for and how it works. Sent with every run.",
          "type": "string"
        },
        "model": {
          "description": "The model this bot's runs ask for, as its executor names models (`claude-sonnet-4-6`).\nLeft out, the executor's own default applies. A task that names a model wins over it. The\nname is checked against the executor's model list only as a warning, since a list can be\ncurated and incomplete; a model the executor does not know fails when the run starts.\nIt is passed to whichever executor the run goes to, so a bot that lists executors of\ndifferent vendors should leave it out.",
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "description": "The bot's name; it must equal the file stem.",
          "type": "string"
        },
        "resume": {
          "$ref": "#/$defs/ResumePolicy",
          "description": "Whether a run of this bot that was interrupted (the daemon crashed or was stopped) is\nresumed by the daemon on its own at the next start. `auto`, the default, resumes it when\nits executor supports resume, the run has a session, it is under its attempt cap and not\npast its wall-time budget; `never` leaves it `interrupted` for a person to resume with\n`run.resume`. A person's cancel and a budget stop are never resumed on their own."
        },
        "sandbox": {
          "$ref": "#/$defs/SandboxLevel",
          "default": "unrestricted",
          "description": "The sandbox ceiling a run asks its harness to enforce. Defaults to `unrestricted`: no\nceiling beyond `access`, so every listed executor is eligible. `workspace_write` or\n`read_only` makes only executors that enforce that level eligible."
        },
        "secrets": {
          "description": "Names of the secrets this bot's runs receive, each as an environment variable of the same\nname (`GITHUB_TOKEN`). The values live in the Keychain (`reno secret set`), never in this\nfile. A run whose secret is not set does not start. Left out, the run gets none.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "team": {
          "description": "The team the bot belongs to, if any. Teams arrive with T2.4, so only the name's shape is\nchecked.",
          "type": [
            "string",
            "null"
          ]
        },
        "triggers": {
          "default": [],
          "description": "Names of the triggers that start this bot. Each must exist and must target this bot.",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "name",
        "instructions",
        "executors"
      ],
      "title": "BotDef",
      "type": "object"
    },
    "policy": {
      "$defs": {
        "ActionClass": {
          "description": "What kind of action an approval is about.",
          "oneOf": [
            {
              "const": "read",
              "description": "Reading files.",
              "type": "string"
            },
            {
              "const": "edit",
              "description": "Editing files.",
              "type": "string"
            },
            {
              "const": "command",
              "description": "Running a command.",
              "type": "string"
            },
            {
              "const": "network",
              "description": "Network access.",
              "type": "string"
            },
            {
              "const": "mcp_tool",
              "description": "An MCP tool call.",
              "type": "string"
            },
            {
              "const": "other",
              "description": "Anything else.",
              "type": "string"
            }
          ]
        },
        "PolicyEffect": {
          "description": "What a matching rule does to the action.",
          "oneOf": [
            {
              "const": "allow",
              "description": "Let it happen without asking.",
              "type": "string"
            },
            {
              "const": "ask",
              "description": "Ask a human. With nobody to answer, the answer is no.",
              "type": "string"
            },
            {
              "const": "deny",
              "description": "Refuse it.",
              "type": "string"
            }
          ]
        },
        "PolicyRule": {
          "additionalProperties": false,
          "description": "One rule: if the action matches, the effect applies.",
          "properties": {
            "effect": {
              "$ref": "#/$defs/PolicyEffect",
              "description": "What happens to a matching action."
            },
            "match": {
              "$ref": "#/$defs/RuleMatch",
              "default": {
                "scope": "*"
              },
              "description": "Which actions match. All conditions that are present must hold."
            },
            "note": {
              "description": "A short reason, shown when the rule decides.",
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "effect"
          ],
          "type": "object"
        },
        "RuleMatch": {
          "additionalProperties": false,
          "description": "The conditions of a rule. A condition that is absent holds for every action.",
          "properties": {
            "action": {
              "anyOf": [
                {
                  "$ref": "#/$defs/ActionClass"
                },
                {
                  "type": "null"
                }
              ],
              "description": "The class of action: `read`, `edit`, `command`, `network`, `mcp_tool` or `other`."
            },
            "command": {
              "description": "A glob over the command line. Only commands have one, so this needs `action = \"command\"`\nor no `action`.",
              "type": [
                "string",
                "null"
              ]
            },
            "path": {
              "description": "A glob over a path the action touches.",
              "type": [
                "string",
                "null"
              ]
            },
            "scope": {
              "$ref": "#/$defs/RuleScope",
              "default": "*",
              "description": "The bots the rule applies to: `\"*\"` for all, or a list of names. Defaults to `\"*\"`."
            },
            "tool": {
              "description": "A glob over the tool's name.",
              "type": [
                "string",
                "null"
              ]
            }
          },
          "type": "object"
        },
        "RuleScope": {
          "anyOf": [
            {
              "const": "*",
              "type": "string"
            },
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          ]
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "The policy: rules in order, and what to do when none matches.\n\n**The first rule that matches decides.** Put the narrow and dangerous rules first.\n\n```toml\ndefault = \"ask\"\n\n[[rules]]\nnote = \"never reset hard\"\neffect = \"deny\"\nmatch = { action = \"command\", command = \"git reset --hard*\" }\n\n[[rules]]\neffect = \"allow\"\nmatch = { action = \"command\", command = \"cargo *\", scope = [\"keeper\", \"builder\"] }\n```\n\nPaths in a rule are matched relative to the run's worktree when they are inside it, and as\nabsolute paths otherwise. So `src/**` means the worktree's `src`, and `/**` matches only\npaths outside the worktree. The exact rules, including how a path with `..` is judged, are\nin the docs of `reno_proto::defs::evaluate`.\n\nAn action that asks waits for a human for at most `approval_ttl` (30 minutes unless the\ndaemon is configured otherwise), then it is denied as expired.",
      "properties": {
        "approval_ttl": {
          "description": "How long an `ask` waits for a human before it is denied as expired, as a duration such\nas `30m`. The daemon's own default applies when absent. A change applies to approvals\nraised after it.",
          "type": [
            "string",
            "null"
          ]
        },
        "default": {
          "$ref": "#/$defs/PolicyEffect",
          "default": "ask",
          "description": "The effect when no rule matches. Defaults to `ask`."
        },
        "rules": {
          "default": [],
          "description": "The rules, in order.",
          "items": {
            "$ref": "#/$defs/PolicyRule"
          },
          "type": "array"
        }
      },
      "title": "PolicyDef",
      "type": "object"
    },
    "trigger": {
      "$defs": {
        "TriggerKind": {
          "description": "What fires a trigger. The `kind` key names the variant, and the other keys belong to it.\n\n`at`, `after`, `every`, `cron`, `fs` and `manual` can be used today. The rest are reserved so\nthe wire type is complete, and a definition that uses one is rejected until its task lands:\n`board`, `message`, `flow` and `git` with T2.10, `webhook` in Phase 3.",
          "oneOf": [
            {
              "additionalProperties": false,
              "description": "Once, at an instant: RFC 3339 with an offset, such as `2026-12-01T09:00:00+07:00`.",
              "properties": {
                "at": {
                  "description": "The instant.",
                  "type": "string"
                },
                "kind": {
                  "const": "at",
                  "type": "string"
                }
              },
              "required": [
                "kind",
                "at"
              ],
              "type": "object"
            },
            {
              "additionalProperties": false,
              "description": "Once, a delay after this version of the definition became active: a duration such as\n`30m`. Editing the definition starts the delay again, unless the trigger has fired.",
              "properties": {
                "after": {
                  "description": "The delay.",
                  "type": "string"
                },
                "kind": {
                  "const": "after",
                  "type": "string"
                }
              },
              "required": [
                "kind",
                "after"
              ],
              "type": "object"
            },
            {
              "additionalProperties": false,
              "description": "Repeatedly, at an interval of at least a minute, such as `6h`.",
              "properties": {
                "every": {
                  "description": "The interval.",
                  "type": "string"
                },
                "kind": {
                  "const": "every",
                  "type": "string"
                }
              },
              "required": [
                "kind",
                "every"
              ],
              "type": "object"
            },
            {
              "additionalProperties": false,
              "description": "On a schedule, in an IANA time zone.",
              "properties": {
                "cron": {
                  "description": "Five fields: minute hour day-of-month month day-of-week.",
                  "type": "string"
                },
                "kind": {
                  "const": "cron",
                  "type": "string"
                },
                "timezone": {
                  "description": "An IANA zone name, such as `Asia/Ho_Chi_Minh` or `UTC`.",
                  "type": "string"
                }
              },
              "required": [
                "kind",
                "cron",
                "timezone"
              ],
              "type": "object"
            },
            {
              "additionalProperties": false,
              "description": "When files change, after the changes settle.",
              "properties": {
                "debounce": {
                  "default": "500ms",
                  "description": "How long to wait for quiet before firing, such as `500ms`. Defaults to `500ms`.",
                  "type": "string"
                },
                "kind": {
                  "const": "fs",
                  "type": "string"
                },
                "paths": {
                  "description": "Paths or globs to watch: absolute, or starting with `~/`.",
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                }
              },
              "required": [
                "kind",
                "paths"
              ],
              "type": "object"
            },
            {
              "additionalProperties": false,
              "description": "Only when started by hand: the CLI, the app or an RPC call.",
              "properties": {
                "kind": {
                  "const": "manual",
                  "type": "string"
                }
              },
              "required": [
                "kind"
              ],
              "type": "object"
            },
            {
              "additionalProperties": false,
              "description": "Reserved: an entry matching a scope and key pattern is written to a board.",
              "properties": {
                "key": {
                  "description": "The key pattern.",
                  "type": "string"
                },
                "kind": {
                  "const": "board",
                  "type": "string"
                },
                "scope": {
                  "description": "The board scope.",
                  "type": "string"
                }
              },
              "required": [
                "kind",
                "scope",
                "key"
              ],
              "type": "object"
            },
            {
              "additionalProperties": false,
              "description": "Reserved: an envelope arrives for the bot while it has no live run.",
              "properties": {
                "kind": {
                  "const": "message",
                  "type": "string"
                }
              },
              "required": [
                "kind"
              ],
              "type": "object"
            },
            {
              "additionalProperties": false,
              "description": "Reserved: a ref moves in a registered repository.",
              "properties": {
                "kind": {
                  "const": "git",
                  "type": "string"
                },
                "refs": {
                  "description": "The refs to watch.",
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                },
                "repo": {
                  "description": "The repository.",
                  "type": "string"
                }
              },
              "required": [
                "kind",
                "repo",
                "refs"
              ],
              "type": "object"
            },
            {
              "additionalProperties": false,
              "description": "Reserved: another flow run reaches a terminal state.",
              "properties": {
                "flow": {
                  "description": "The flow to watch.",
                  "type": "string"
                },
                "kind": {
                  "const": "flow",
                  "type": "string"
                }
              },
              "required": [
                "kind",
                "flow"
              ],
              "type": "object"
            },
            {
              "additionalProperties": false,
              "description": "Reserved: a loopback HTTP POST with an HMAC signature. Phase 3, off by default.",
              "properties": {
                "kind": {
                  "const": "webhook",
                  "type": "string"
                },
                "path": {
                  "description": "The URL path.",
                  "type": "string"
                }
              },
              "required": [
                "kind",
                "path"
              ],
              "type": "object"
            }
          ]
        },
        "TriggerTarget": {
          "additionalProperties": false,
          "description": "What a trigger starts: a bot, given a prompt.",
          "properties": {
            "bot": {
              "description": "The bot to start. It must exist.",
              "type": "string"
            },
            "cwd": {
              "description": "The directory the run works in: absolute, or starting with `~/` (the daemon user's home).\nOmitted, the run uses the daemon's own scratch workspace. A git repository here is not\nwritten to: a write run works in a worktree of it. The directory is checked when the\ntrigger fires, not when the definition loads, so an unmounted disk does not make the\ndefinition invalid; a missing directory refuses the run.",
              "type": [
                "string",
                "null"
              ]
            },
            "prompt": {
              "description": "The prompt template for the task. `{{trigger}}` is the trigger's name,\n`{{scheduled_at}}` the occurrence it fires for (RFC 3339, in the trigger's time zone) and\n`{{lateness}}` how late the run started (`0s` when on time). Any other `{{...}}` is an\nerror. A run that starts late or merges missed occurrences also gets a sentence saying\nso after the prompt.",
              "type": "string"
            }
          },
          "required": [
            "bot",
            "prompt"
          ],
          "type": "object"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "A trigger: when to start, and whom to start.\n\n```toml\nname = \"nightly\"\nenabled = true                  # optional, defaults to true\n\n[when]\nkind = \"cron\"\ncron = \"0 2 * * *\"\ntimezone = \"Asia/Ho_Chi_Minh\"\n\n[target]\nbot = \"keeper\"\nprompt = \"Check for outdated dependencies.\"\ncwd = \"~/code/app\"              # optional: where the run works\n```",
      "properties": {
        "enabled": {
          "default": true,
          "description": "A disabled trigger is kept and versioned but never fires.",
          "type": "boolean"
        },
        "name": {
          "description": "The trigger's name; it must equal the file stem.",
          "type": "string"
        },
        "target": {
          "$ref": "#/$defs/TriggerTarget",
          "description": "What it starts."
        },
        "when": {
          "$ref": "#/$defs/TriggerKind",
          "description": "What fires it."
        }
      },
      "required": [
        "name",
        "when",
        "target"
      ],
      "title": "TriggerDef",
      "type": "object"
    }
  },
  "features": [
    "run.events.resume",
    "runs.watch",
    "sub.gap",
    "approvals",
    "approval.history",
    "run.steer",
    "daemon.shutdown",
    "defs",
    "triggers",
    "workspaces",
    "executors",
    "executor.install",
    "approval.message",
    "routing",
    "attachments",
    "budget",
    "agent",
    "run.resume",
    "run.stop_detail",
    "secrets",
    "executor.frames",
    "rules"
  ],
  "methods": [
    {
      "name": "daemon.hello",
      "params": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "description": "Params of `daemon.hello`.",
        "properties": {
          "clientName": {
            "description": "Client name, for logs.",
            "type": "string"
          },
          "features": {
            "description": "Features the client understands.",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "protocolVersion": {
            "description": "Highest protocol version the client speaks.",
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "clientName",
          "protocolVersion",
          "features"
        ],
        "title": "HelloParams",
        "type": "object"
      },
      "result": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "description": "Result of `daemon.hello`.",
        "properties": {
          "features": {
            "description": "Features both sides support.",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "pid": {
            "description": "Daemon process id.",
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "protocolVersion": {
            "description": "Protocol version the connection will use.",
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "serverVersion": {
            "description": "Daemon build version.",
            "type": "string"
          }
        },
        "required": [
          "serverVersion",
          "protocolVersion",
          "features",
          "pid"
        ],
        "title": "HelloResult",
        "type": "object"
      }
    },
    {
      "name": "daemon.status",
      "params": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "description": "Empty params: serialises as `{}`.",
        "title": "NoParams",
        "type": "object"
      },
      "result": {
        "$defs": {
          "ExecutorId": {
            "pattern": "^[A-Za-z0-9._-]{1,64}$",
            "type": "string"
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "description": "Result of `daemon.status`.",
        "properties": {
          "activeRuns": {
            "description": "Runs in a non-terminal state other than `queued`.",
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "definitionsWatch": {
            "description": "Why edits to the definitions are not being noticed, while the daemon cannot start its\nfile watch and is retrying: the definitions in force are the last good ones, and a change\non disk is not seen until the watch starts. Absent when the watch is running.",
            "type": [
              "string",
              "null"
            ]
          },
          "executors": {
            "description": "Executors the daemon found installed.",
            "items": {
              "$ref": "#/$defs/ExecutorId"
            },
            "type": "array"
          },
          "pid": {
            "description": "Daemon process id.",
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "queuedRuns": {
            "description": "Runs waiting to be claimed.",
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "uptimeSecs": {
            "description": "Seconds since the daemon started.",
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "version": {
            "description": "Daemon build version.",
            "type": "string"
          }
        },
        "required": [
          "version",
          "pid",
          "uptimeSecs",
          "activeRuns",
          "queuedRuns",
          "executors"
        ],
        "title": "DaemonStatusInfo",
        "type": "object"
      }
    },
    {
      "name": "daemon.shutdown",
      "params": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "description": "Empty params: serialises as `{}`.",
        "title": "NoParams",
        "type": "object"
      },
      "result": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "description": "Result of `daemon.shutdown`: empty.",
        "title": "DaemonShutdownResult",
        "type": "object"
      }
    },
    {
      "name": "task.run",
      "params": {
        "$defs": {
          "Attachment": {
            "description": "A file attached to a task: a path on the daemon's machine, with the name to show for it.",
            "properties": {
              "mime": {
                "description": "The media type, when known (`image/png`).",
                "type": [
                  "string",
                  "null"
                ]
              },
              "name": {
                "description": "The name to show: usually the file name.",
                "type": "string"
              },
              "path": {
                "description": "Absolute path of a readable regular file.",
                "type": "string"
              }
            },
            "required": [
              "path",
              "name"
            ],
            "type": "object"
          },
          "ExecutorId": {
            "pattern": "^[A-Za-z0-9._-]{1,64}$",
            "type": "string"
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "description": "Params of `task.run`.",
        "properties": {
          "attachments": {
            "description": "Files the task refers to. The daemon checks that each is a readable file, within\n[`ATTACHMENTS_MAX_COUNT`] and [`ATTACHMENT_MAX_BYTES`], and appends an \"Attached files:\"\nlist of their paths to the prompt; the executor reads them from disk. Needs feature\n`attachments`.",
            "items": {
              "$ref": "#/$defs/Attachment"
            },
            "type": "array"
          },
          "bot": {
            "description": "The bot to run it as. The run is pinned to the version of the bot's definition that is\ncurrent when the task is submitted. Needs feature `defs`.",
            "type": [
              "string",
              "null"
            ]
          },
          "cwd": {
            "description": "Working directory; the daemon's default when absent.",
            "type": [
              "string",
              "null"
            ]
          },
          "executor": {
            "anyOf": [
              {
                "$ref": "#/$defs/ExecutorId"
              },
              {
                "type": "null"
              }
            ],
            "description": "Executor to run it on. May be left out when `bot` is given: the daemon then takes the\nfirst executor in the bot's list that it has."
          },
          "inPlace": {
            "description": "Let a write run work directly in `cwd` when it is not a git repository, as a bot's\n`inPlaceWrites` does. Without it such a run is refused, because there is no worktree to\nisolate it in. A git repository is never written in place, whatever this says. Needs\nfeature `routing`.",
            "type": "boolean"
          },
          "model": {
            "description": "Model override.",
            "type": [
              "string",
              "null"
            ]
          },
          "prompt": {
            "description": "The task prompt.",
            "type": "string"
          }
        },
        "required": [
          "prompt"
        ],
        "title": "TaskRunParams",
        "type": "object"
      },
      "result": {
        "$defs": {
          "AccessMode": {
            "description": "How much a harness may do without asking. Never run with more than requested (ARCH-15).",
            "oneOf": [
              {
                "const": "supervised",
                "description": "Every consequential action needs approval.",
                "type": "string"
              },
              {
                "const": "auto_accept_edits",
                "description": "File edits proceed; commands and network still ask.",
                "type": "string"
              },
              {
                "const": "full_access",
                "description": "The harness asks nothing.",
                "type": "string"
              }
            ]
          },
          "ExecutorId": {
            "pattern": "^[A-Za-z0-9._-]{1,64}$",
            "type": "string"
          },
          "FallbackStep": {
            "description": "One step of the fallback walk: the executor that would not start, and what came next.",
            "properties": {
              "atMs": {
                "description": "When, in milliseconds since the Unix epoch.",
                "format": "uint64",
                "minimum": 0,
                "type": "integer"
              },
              "from": {
                "$ref": "#/$defs/ExecutorId",
                "description": "The executor that would not start."
              },
              "reason": {
                "$ref": "#/$defs/RejectReason",
                "description": "Why."
              },
              "to": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/ExecutorId"
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "The next candidate tried; absent when there was none left."
              }
            },
            "required": [
              "from",
              "reason",
              "atMs"
            ],
            "type": "object"
          },
          "RejectReason": {
            "description": "Why an executor was not chosen. The first six are the stage 1 filter; the last two are what\nthe dispatcher found when it tried.",
            "oneOf": [
              {
                "description": "The harness is not installed, or cannot be launched.",
                "properties": {
                  "detail": {
                    "description": "What the last probe said, for a person.",
                    "type": "string"
                  },
                  "type": {
                    "const": "not_installed",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "detail"
                ],
                "type": "object"
              },
              {
                "description": "The installed version is older than the adapter supports.",
                "properties": {
                  "found": {
                    "description": "The version found, when it could be read.",
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "min": {
                    "description": "The oldest supported version.",
                    "type": "string"
                  },
                  "type": {
                    "const": "too_old",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "min"
                ],
                "type": "object"
              },
              {
                "description": "The harness has no login.",
                "properties": {
                  "hint": {
                    "description": "What to do about it.",
                    "type": "string"
                  },
                  "type": {
                    "const": "signed_out",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "hint"
                ],
                "type": "object"
              },
              {
                "description": "The executor does not offer the access mode the task asks for. A task is never run with\na different one.",
                "properties": {
                  "offered": {
                    "description": "What the executor offers.",
                    "items": {
                      "$ref": "#/$defs/AccessMode"
                    },
                    "type": "array"
                  },
                  "requested": {
                    "$ref": "#/$defs/AccessMode",
                    "description": "What the task asked for."
                  },
                  "type": {
                    "const": "access_not_offered",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "requested",
                  "offered"
                ],
                "type": "object"
              },
              {
                "description": "The executor does not enforce the sandbox level the task asks for.",
                "properties": {
                  "offered": {
                    "description": "What the executor enforces.",
                    "items": {
                      "$ref": "#/$defs/SandboxLevel"
                    },
                    "type": "array"
                  },
                  "requested": {
                    "$ref": "#/$defs/SandboxLevel",
                    "description": "What the task asked for."
                  },
                  "type": {
                    "const": "sandbox_not_enforced",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "requested",
                  "offered"
                ],
                "type": "object"
              },
              {
                "description": "The task leaves this executor out: the task pins another executor, its bot does not list\nthis one, or the request excludes it.",
                "properties": {
                  "type": {
                    "const": "excluded",
                    "type": "string"
                  },
                  "why": {
                    "description": "Which of those.",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "why"
                ],
                "type": "object"
              },
              {
                "description": "The daemon has no executor with this id.",
                "properties": {
                  "type": {
                    "const": "not_registered",
                    "type": "string"
                  }
                },
                "required": [
                  "type"
                ],
                "type": "object"
              },
              {
                "description": "The executor was chosen and then would not start, for an account or install reason. Added\nby the fallback walk.",
                "properties": {
                  "detail": {
                    "description": "The refusal, for a person.",
                    "type": "string"
                  },
                  "failure": {
                    "$ref": "#/$defs/StartFailureKind",
                    "description": "What the dispatcher found."
                  },
                  "type": {
                    "const": "start_failed",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "failure",
                  "detail"
                ],
                "type": "object"
              }
            ]
          },
          "Rejection": {
            "description": "An executor that was dropped, and why.",
            "properties": {
              "executor": {
                "$ref": "#/$defs/ExecutorId",
                "description": "The executor."
              },
              "reason": {
                "$ref": "#/$defs/RejectReason",
                "description": "Why."
              }
            },
            "required": [
              "executor",
              "reason"
            ],
            "type": "object"
          },
          "RoutingDecision": {
            "description": "Where a task goes and why.",
            "properties": {
              "atMs": {
                "description": "When the decision was made, in milliseconds since the Unix epoch.",
                "format": "uint64",
                "minimum": 0,
                "type": "integer"
              },
              "chosen": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/ExecutorId"
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "The executor the run starts on. Absent when no executor is eligible: the run then fails\nwith `NoEligibleExecutor`."
              },
              "fallbacks": {
                "description": "The fallback walk, in order. Empty when the first choice started.",
                "items": {
                  "$ref": "#/$defs/FallbackStep"
                },
                "type": "array"
              },
              "ranked": {
                "default": [],
                "description": "The candidates that passed the filter, best first. `chosen` is the first of them until a\nfallback moves on.",
                "items": {
                  "$ref": "#/$defs/ExecutorId"
                },
                "type": "array"
              },
              "rejected": {
                "default": [],
                "description": "The candidates the filter dropped, and the executors the fallback walk gave up on.",
                "items": {
                  "$ref": "#/$defs/Rejection"
                },
                "type": "array"
              },
              "ruleMatched": {
                "$ref": "#/$defs/RuleMatched",
                "description": "The rule that ordered `ranked`."
              },
              "warnings": {
                "description": "Things worth a person's attention that did not stop the run: the model the bot pins is\nnot in the chosen executor's model list (a list that may be curated and incomplete, so\nthe run still starts).",
                "items": {
                  "type": "string"
                },
                "type": "array"
              }
            },
            "required": [
              "ruleMatched",
              "atMs"
            ],
            "type": "object"
          },
          "RuleMatched": {
            "description": "The stage 2 rule that ordered the candidates. The first rule that matches wins.",
            "oneOf": [
              {
                "description": "The task named its executor.",
                "properties": {
                  "type": {
                    "const": "explicit_executor",
                    "type": "string"
                  }
                },
                "required": [
                  "type"
                ],
                "type": "object"
              },
              {
                "description": "The task's bot lists its executors in order of preference.",
                "properties": {
                  "bot": {
                    "description": "The bot.",
                    "type": "string"
                  },
                  "type": {
                    "const": "bot_preference",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "bot"
                ],
                "type": "object"
              },
              {
                "description": "No rule applied: the eligible executors in id order.",
                "properties": {
                  "type": {
                    "const": "default",
                    "type": "string"
                  }
                },
                "required": [
                  "type"
                ],
                "type": "object"
              }
            ]
          },
          "RunId": {
            "pattern": "^run_[A-Za-z0-9]{1,64}$",
            "type": "string"
          },
          "SandboxLevel": {
            "description": "The sandbox the harness itself enforces around its tools: a ceiling below the access mode.\nA run that asks for `ReadOnly` or `WorkspaceWrite` goes only to an executor that enforces that\nlevel; `Unrestricted` asks for no ceiling beyond the access mode, so every executor can take it.",
            "oneOf": [
              {
                "const": "read_only",
                "description": "No writes.",
                "type": "string"
              },
              {
                "const": "workspace_write",
                "description": "Writes confined to the workspace.",
                "type": "string"
              },
              {
                "const": "unrestricted",
                "description": "No sandbox ceiling beyond the access mode (and the run's worktree).",
                "type": "string"
              }
            ]
          },
          "StartFailureKind": {
            "description": "The reasons a start can fail that make the dispatcher try the next candidate. A failure after\nthe executor started is not one of them.",
            "oneOf": [
              {
                "const": "not_installed",
                "description": "Not installed.",
                "type": "string"
              },
              {
                "const": "not_signed_in",
                "description": "Signed out.",
                "type": "string"
              },
              {
                "const": "no_eligible_executor",
                "description": "Not eligible for the task: too old, or an access mode or sandbox it does not offer.",
                "type": "string"
              }
            ]
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "description": "Result of `task.run`.",
        "properties": {
          "routing": {
            "anyOf": [
              {
                "$ref": "#/$defs/RoutingDecision"
              },
              {
                "type": "null"
              }
            ],
            "description": "Where the router sent it and why. Absent from daemons that predate routing."
          },
          "runId": {
            "$ref": "#/$defs/RunId",
            "description": "The new run."
          }
        },
        "required": [
          "runId"
        ],
        "title": "TaskRunResult",
        "type": "object"
      }
    },
    {
      "name": "run.get",
      "params": {
        "$defs": {
          "RunId": {
            "pattern": "^run_[A-Za-z0-9]{1,64}$",
            "type": "string"
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "description": "Params of `run.get`.",
        "properties": {
          "runId": {
            "$ref": "#/$defs/RunId",
            "description": "The run to fetch."
          }
        },
        "required": [
          "runId"
        ],
        "title": "RunGetParams",
        "type": "object"
      },
      "result": {
        "$defs": {
          "BotPin": {
            "description": "The version of a bot's definition a run is pinned to.",
            "properties": {
              "name": {
                "description": "The bot's name.",
                "type": "string"
              },
              "version": {
                "description": "The version of its definition when the run was submitted.",
                "format": "uint32",
                "minimum": 0,
                "type": "integer"
              }
            },
            "required": [
              "name",
              "version"
            ],
            "type": "object"
          },
          "BudgetKind": {
            "description": "What a budget limits.",
            "oneOf": [
              {
                "const": "wall_time",
                "description": "How long one run may take (`budget.max_wall_time`). Limits are in milliseconds.",
                "type": "string"
              },
              {
                "const": "tokens",
                "description": "What a bot may spend per local day (`budget.daily_token_ceiling`). Limits are in tokens:\ninput, output and cache writes in full, and cache reads at a fraction of their count\n(`BudgetStatusResult::cache_read_weight_permille`).",
                "type": "string"
              }
            ]
          },
          "CancelledBy": {
            "description": "Who cancelled a run.",
            "oneOf": [
              {
                "const": "user",
                "description": "A person (`run.cancel`).",
                "type": "string"
              },
              {
                "const": "pause",
                "description": "The kill switch (`budget.pause` with `stopLive`).",
                "type": "string"
              }
            ]
          },
          "ExecutorId": {
            "pattern": "^[A-Za-z0-9._-]{1,64}$",
            "type": "string"
          },
          "NotResumed": {
            "description": "Why a run was not resumed, or cannot be: set on an `interrupted` run that recovery looked at\nand left, and the reason `run.resume` gives when it refuses.",
            "oneOf": [
              {
                "description": "A person cancelled it; their word stands.",
                "properties": {
                  "type": {
                    "const": "cancelled",
                    "type": "string"
                  }
                },
                "required": [
                  "type"
                ],
                "type": "object"
              },
              {
                "description": "The kill switch stopped it.",
                "properties": {
                  "type": {
                    "const": "paused",
                    "type": "string"
                  }
                },
                "required": [
                  "type"
                ],
                "type": "object"
              },
              {
                "description": "A budget stopped it; resuming would spend the same budget again.",
                "properties": {
                  "type": {
                    "const": "budget_stopped",
                    "type": "string"
                  }
                },
                "required": [
                  "type"
                ],
                "type": "object"
              },
              {
                "description": "The executor ended it by itself; a loop of those is not retried unasked.",
                "properties": {
                  "type": {
                    "const": "executor_stopped",
                    "type": "string"
                  }
                },
                "required": [
                  "type"
                ],
                "type": "object"
              },
              {
                "description": "It never started on an executor.",
                "properties": {
                  "type": {
                    "const": "start_refused",
                    "type": "string"
                  }
                },
                "required": [
                  "type"
                ],
                "type": "object"
              },
              {
                "description": "The harness never reported a session, so there is nothing to resume.",
                "properties": {
                  "type": {
                    "const": "no_session",
                    "type": "string"
                  }
                },
                "required": [
                  "type"
                ],
                "type": "object"
              },
              {
                "description": "The run's executor does not declare resume support.",
                "properties": {
                  "executor": {
                    "$ref": "#/$defs/ExecutorId",
                    "description": "The executor."
                  },
                  "type": {
                    "const": "executor_cannot_resume",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "executor"
                ],
                "type": "object"
              },
              {
                "description": "The run's executor is not registered in this daemon.",
                "properties": {
                  "executor": {
                    "$ref": "#/$defs/ExecutorId",
                    "description": "The executor."
                  },
                  "type": {
                    "const": "executor_missing",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "executor"
                ],
                "type": "object"
              },
              {
                "description": "The run's bot has `resume = \"never\"`.",
                "properties": {
                  "bot": {
                    "description": "The bot.",
                    "type": "string"
                  },
                  "type": {
                    "const": "bot_forbids",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "bot"
                ],
                "type": "object"
              },
              {
                "description": "The run has used its attempts.",
                "properties": {
                  "attempts": {
                    "description": "Attempts made.",
                    "format": "uint32",
                    "minimum": 0,
                    "type": "integer"
                  },
                  "max": {
                    "description": "Attempts allowed.",
                    "format": "uint32",
                    "minimum": 0,
                    "type": "integer"
                  },
                  "type": {
                    "const": "attempts_exhausted",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "attempts",
                  "max"
                ],
                "type": "object"
              },
              {
                "description": "The run is past its wall-time budget.",
                "properties": {
                  "limitMs": {
                    "description": "The limit, in milliseconds.",
                    "format": "uint64",
                    "minimum": 0,
                    "type": "integer"
                  },
                  "type": {
                    "const": "wall_time_spent",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "limitMs"
                ],
                "type": "object"
              },
              {
                "description": "The run's executor has not finished stopping; ask again in a moment.",
                "properties": {
                  "type": {
                    "const": "still_stopping",
                    "type": "string"
                  }
                },
                "required": [
                  "type"
                ],
                "type": "object"
              },
              {
                "description": "Only `interrupted` runs, and `failed` ones that have a session, can be resumed.",
                "properties": {
                  "status": {
                    "$ref": "#/$defs/RunStatus",
                    "description": "The run's status."
                  },
                  "type": {
                    "const": "wrong_status",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "status"
                ],
                "type": "object"
              }
            ]
          },
          "RunId": {
            "pattern": "^run_[A-Za-z0-9]{1,64}$",
            "type": "string"
          },
          "RunStatus": {
            "description": "Where a run is in its lifecycle. Serialised as a snake_case string.",
            "oneOf": [
              {
                "const": "queued",
                "description": "Waiting for a dispatcher to claim it.",
                "type": "string"
              },
              {
                "const": "leased",
                "description": "Claimed under a lease and fence; the executor is not yet running.",
                "type": "string"
              },
              {
                "const": "running",
                "description": "The executor is working.",
                "type": "string"
              },
              {
                "const": "waiting_input",
                "description": "Paused on an `ExecEvent::NeedsInput`.",
                "type": "string"
              },
              {
                "const": "waiting_approval",
                "description": "Paused on an `ExecEvent::NeedsApproval`.",
                "type": "string"
              },
              {
                "const": "evaluating",
                "description": "The harness finished; checks and verdicts are being gathered.",
                "type": "string"
              },
              {
                "const": "succeeded",
                "description": "Evaluation passed. Terminal.",
                "type": "string"
              },
              {
                "const": "failed",
                "description": "Evaluation failed or the harness errored. Terminal, except that a retry re-queues it.",
                "type": "string"
              },
              {
                "const": "interrupted",
                "description": "The daemon or executor stopped mid-run; resume or human review decides what follows.",
                "type": "string"
              },
              {
                "const": "cancelled",
                "description": "Cancelled before or after interruption. Terminal.",
                "type": "string"
              }
            ]
          },
          "SessionRef": {
            "description": "An opaque handle a harness gives for resuming a conversation.",
            "type": "string"
          },
          "StartRefusal": {
            "description": "Why a run could not start. A run that is refused never reached its harness.",
            "oneOf": [
              {
                "const": "not_installed",
                "description": "The executor's harness is not installed (or is too old to use).",
                "type": "string"
              },
              {
                "const": "not_signed_in",
                "description": "The executor's harness is not signed in.",
                "type": "string"
              },
              {
                "const": "no_eligible_executor",
                "description": "No executor can honour the run: an access mode or sandbox level nobody offers, or a task\nthat named no executor and has no default to go to.",
                "type": "string"
              },
              {
                "const": "workspace_refused",
                "description": "The run's workspace could not be prepared: a write run with no git repository to isolate\nit in, or git failing.",
                "type": "string"
              },
              {
                "const": "secret_missing",
                "description": "A secret the run's bot lists is not set, or the secret store cannot be read (a locked\nKeychain). A person has to act: `reno secret set <NAME>`.",
                "type": "string"
              },
              {
                "const": "invalid",
                "description": "Anything else that stopped the start: an unknown executor, an unreadable bot definition,\na task with no working directory, a spec the executor rejected.",
                "type": "string"
              }
            ]
          },
          "StopDetail": {
            "description": "The typed reason behind a run's last stop, beside the human `diagnostic`. A client decides\nwhat to show from this and never from the diagnostic's text.",
            "oneOf": [
              {
                "description": "A budget stopped the run.",
                "properties": {
                  "kind": {
                    "$ref": "#/$defs/BudgetKind",
                    "description": "Which limit."
                  },
                  "limit": {
                    "description": "The limit: milliseconds for `wall_time`, tokens for `tokens`.",
                    "format": "uint64",
                    "minimum": 0,
                    "type": "integer"
                  },
                  "type": {
                    "const": "budget_exceeded",
                    "type": "string"
                  },
                  "used": {
                    "description": "What had been used when it was noticed, in the same unit.",
                    "format": "uint64",
                    "minimum": 0,
                    "type": "integer"
                  }
                },
                "required": [
                  "type",
                  "kind",
                  "limit",
                  "used"
                ],
                "type": "object"
              },
              {
                "description": "The run never started: `failure` says why, `detail` is the daemon's words for a person.",
                "properties": {
                  "detail": {
                    "description": "The refusal as a sentence.",
                    "type": "string"
                  },
                  "failure": {
                    "$ref": "#/$defs/StartRefusal",
                    "description": "The kind of refusal."
                  },
                  "type": {
                    "const": "start_refused",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "failure",
                  "detail"
                ],
                "type": "object"
              },
              {
                "description": "Someone cancelled the run.",
                "properties": {
                  "by": {
                    "$ref": "#/$defs/CancelledBy",
                    "description": "Who."
                  },
                  "type": {
                    "const": "cancelled",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "by"
                ],
                "type": "object"
              },
              {
                "description": "The daemon was shutting down. The run is resumed at the next start when it may be.",
                "properties": {
                  "type": {
                    "const": "shutdown",
                    "type": "string"
                  }
                },
                "required": [
                  "type"
                ],
                "type": "object"
              },
              {
                "description": "The daemon died with the run live; recovery found it at the next start.",
                "properties": {
                  "type": {
                    "const": "crashed",
                    "type": "string"
                  }
                },
                "required": [
                  "type"
                ],
                "type": "object"
              },
              {
                "description": "The executor ended the run itself, as interrupted, without being asked to.",
                "properties": {
                  "type": {
                    "const": "executor_stopped",
                    "type": "string"
                  }
                },
                "required": [
                  "type"
                ],
                "type": "object"
              }
            ]
          },
          "StopReason": {
            "description": "Why an executor stopped, carried by `ExecEvent::Done`.",
            "oneOf": [
              {
                "const": "completed",
                "description": "The harness finished its turn normally.",
                "type": "string"
              },
              {
                "const": "interrupted",
                "description": "The harness was stopped before finishing.",
                "type": "string"
              },
              {
                "const": "error",
                "description": "The harness failed. A failing harness ends with this, never with a stream error.",
                "type": "string"
              },
              {
                "const": "refusal",
                "description": "The model declined the request.",
                "type": "string"
              },
              {
                "const": "max_tokens",
                "description": "The model hit its output limit.",
                "type": "string"
              }
            ]
          },
          "TaskId": {
            "pattern": "^task_[A-Za-z0-9]{1,64}$",
            "type": "string"
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "description": "One run, as shown in lists and watches.",
        "properties": {
          "attempt": {
            "description": "Attempt number, from 1.",
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "bot": {
            "anyOf": [
              {
                "$ref": "#/$defs/BotPin"
              },
              {
                "type": "null"
              }
            ],
            "description": "The bot the run was submitted for, and the version of its definition the run is pinned\nto. Absent for a run submitted without a bot."
          },
          "createdAtMs": {
            "description": "Creation time, in milliseconds since the Unix epoch.",
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "executor": {
            "$ref": "#/$defs/ExecutorId",
            "description": "The executor running it."
          },
          "model": {
            "description": "The model the run was asked for, or the one the executor reported once it started.",
            "type": [
              "string",
              "null"
            ]
          },
          "notResumed": {
            "anyOf": [
              {
                "$ref": "#/$defs/NotResumed"
              },
              {
                "type": "null"
              }
            ],
            "description": "Why an `interrupted` run was not resumed, once the daemon has looked. Absent while the\nrun may still be resumed, and for any run that is not interrupted. Needs feature\n`run.resume`."
          },
          "prompt": {
            "description": "The prompt the task was submitted with. Absent from daemons that predate it. In\n`run.list` and `runs.watch` it is cut to [`PROMPT_SUMMARY_CHARS`] characters, ending in\n`…` when cut; `run.get` returns it whole.",
            "type": [
              "string",
              "null"
            ]
          },
          "runId": {
            "$ref": "#/$defs/RunId",
            "description": "The run."
          },
          "session": {
            "anyOf": [
              {
                "$ref": "#/$defs/SessionRef"
              },
              {
                "type": "null"
              }
            ],
            "description": "The harness session of the run, once its executor has reported one: what a resume\ncontinues. Needs feature `run.resume`."
          },
          "status": {
            "$ref": "#/$defs/RunStatus",
            "description": "Current lifecycle state."
          },
          "stop": {
            "anyOf": [
              {
                "$ref": "#/$defs/StopDetail"
              },
              {
                "type": "null"
              }
            ],
            "description": "The typed reason behind the run's last stop, when the daemon knows one: a budget, a\nrefused start, a cancel, a shutdown, a crash. Needs feature `run.stop_detail`."
          },
          "stopReason": {
            "anyOf": [
              {
                "$ref": "#/$defs/StopReason"
              },
              {
                "type": "null"
              }
            ],
            "description": "Why it stopped, once it has."
          },
          "taskId": {
            "$ref": "#/$defs/TaskId",
            "description": "The task it attempts."
          },
          "title": {
            "description": "First line of the prompt, for display.",
            "type": "string"
          },
          "updatedAtMs": {
            "description": "Last state change, in milliseconds since the Unix epoch.",
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "runId",
          "taskId",
          "executor",
          "status",
          "attempt",
          "title",
          "createdAtMs",
          "updatedAtMs"
        ],
        "title": "RunSummary",
        "type": "object"
      }
    },
    {
      "name": "run.routing",
      "params": {
        "$defs": {
          "RunId": {
            "pattern": "^run_[A-Za-z0-9]{1,64}$",
            "type": "string"
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "description": "Params of `run.routing`.",
        "properties": {
          "runId": {
            "$ref": "#/$defs/RunId",
            "description": "The run."
          }
        },
        "required": [
          "runId"
        ],
        "title": "RunRoutingParams",
        "type": "object"
      },
      "result": {
        "$defs": {
          "AccessMode": {
            "description": "How much a harness may do without asking. Never run with more than requested (ARCH-15).",
            "oneOf": [
              {
                "const": "supervised",
                "description": "Every consequential action needs approval.",
                "type": "string"
              },
              {
                "const": "auto_accept_edits",
                "description": "File edits proceed; commands and network still ask.",
                "type": "string"
              },
              {
                "const": "full_access",
                "description": "The harness asks nothing.",
                "type": "string"
              }
            ]
          },
          "ExecutorId": {
            "pattern": "^[A-Za-z0-9._-]{1,64}$",
            "type": "string"
          },
          "FallbackStep": {
            "description": "One step of the fallback walk: the executor that would not start, and what came next.",
            "properties": {
              "atMs": {
                "description": "When, in milliseconds since the Unix epoch.",
                "format": "uint64",
                "minimum": 0,
                "type": "integer"
              },
              "from": {
                "$ref": "#/$defs/ExecutorId",
                "description": "The executor that would not start."
              },
              "reason": {
                "$ref": "#/$defs/RejectReason",
                "description": "Why."
              },
              "to": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/ExecutorId"
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "The next candidate tried; absent when there was none left."
              }
            },
            "required": [
              "from",
              "reason",
              "atMs"
            ],
            "type": "object"
          },
          "RejectReason": {
            "description": "Why an executor was not chosen. The first six are the stage 1 filter; the last two are what\nthe dispatcher found when it tried.",
            "oneOf": [
              {
                "description": "The harness is not installed, or cannot be launched.",
                "properties": {
                  "detail": {
                    "description": "What the last probe said, for a person.",
                    "type": "string"
                  },
                  "type": {
                    "const": "not_installed",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "detail"
                ],
                "type": "object"
              },
              {
                "description": "The installed version is older than the adapter supports.",
                "properties": {
                  "found": {
                    "description": "The version found, when it could be read.",
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "min": {
                    "description": "The oldest supported version.",
                    "type": "string"
                  },
                  "type": {
                    "const": "too_old",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "min"
                ],
                "type": "object"
              },
              {
                "description": "The harness has no login.",
                "properties": {
                  "hint": {
                    "description": "What to do about it.",
                    "type": "string"
                  },
                  "type": {
                    "const": "signed_out",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "hint"
                ],
                "type": "object"
              },
              {
                "description": "The executor does not offer the access mode the task asks for. A task is never run with\na different one.",
                "properties": {
                  "offered": {
                    "description": "What the executor offers.",
                    "items": {
                      "$ref": "#/$defs/AccessMode"
                    },
                    "type": "array"
                  },
                  "requested": {
                    "$ref": "#/$defs/AccessMode",
                    "description": "What the task asked for."
                  },
                  "type": {
                    "const": "access_not_offered",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "requested",
                  "offered"
                ],
                "type": "object"
              },
              {
                "description": "The executor does not enforce the sandbox level the task asks for.",
                "properties": {
                  "offered": {
                    "description": "What the executor enforces.",
                    "items": {
                      "$ref": "#/$defs/SandboxLevel"
                    },
                    "type": "array"
                  },
                  "requested": {
                    "$ref": "#/$defs/SandboxLevel",
                    "description": "What the task asked for."
                  },
                  "type": {
                    "const": "sandbox_not_enforced",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "requested",
                  "offered"
                ],
                "type": "object"
              },
              {
                "description": "The task leaves this executor out: the task pins another executor, its bot does not list\nthis one, or the request excludes it.",
                "properties": {
                  "type": {
                    "const": "excluded",
                    "type": "string"
                  },
                  "why": {
                    "description": "Which of those.",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "why"
                ],
                "type": "object"
              },
              {
                "description": "The daemon has no executor with this id.",
                "properties": {
                  "type": {
                    "const": "not_registered",
                    "type": "string"
                  }
                },
                "required": [
                  "type"
                ],
                "type": "object"
              },
              {
                "description": "The executor was chosen and then would not start, for an account or install reason. Added\nby the fallback walk.",
                "properties": {
                  "detail": {
                    "description": "The refusal, for a person.",
                    "type": "string"
                  },
                  "failure": {
                    "$ref": "#/$defs/StartFailureKind",
                    "description": "What the dispatcher found."
                  },
                  "type": {
                    "const": "start_failed",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "failure",
                  "detail"
                ],
                "type": "object"
              }
            ]
          },
          "Rejection": {
            "description": "An executor that was dropped, and why.",
            "properties": {
              "executor": {
                "$ref": "#/$defs/ExecutorId",
                "description": "The executor."
              },
              "reason": {
                "$ref": "#/$defs/RejectReason",
                "description": "Why."
              }
            },
            "required": [
              "executor",
              "reason"
            ],
            "type": "object"
          },
          "RoutingDecision": {
            "description": "Where a task goes and why.",
            "properties": {
              "atMs": {
                "description": "When the decision was made, in milliseconds since the Unix epoch.",
                "format": "uint64",
                "minimum": 0,
                "type": "integer"
              },
              "chosen": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/ExecutorId"
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "The executor the run starts on. Absent when no executor is eligible: the run then fails\nwith `NoEligibleExecutor`."
              },
              "fallbacks": {
                "description": "The fallback walk, in order. Empty when the first choice started.",
                "items": {
                  "$ref": "#/$defs/FallbackStep"
                },
                "type": "array"
              },
              "ranked": {
                "default": [],
                "description": "The candidates that passed the filter, best first. `chosen` is the first of them until a\nfallback moves on.",
                "items": {
                  "$ref": "#/$defs/ExecutorId"
                },
                "type": "array"
              },
              "rejected": {
                "default": [],
                "description": "The candidates the filter dropped, and the executors the fallback walk gave up on.",
                "items": {
                  "$ref": "#/$defs/Rejection"
                },
                "type": "array"
              },
              "ruleMatched": {
                "$ref": "#/$defs/RuleMatched",
                "description": "The rule that ordered `ranked`."
              },
              "warnings": {
                "description": "Things worth a person's attention that did not stop the run: the model the bot pins is\nnot in the chosen executor's model list (a list that may be curated and incomplete, so\nthe run still starts).",
                "items": {
                  "type": "string"
                },
                "type": "array"
              }
            },
            "required": [
              "ruleMatched",
              "atMs"
            ],
            "type": "object"
          },
          "RuleMatched": {
            "description": "The stage 2 rule that ordered the candidates. The first rule that matches wins.",
            "oneOf": [
              {
                "description": "The task named its executor.",
                "properties": {
                  "type": {
                    "const": "explicit_executor",
                    "type": "string"
                  }
                },
                "required": [
                  "type"
                ],
                "type": "object"
              },
              {
                "description": "The task's bot lists its executors in order of preference.",
                "properties": {
                  "bot": {
                    "description": "The bot.",
                    "type": "string"
                  },
                  "type": {
                    "const": "bot_preference",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "bot"
                ],
                "type": "object"
              },
              {
                "description": "No rule applied: the eligible executors in id order.",
                "properties": {
                  "type": {
                    "const": "default",
                    "type": "string"
                  }
                },
                "required": [
                  "type"
                ],
                "type": "object"
              }
            ]
          },
          "RunId": {
            "pattern": "^run_[A-Za-z0-9]{1,64}$",
            "type": "string"
          },
          "SandboxLevel": {
            "description": "The sandbox the harness itself enforces around its tools: a ceiling below the access mode.\nA run that asks for `ReadOnly` or `WorkspaceWrite` goes only to an executor that enforces that\nlevel; `Unrestricted` asks for no ceiling beyond the access mode, so every executor can take it.",
            "oneOf": [
              {
                "const": "read_only",
                "description": "No writes.",
                "type": "string"
              },
              {
                "const": "workspace_write",
                "description": "Writes confined to the workspace.",
                "type": "string"
              },
              {
                "const": "unrestricted",
                "description": "No sandbox ceiling beyond the access mode (and the run's worktree).",
                "type": "string"
              }
            ]
          },
          "StartFailureKind": {
            "description": "The reasons a start can fail that make the dispatcher try the next candidate. A failure after\nthe executor started is not one of them.",
            "oneOf": [
              {
                "const": "not_installed",
                "description": "Not installed.",
                "type": "string"
              },
              {
                "const": "not_signed_in",
                "description": "Signed out.",
                "type": "string"
              },
              {
                "const": "no_eligible_executor",
                "description": "Not eligible for the task: too old, or an access mode or sandbox it does not offer.",
                "type": "string"
              }
            ]
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "description": "Result of `run.routing`.",
        "properties": {
          "decision": {
            "anyOf": [
              {
                "$ref": "#/$defs/RoutingDecision"
              },
              {
                "type": "null"
              }
            ],
            "description": "Its routing decision, with every fallback step so far. Absent for a run made before\nrouting existed."
          },
          "runId": {
            "$ref": "#/$defs/RunId",
            "description": "The run."
          }
        },
        "required": [
          "runId"
        ],
        "title": "RunRoutingResult",
        "type": "object"
      }
    },
    {
      "name": "route.preview",
      "params": {
        "$defs": {
          "Attachment": {
            "description": "A file attached to a task: a path on the daemon's machine, with the name to show for it.",
            "properties": {
              "mime": {
                "description": "The media type, when known (`image/png`).",
                "type": [
                  "string",
                  "null"
                ]
              },
              "name": {
                "description": "The name to show: usually the file name.",
                "type": "string"
              },
              "path": {
                "description": "Absolute path of a readable regular file.",
                "type": "string"
              }
            },
            "required": [
              "path",
              "name"
            ],
            "type": "object"
          },
          "ExecutorId": {
            "pattern": "^[A-Za-z0-9._-]{1,64}$",
            "type": "string"
          },
          "TaskRunParams": {
            "description": "Params of `task.run`.",
            "properties": {
              "attachments": {
                "description": "Files the task refers to. The daemon checks that each is a readable file, within\n[`ATTACHMENTS_MAX_COUNT`] and [`ATTACHMENT_MAX_BYTES`], and appends an \"Attached files:\"\nlist of their paths to the prompt; the executor reads them from disk. Needs feature\n`attachments`.",
                "items": {
                  "$ref": "#/$defs/Attachment"
                },
                "type": "array"
              },
              "bot": {
                "description": "The bot to run it as. The run is pinned to the version of the bot's definition that is\ncurrent when the task is submitted. Needs feature `defs`.",
                "type": [
                  "string",
                  "null"
                ]
              },
              "cwd": {
                "description": "Working directory; the daemon's default when absent.",
                "type": [
                  "string",
                  "null"
                ]
              },
              "executor": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/ExecutorId"
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "Executor to run it on. May be left out when `bot` is given: the daemon then takes the\nfirst executor in the bot's list that it has."
              },
              "inPlace": {
                "description": "Let a write run work directly in `cwd` when it is not a git repository, as a bot's\n`inPlaceWrites` does. Without it such a run is refused, because there is no worktree to\nisolate it in. A git repository is never written in place, whatever this says. Needs\nfeature `routing`.",
                "type": "boolean"
              },
              "model": {
                "description": "Model override.",
                "type": [
                  "string",
                  "null"
                ]
              },
              "prompt": {
                "description": "The task prompt.",
                "type": "string"
              }
            },
            "required": [
              "prompt"
            ],
            "type": "object"
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "description": "Params of `route.preview`: the decision a task would get, without starting anything.",
        "properties": {
          "task": {
            "$ref": "#/$defs/TaskRunParams",
            "description": "The task, as `task.run` takes it. Nothing is created."
          }
        },
        "required": [
          "task"
        ],
        "title": "RoutePreviewParams",
        "type": "object"
      },
      "result": {
        "$defs": {
          "AccessMode": {
            "description": "How much a harness may do without asking. Never run with more than requested (ARCH-15).",
            "oneOf": [
              {
                "const": "supervised",
                "description": "Every consequential action needs approval.",
                "type": "string"
              },
              {
                "const": "auto_accept_edits",
                "description": "File edits proceed; commands and network still ask.",
                "type": "string"
              },
              {
                "const": "full_access",
                "description": "The harness asks nothing.",
                "type": "string"
              }
            ]
          },
          "ExecutorId": {
            "pattern": "^[A-Za-z0-9._-]{1,64}$",
            "type": "string"
          },
          "FallbackStep": {
            "description": "One step of the fallback walk: the executor that would not start, and what came next.",
            "properties": {
              "atMs": {
                "description": "When, in milliseconds since the Unix epoch.",
                "format": "uint64",
                "minimum": 0,
                "type": "integer"
              },
              "from": {
                "$ref": "#/$defs/ExecutorId",
                "description": "The executor that would not start."
              },
              "reason": {
                "$ref": "#/$defs/RejectReason",
                "description": "Why."
              },
              "to": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/ExecutorId"
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "The next candidate tried; absent when there was none left."
              }
            },
            "required": [
              "from",
              "reason",
              "atMs"
            ],
            "type": "object"
          },
          "RejectReason": {
            "description": "Why an executor was not chosen. The first six are the stage 1 filter; the last two are what\nthe dispatcher found when it tried.",
            "oneOf": [
              {
                "description": "The harness is not installed, or cannot be launched.",
                "properties": {
                  "detail": {
                    "description": "What the last probe said, for a person.",
                    "type": "string"
                  },
                  "type": {
                    "const": "not_installed",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "detail"
                ],
                "type": "object"
              },
              {
                "description": "The installed version is older than the adapter supports.",
                "properties": {
                  "found": {
                    "description": "The version found, when it could be read.",
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "min": {
                    "description": "The oldest supported version.",
                    "type": "string"
                  },
                  "type": {
                    "const": "too_old",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "min"
                ],
                "type": "object"
              },
              {
                "description": "The harness has no login.",
                "properties": {
                  "hint": {
                    "description": "What to do about it.",
                    "type": "string"
                  },
                  "type": {
                    "const": "signed_out",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "hint"
                ],
                "type": "object"
              },
              {
                "description": "The executor does not offer the access mode the task asks for. A task is never run with\na different one.",
                "properties": {
                  "offered": {
                    "description": "What the executor offers.",
                    "items": {
                      "$ref": "#/$defs/AccessMode"
                    },
                    "type": "array"
                  },
                  "requested": {
                    "$ref": "#/$defs/AccessMode",
                    "description": "What the task asked for."
                  },
                  "type": {
                    "const": "access_not_offered",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "requested",
                  "offered"
                ],
                "type": "object"
              },
              {
                "description": "The executor does not enforce the sandbox level the task asks for.",
                "properties": {
                  "offered": {
                    "description": "What the executor enforces.",
                    "items": {
                      "$ref": "#/$defs/SandboxLevel"
                    },
                    "type": "array"
                  },
                  "requested": {
                    "$ref": "#/$defs/SandboxLevel",
                    "description": "What the task asked for."
                  },
                  "type": {
                    "const": "sandbox_not_enforced",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "requested",
                  "offered"
                ],
                "type": "object"
              },
              {
                "description": "The task leaves this executor out: the task pins another executor, its bot does not list\nthis one, or the request excludes it.",
                "properties": {
                  "type": {
                    "const": "excluded",
                    "type": "string"
                  },
                  "why": {
                    "description": "Which of those.",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "why"
                ],
                "type": "object"
              },
              {
                "description": "The daemon has no executor with this id.",
                "properties": {
                  "type": {
                    "const": "not_registered",
                    "type": "string"
                  }
                },
                "required": [
                  "type"
                ],
                "type": "object"
              },
              {
                "description": "The executor was chosen and then would not start, for an account or install reason. Added\nby the fallback walk.",
                "properties": {
                  "detail": {
                    "description": "The refusal, for a person.",
                    "type": "string"
                  },
                  "failure": {
                    "$ref": "#/$defs/StartFailureKind",
                    "description": "What the dispatcher found."
                  },
                  "type": {
                    "const": "start_failed",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "failure",
                  "detail"
                ],
                "type": "object"
              }
            ]
          },
          "Rejection": {
            "description": "An executor that was dropped, and why.",
            "properties": {
              "executor": {
                "$ref": "#/$defs/ExecutorId",
                "description": "The executor."
              },
              "reason": {
                "$ref": "#/$defs/RejectReason",
                "description": "Why."
              }
            },
            "required": [
              "executor",
              "reason"
            ],
            "type": "object"
          },
          "RoutingDecision": {
            "description": "Where a task goes and why.",
            "properties": {
              "atMs": {
                "description": "When the decision was made, in milliseconds since the Unix epoch.",
                "format": "uint64",
                "minimum": 0,
                "type": "integer"
              },
              "chosen": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/ExecutorId"
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "The executor the run starts on. Absent when no executor is eligible: the run then fails\nwith `NoEligibleExecutor`."
              },
              "fallbacks": {
                "description": "The fallback walk, in order. Empty when the first choice started.",
                "items": {
                  "$ref": "#/$defs/FallbackStep"
                },
                "type": "array"
              },
              "ranked": {
                "default": [],
                "description": "The candidates that passed the filter, best first. `chosen` is the first of them until a\nfallback moves on.",
                "items": {
                  "$ref": "#/$defs/ExecutorId"
                },
                "type": "array"
              },
              "rejected": {
                "default": [],
                "description": "The candidates the filter dropped, and the executors the fallback walk gave up on.",
                "items": {
                  "$ref": "#/$defs/Rejection"
                },
                "type": "array"
              },
              "ruleMatched": {
                "$ref": "#/$defs/RuleMatched",
                "description": "The rule that ordered `ranked`."
              },
              "warnings": {
                "description": "Things worth a person's attention that did not stop the run: the model the bot pins is\nnot in the chosen executor's model list (a list that may be curated and incomplete, so\nthe run still starts).",
                "items": {
                  "type": "string"
                },
                "type": "array"
              }
            },
            "required": [
              "ruleMatched",
              "atMs"
            ],
            "type": "object"
          },
          "RuleMatched": {
            "description": "The stage 2 rule that ordered the candidates. The first rule that matches wins.",
            "oneOf": [
              {
                "description": "The task named its executor.",
                "properties": {
                  "type": {
                    "const": "explicit_executor",
                    "type": "string"
                  }
                },
                "required": [
                  "type"
                ],
                "type": "object"
              },
              {
                "description": "The task's bot lists its executors in order of preference.",
                "properties": {
                  "bot": {
                    "description": "The bot.",
                    "type": "string"
                  },
                  "type": {
                    "const": "bot_preference",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "bot"
                ],
                "type": "object"
              },
              {
                "description": "No rule applied: the eligible executors in id order.",
                "properties": {
                  "type": {
                    "const": "default",
                    "type": "string"
                  }
                },
                "required": [
                  "type"
                ],
                "type": "object"
              }
            ]
          },
          "SandboxLevel": {
            "description": "The sandbox the harness itself enforces around its tools: a ceiling below the access mode.\nA run that asks for `ReadOnly` or `WorkspaceWrite` goes only to an executor that enforces that\nlevel; `Unrestricted` asks for no ceiling beyond the access mode, so every executor can take it.",
            "oneOf": [
              {
                "const": "read_only",
                "description": "No writes.",
                "type": "string"
              },
              {
                "const": "workspace_write",
                "description": "Writes confined to the workspace.",
                "type": "string"
              },
              {
                "const": "unrestricted",
                "description": "No sandbox ceiling beyond the access mode (and the run's worktree).",
                "type": "string"
              }
            ]
          },
          "StartFailureKind": {
            "description": "The reasons a start can fail that make the dispatcher try the next candidate. A failure after\nthe executor started is not one of them.",
            "oneOf": [
              {
                "const": "not_installed",
                "description": "Not installed.",
                "type": "string"
              },
              {
                "const": "not_signed_in",
                "description": "Signed out.",
                "type": "string"
              },
              {
                "const": "no_eligible_executor",
                "description": "Not eligible for the task: too old, or an access mode or sandbox it does not offer.",
                "type": "string"
              }
            ]
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "description": "Result of `route.preview`.",
        "properties": {
          "decision": {
            "$ref": "#/$defs/RoutingDecision",
            "description": "What the router decides now."
          }
        },
        "required": [
          "decision"
        ],
        "title": "RoutePreviewResult",
        "type": "object"
      }
    },
    {
      "name": "budget.status",
      "params": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "description": "Params of `budget.status`: none.",
        "title": "BudgetStatusParams",
        "type": "object"
      },
      "result": {
        "$defs": {
          "BotBudgetStatus": {
            "description": "One bot's budget and what it has used.",
            "properties": {
              "bot": {
                "description": "The bot.",
                "type": "string"
              },
              "cacheReadTokensToday": {
                "default": 0,
                "description": "Of what its runs read today, the input served from the prompt cache, as the harnesses\nreported it (unweighted). `tokens_today` counts only a share of it.",
                "format": "uint64",
                "minimum": 0,
                "type": "integer"
              },
              "cacheWriteTokensToday": {
                "default": 0,
                "description": "Of what its runs sent today, the input written to the prompt cache (unweighted; counted\nin full by `tokens_today`).",
                "format": "uint64",
                "minimum": 0,
                "type": "integer"
              },
              "dailyTokenCeiling": {
                "description": "The most it may use per day; absent for no ceiling.",
                "format": "uint64",
                "minimum": 0,
                "type": [
                  "integer",
                  "null"
                ]
              },
              "liveRuns": {
                "description": "Runs of the bot that hold a slot now (claimed and not ended).",
                "format": "uint32",
                "minimum": 0,
                "type": "integer"
              },
              "maxConcurrentRuns": {
                "description": "The most it may have live: `budget.max_concurrent_runs` of its definition in force.",
                "format": "uint32",
                "minimum": 0,
                "type": "integer"
              },
              "maxWallTimeMs": {
                "description": "The longest one run may take, in milliseconds.",
                "format": "uint64",
                "minimum": 0,
                "type": "integer"
              },
              "paused": {
                "description": "Whether the bot is paused by itself (`budget.pause` with a bot). A global pause is\n`BudgetStatusResult::paused`.",
                "type": "boolean"
              },
              "queuedRuns": {
                "description": "Its runs waiting to be claimed.",
                "format": "uint32",
                "minimum": 0,
                "type": "integer"
              },
              "tokensToday": {
                "description": "The tokens its runs have used today as the ceiling counts them: input, output and cache\nwrites in full, plus the cache reads at the weight in\n`BudgetStatusResult::cache_read_weight_permille`.",
                "format": "uint64",
                "minimum": 0,
                "type": "integer"
              }
            },
            "required": [
              "bot",
              "liveRuns",
              "maxConcurrentRuns",
              "queuedRuns",
              "tokensToday",
              "maxWallTimeMs",
              "paused"
            ],
            "type": "object"
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "description": "Result of `budget.status`.",
        "properties": {
          "bots": {
            "description": "Every bot in the definitions in force, and any other that is paused, by name.",
            "items": {
              "$ref": "#/$defs/BotBudgetStatus"
            },
            "type": "array"
          },
          "cacheReadWeightPermille": {
            "default": 0,
            "description": "How much of a cache read counts toward a daily token ceiling, in thousandths (100 means a\ntenth). Cache reads are about a tenth of the price of input, so they weigh that much.\nAbsent from a daemon that predates the weight, which counted no cache tokens at all.",
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "day": {
            "description": "The local day the token counts are for, `YYYY-MM-DD`.",
            "type": "string"
          },
          "dayEndsAtMs": {
            "description": "When that day ends and the counts start again, in milliseconds since the epoch.",
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "defaultWallTimeMs": {
            "description": "The longest a run with no bot may take, in milliseconds.",
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "paused": {
            "description": "Whether everything is paused (`budget.pause` with no bot).",
            "type": "boolean"
          }
        },
        "required": [
          "paused",
          "day",
          "dayEndsAtMs",
          "defaultWallTimeMs",
          "bots"
        ],
        "title": "BudgetStatusResult",
        "type": "object"
      }
    },
    {
      "name": "budget.pause",
      "params": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "description": "Params of `budget.pause`.",
        "properties": {
          "bot": {
            "description": "The bot to pause; everything when absent.",
            "type": [
              "string",
              "null"
            ]
          },
          "stopLive": {
            "description": "Also stop the runs that are live now (each ends `interrupted`). Without it they go on.",
            "type": "boolean"
          }
        },
        "title": "BudgetPauseParams",
        "type": "object"
      },
      "result": {
        "$defs": {
          "RunId": {
            "pattern": "^run_[A-Za-z0-9]{1,64}$",
            "type": "string"
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "description": "Result of `budget.pause`.",
        "properties": {
          "changed": {
            "description": "False when it was paused already (and nothing but `stop_live` was done).",
            "type": "boolean"
          },
          "stopped": {
            "default": [],
            "description": "The live runs that were told to stop.",
            "items": {
              "$ref": "#/$defs/RunId"
            },
            "type": "array"
          }
        },
        "required": [
          "changed"
        ],
        "title": "BudgetPauseResult",
        "type": "object"
      }
    },
    {
      "name": "budget.resume",
      "params": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "description": "Params of `budget.resume`.",
        "properties": {
          "bot": {
            "description": "The bot to resume; the global pause when absent. A global pause and a bot's own are\nseparate: resuming one leaves the other.",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "title": "BudgetResumeParams",
        "type": "object"
      },
      "result": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "description": "Result of `budget.resume`.",
        "properties": {
          "changed": {
            "description": "False when it was not paused.",
            "type": "boolean"
          }
        },
        "required": [
          "changed"
        ],
        "title": "BudgetResumeResult",
        "type": "object"
      }
    },
    {
      "name": "run.list",
      "params": {
        "$defs": {
          "RunId": {
            "pattern": "^run_[A-Za-z0-9]{1,64}$",
            "type": "string"
          },
          "RunStatus": {
            "description": "Where a run is in its lifecycle. Serialised as a snake_case string.",
            "oneOf": [
              {
                "const": "queued",
                "description": "Waiting for a dispatcher to claim it.",
                "type": "string"
              },
              {
                "const": "leased",
                "description": "Claimed under a lease and fence; the executor is not yet running.",
                "type": "string"
              },
              {
                "const": "running",
                "description": "The executor is working.",
                "type": "string"
              },
              {
                "const": "waiting_input",
                "description": "Paused on an `ExecEvent::NeedsInput`.",
                "type": "string"
              },
              {
                "const": "waiting_approval",
                "description": "Paused on an `ExecEvent::NeedsApproval`.",
                "type": "string"
              },
              {
                "const": "evaluating",
                "description": "The harness finished; checks and verdicts are being gathered.",
                "type": "string"
              },
              {
                "const": "succeeded",
                "description": "Evaluation passed. Terminal.",
                "type": "string"
              },
              {
                "const": "failed",
                "description": "Evaluation failed or the harness errored. Terminal, except that a retry re-queues it.",
                "type": "string"
              },
              {
                "const": "interrupted",
                "description": "The daemon or executor stopped mid-run; resume or human review decides what follows.",
                "type": "string"
              },
              {
                "const": "cancelled",
                "description": "Cancelled before or after interruption. Terminal.",
                "type": "string"
              }
            ]
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "description": "Params of `run.list`.",
        "properties": {
          "before": {
            "anyOf": [
              {
                "$ref": "#/$defs/RunId"
              },
              {
                "type": "null"
              }
            ],
            "description": "Cursor: only runs older than this one. Pass the previous page's `next`."
          },
          "limit": {
            "description": "Maximum number of runs, newest first. Defaults to [`RUN_LIST_DEFAULT_LIMIT`] and is cut\nto [`RUN_LIST_MAX_LIMIT`].",
            "format": "uint32",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "status": {
            "description": "Only runs in one of these states; all runs when absent.",
            "items": {
              "$ref": "#/$defs/RunStatus"
            },
            "type": [
              "array",
              "null"
            ]
          }
        },
        "title": "RunListParams",
        "type": "object"
      },
      "result": {
        "$defs": {
          "BotPin": {
            "description": "The version of a bot's definition a run is pinned to.",
            "properties": {
              "name": {
                "description": "The bot's name.",
                "type": "string"
              },
              "version": {
                "description": "The version of its definition when the run was submitted.",
                "format": "uint32",
                "minimum": 0,
                "type": "integer"
              }
            },
            "required": [
              "name",
              "version"
            ],
            "type": "object"
          },
          "BudgetKind": {
            "description": "What a budget limits.",
            "oneOf": [
              {
                "const": "wall_time",
                "description": "How long one run may take (`budget.max_wall_time`). Limits are in milliseconds.",
                "type": "string"
              },
              {
                "const": "tokens",
                "description": "What a bot may spend per local day (`budget.daily_token_ceiling`). Limits are in tokens:\ninput, output and cache writes in full, and cache reads at a fraction of their count\n(`BudgetStatusResult::cache_read_weight_permille`).",
                "type": "string"
              }
            ]
          },
          "CancelledBy": {
            "description": "Who cancelled a run.",
            "oneOf": [
              {
                "const": "user",
                "description": "A person (`run.cancel`).",
                "type": "string"
              },
              {
                "const": "pause",
                "description": "The kill switch (`budget.pause` with `stopLive`).",
                "type": "string"
              }
            ]
          },
          "ExecutorId": {
            "pattern": "^[A-Za-z0-9._-]{1,64}$",
            "type": "string"
          },
          "NotResumed": {
            "description": "Why a run was not resumed, or cannot be: set on an `interrupted` run that recovery looked at\nand left, and the reason `run.resume` gives when it refuses.",
            "oneOf": [
              {
                "description": "A person cancelled it; their word stands.",
                "properties": {
                  "type": {
                    "const": "cancelled",
                    "type": "string"
                  }
                },
                "required": [
                  "type"
                ],
                "type": "object"
              },
              {
                "description": "The kill switch stopped it.",
                "properties": {
                  "type": {
                    "const": "paused",
                    "type": "string"
                  }
                },
                "required": [
                  "type"
                ],
                "type": "object"
              },
              {
                "description": "A budget stopped it; resuming would spend the same budget again.",
                "properties": {
                  "type": {
                    "const": "budget_stopped",
                    "type": "string"
                  }
                },
                "required": [
                  "type"
                ],
                "type": "object"
              },
              {
                "description": "The executor ended it by itself; a loop of those is not retried unasked.",
                "properties": {
                  "type": {
                    "const": "executor_stopped",
                    "type": "string"
                  }
                },
                "required": [
                  "type"
                ],
                "type": "object"
              },
              {
                "description": "It never started on an executor.",
                "properties": {
                  "type": {
                    "const": "start_refused",
                    "type": "string"
                  }
                },
                "required": [
                  "type"
                ],
                "type": "object"
              },
              {
                "description": "The harness never reported a session, so there is nothing to resume.",
                "properties": {
                  "type": {
                    "const": "no_session",
                    "type": "string"
                  }
                },
                "required": [
                  "type"
                ],
                "type": "object"
              },
              {
                "description": "The run's executor does not declare resume support.",
                "properties": {
                  "executor": {
                    "$ref": "#/$defs/ExecutorId",
                    "description": "The executor."
                  },
                  "type": {
                    "const": "executor_cannot_resume",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "executor"
                ],
                "type": "object"
              },
              {
                "description": "The run's executor is not registered in this daemon.",
                "properties": {
                  "executor": {
                    "$ref": "#/$defs/ExecutorId",
                    "description": "The executor."
                  },
                  "type": {
                    "const": "executor_missing",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "executor"
                ],
                "type": "object"
              },
              {
                "description": "The run's bot has `resume = \"never\"`.",
                "properties": {
                  "bot": {
                    "description": "The bot.",
                    "type": "string"
                  },
                  "type": {
                    "const": "bot_forbids",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "bot"
                ],
                "type": "object"
              },
              {
                "description": "The run has used its attempts.",
                "properties": {
                  "attempts": {
                    "description": "Attempts made.",
                    "format": "uint32",
                    "minimum": 0,
                    "type": "integer"
                  },
                  "max": {
                    "description": "Attempts allowed.",
                    "format": "uint32",
                    "minimum": 0,
                    "type": "integer"
                  },
                  "type": {
                    "const": "attempts_exhausted",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "attempts",
                  "max"
                ],
                "type": "object"
              },
              {
                "description": "The run is past its wall-time budget.",
                "properties": {
                  "limitMs": {
                    "description": "The limit, in milliseconds.",
                    "format": "uint64",
                    "minimum": 0,
                    "type": "integer"
                  },
                  "type": {
                    "const": "wall_time_spent",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "limitMs"
                ],
                "type": "object"
              },
              {
                "description": "The run's executor has not finished stopping; ask again in a moment.",
                "properties": {
                  "type": {
                    "const": "still_stopping",
                    "type": "string"
                  }
                },
                "required": [
                  "type"
                ],
                "type": "object"
              },
              {
                "description": "Only `interrupted` runs, and `failed` ones that have a session, can be resumed.",
                "properties": {
                  "status": {
                    "$ref": "#/$defs/RunStatus",
                    "description": "The run's status."
                  },
                  "type": {
                    "const": "wrong_status",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "status"
                ],
                "type": "object"
              }
            ]
          },
          "RunId": {
            "pattern": "^run_[A-Za-z0-9]{1,64}$",
            "type": "string"
          },
          "RunStatus": {
            "description": "Where a run is in its lifecycle. Serialised as a snake_case string.",
            "oneOf": [
              {
                "const": "queued",
                "description": "Waiting for a dispatcher to claim it.",
                "type": "string"
              },
              {
                "const": "leased",
                "description": "Claimed under a lease and fence; the executor is not yet running.",
                "type": "string"
              },
              {
                "const": "running",
                "description": "The executor is working.",
                "type": "string"
              },
              {
                "const": "waiting_input",
                "description": "Paused on an `ExecEvent::NeedsInput`.",
                "type": "string"
              },
              {
                "const": "waiting_approval",
                "description": "Paused on an `ExecEvent::NeedsApproval`.",
                "type": "string"
              },
              {
                "const": "evaluating",
                "description": "The harness finished; checks and verdicts are being gathered.",
                "type": "string"
              },
              {
                "const": "succeeded",
                "description": "Evaluation passed. Terminal.",
                "type": "string"
              },
              {
                "const": "failed",
                "description": "Evaluation failed or the harness errored. Terminal, except that a retry re-queues it.",
                "type": "string"
              },
              {
                "const": "interrupted",
                "description": "The daemon or executor stopped mid-run; resume or human review decides what follows.",
                "type": "string"
              },
              {
                "const": "cancelled",
                "description": "Cancelled before or after interruption. Terminal.",
                "type": "string"
              }
            ]
          },
          "RunSummary": {
            "description": "One run, as shown in lists and watches.",
            "properties": {
              "attempt": {
                "description": "Attempt number, from 1.",
                "format": "uint32",
                "minimum": 0,
                "type": "integer"
              },
              "bot": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/BotPin"
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "The bot the run was submitted for, and the version of its definition the run is pinned\nto. Absent for a run submitted without a bot."
              },
              "createdAtMs": {
                "description": "Creation time, in milliseconds since the Unix epoch.",
                "format": "uint64",
                "minimum": 0,
                "type": "integer"
              },
              "executor": {
                "$ref": "#/$defs/ExecutorId",
                "description": "The executor running it."
              },
              "model": {
                "description": "The model the run was asked for, or the one the executor reported once it started.",
                "type": [
                  "string",
                  "null"
                ]
              },
              "notResumed": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/NotResumed"
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "Why an `interrupted` run was not resumed, once the daemon has looked. Absent while the\nrun may still be resumed, and for any run that is not interrupted. Needs feature\n`run.resume`."
              },
              "prompt": {
                "description": "The prompt the task was submitted with. Absent from daemons that predate it. In\n`run.list` and `runs.watch` it is cut to [`PROMPT_SUMMARY_CHARS`] characters, ending in\n`…` when cut; `run.get` returns it whole.",
                "type": [
                  "string",
                  "null"
                ]
              },
              "runId": {
                "$ref": "#/$defs/RunId",
                "description": "The run."
              },
              "session": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/SessionRef"
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "The harness session of the run, once its executor has reported one: what a resume\ncontinues. Needs feature `run.resume`."
              },
              "status": {
                "$ref": "#/$defs/RunStatus",
                "description": "Current lifecycle state."
              },
              "stop": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/StopDetail"
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "The typed reason behind the run's last stop, when the daemon knows one: a budget, a\nrefused start, a cancel, a shutdown, a crash. Needs feature `run.stop_detail`."
              },
              "stopReason": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/StopReason"
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "Why it stopped, once it has."
              },
              "taskId": {
                "$ref": "#/$defs/TaskId",
                "description": "The task it attempts."
              },
              "title": {
                "description": "First line of the prompt, for display.",
                "type": "string"
              },
              "updatedAtMs": {
                "description": "Last state change, in milliseconds since the Unix epoch.",
                "format": "uint64",
                "minimum": 0,
                "type": "integer"
              }
            },
            "required": [
              "runId",
              "taskId",
              "executor",
              "status",
              "attempt",
              "title",
              "createdAtMs",
              "updatedAtMs"
            ],
            "type": "object"
          },
          "SessionRef": {
            "description": "An opaque handle a harness gives for resuming a conversation.",
            "type": "string"
          },
          "StartRefusal": {
            "description": "Why a run could not start. A run that is refused never reached its harness.",
            "oneOf": [
              {
                "const": "not_installed",
                "description": "The executor's harness is not installed (or is too old to use).",
                "type": "string"
              },
              {
                "const": "not_signed_in",
                "description": "The executor's harness is not signed in.",
                "type": "string"
              },
              {
                "const": "no_eligible_executor",
                "description": "No executor can honour the run: an access mode or sandbox level nobody offers, or a task\nthat named no executor and has no default to go to.",
                "type": "string"
              },
              {
                "const": "workspace_refused",
                "description": "The run's workspace could not be prepared: a write run with no git repository to isolate\nit in, or git failing.",
                "type": "string"
              },
              {
                "const": "secret_missing",
                "description": "A secret the run's bot lists is not set, or the secret store cannot be read (a locked\nKeychain). A person has to act: `reno secret set <NAME>`.",
                "type": "string"
              },
              {
                "const": "invalid",
                "description": "Anything else that stopped the start: an unknown executor, an unreadable bot definition,\na task with no working directory, a spec the executor rejected.",
                "type": "string"
              }
            ]
          },
          "StopDetail": {
            "description": "The typed reason behind a run's last stop, beside the human `diagnostic`. A client decides\nwhat to show from this and never from the diagnostic's text.",
            "oneOf": [
              {
                "description": "A budget stopped the run.",
                "properties": {
                  "kind": {
                    "$ref": "#/$defs/BudgetKind",
                    "description": "Which limit."
                  },
                  "limit": {
                    "description": "The limit: milliseconds for `wall_time`, tokens for `tokens`.",
                    "format": "uint64",
                    "minimum": 0,
                    "type": "integer"
                  },
                  "type": {
                    "const": "budget_exceeded",
                    "type": "string"
                  },
                  "used": {
                    "description": "What had been used when it was noticed, in the same unit.",
                    "format": "uint64",
                    "minimum": 0,
                    "type": "integer"
                  }
                },
                "required": [
                  "type",
                  "kind",
                  "limit",
                  "used"
                ],
                "type": "object"
              },
              {
                "description": "The run never started: `failure` says why, `detail` is the daemon's words for a person.",
                "properties": {
                  "detail": {
                    "description": "The refusal as a sentence.",
                    "type": "string"
                  },
                  "failure": {
                    "$ref": "#/$defs/StartRefusal",
                    "description": "The kind of refusal."
                  },
                  "type": {
                    "const": "start_refused",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "failure",
                  "detail"
                ],
                "type": "object"
              },
              {
                "description": "Someone cancelled the run.",
                "properties": {
                  "by": {
                    "$ref": "#/$defs/CancelledBy",
                    "description": "Who."
                  },
                  "type": {
                    "const": "cancelled",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "by"
                ],
                "type": "object"
              },
              {
                "description": "The daemon was shutting down. The run is resumed at the next start when it may be.",
                "properties": {
                  "type": {
                    "const": "shutdown",
                    "type": "string"
                  }
                },
                "required": [
                  "type"
                ],
                "type": "object"
              },
              {
                "description": "The daemon died with the run live; recovery found it at the next start.",
                "properties": {
                  "type": {
                    "const": "crashed",
                    "type": "string"
                  }
                },
                "required": [
                  "type"
                ],
                "type": "object"
              },
              {
                "description": "The executor ended the run itself, as interrupted, without being asked to.",
                "properties": {
                  "type": {
                    "const": "executor_stopped",
                    "type": "string"
                  }
                },
                "required": [
                  "type"
                ],
                "type": "object"
              }
            ]
          },
          "StopReason": {
            "description": "Why an executor stopped, carried by `ExecEvent::Done`.",
            "oneOf": [
              {
                "const": "completed",
                "description": "The harness finished its turn normally.",
                "type": "string"
              },
              {
                "const": "interrupted",
                "description": "The harness was stopped before finishing.",
                "type": "string"
              },
              {
                "const": "error",
                "description": "The harness failed. A failing harness ends with this, never with a stream error.",
                "type": "string"
              },
              {
                "const": "refusal",
                "description": "The model declined the request.",
                "type": "string"
              },
              {
                "const": "max_tokens",
                "description": "The model hit its output limit.",
                "type": "string"
              }
            ]
          },
          "TaskId": {
            "pattern": "^task_[A-Za-z0-9]{1,64}$",
            "type": "string"
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "description": "Result of `run.list`.",
        "properties": {
          "next": {
            "anyOf": [
              {
                "$ref": "#/$defs/RunId"
              },
              {
                "type": "null"
              }
            ],
            "description": "Pass as `before` to get the next page; absent on the last page."
          },
          "runs": {
            "description": "Matching runs, newest first.",
            "items": {
              "$ref": "#/$defs/RunSummary"
            },
            "type": "array"
          }
        },
        "required": [
          "runs"
        ],
        "title": "RunListResult",
        "type": "object"
      }
    },
    {
      "name": "run.cancel",
      "params": {
        "$defs": {
          "RunId": {
            "pattern": "^run_[A-Za-z0-9]{1,64}$",
            "type": "string"
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "description": "Params of `run.cancel`.",
        "properties": {
          "reason": {
            "description": "Why, for the audit trail.",
            "type": [
              "string",
              "null"
            ]
          },
          "runId": {
            "$ref": "#/$defs/RunId",
            "description": "The run to cancel."
          }
        },
        "required": [
          "runId"
        ],
        "title": "RunCancelParams",
        "type": "object"
      },
      "result": {
        "$defs": {
          "RunStatus": {
            "description": "Where a run is in its lifecycle. Serialised as a snake_case string.",
            "oneOf": [
              {
                "const": "queued",
                "description": "Waiting for a dispatcher to claim it.",
                "type": "string"
              },
              {
                "const": "leased",
                "description": "Claimed under a lease and fence; the executor is not yet running.",
                "type": "string"
              },
              {
                "const": "running",
                "description": "The executor is working.",
                "type": "string"
              },
              {
                "const": "waiting_input",
                "description": "Paused on an `ExecEvent::NeedsInput`.",
                "type": "string"
              },
              {
                "const": "waiting_approval",
                "description": "Paused on an `ExecEvent::NeedsApproval`.",
                "type": "string"
              },
              {
                "const": "evaluating",
                "description": "The harness finished; checks and verdicts are being gathered.",
                "type": "string"
              },
              {
                "const": "succeeded",
                "description": "Evaluation passed. Terminal.",
                "type": "string"
              },
              {
                "const": "failed",
                "description": "Evaluation failed or the harness errored. Terminal, except that a retry re-queues it.",
                "type": "string"
              },
              {
                "const": "interrupted",
                "description": "The daemon or executor stopped mid-run; resume or human review decides what follows.",
                "type": "string"
              },
              {
                "const": "cancelled",
                "description": "Cancelled before or after interruption. Terminal.",
                "type": "string"
              }
            ]
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "description": "Result of `run.cancel`.",
        "properties": {
          "status": {
            "$ref": "#/$defs/RunStatus",
            "description": "The run's status once the cancel was accepted."
          }
        },
        "required": [
          "status"
        ],
        "title": "RunCancelResult",
        "type": "object"
      }
    },
    {
      "name": "run.resume",
      "params": {
        "$defs": {
          "RunId": {
            "pattern": "^run_[A-Za-z0-9]{1,64}$",
            "type": "string"
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "description": "Params of `run.resume`.",
        "properties": {
          "prompt": {
            "description": "What to tell the harness when the session continues; the daemon's standard \"continue\"\nprompt when absent.",
            "type": [
              "string",
              "null"
            ]
          },
          "runId": {
            "$ref": "#/$defs/RunId",
            "description": "The run to resume: `interrupted`, or `failed` with a session."
          }
        },
        "required": [
          "runId"
        ],
        "title": "RunResumeParams",
        "type": "object"
      },
      "result": {
        "$defs": {
          "RunStatus": {
            "description": "Where a run is in its lifecycle. Serialised as a snake_case string.",
            "oneOf": [
              {
                "const": "queued",
                "description": "Waiting for a dispatcher to claim it.",
                "type": "string"
              },
              {
                "const": "leased",
                "description": "Claimed under a lease and fence; the executor is not yet running.",
                "type": "string"
              },
              {
                "const": "running",
                "description": "The executor is working.",
                "type": "string"
              },
              {
                "const": "waiting_input",
                "description": "Paused on an `ExecEvent::NeedsInput`.",
                "type": "string"
              },
              {
                "const": "waiting_approval",
                "description": "Paused on an `ExecEvent::NeedsApproval`.",
                "type": "string"
              },
              {
                "const": "evaluating",
                "description": "The harness finished; checks and verdicts are being gathered.",
                "type": "string"
              },
              {
                "const": "succeeded",
                "description": "Evaluation passed. Terminal.",
                "type": "string"
              },
              {
                "const": "failed",
                "description": "Evaluation failed or the harness errored. Terminal, except that a retry re-queues it.",
                "type": "string"
              },
              {
                "const": "interrupted",
                "description": "The daemon or executor stopped mid-run; resume or human review decides what follows.",
                "type": "string"
              },
              {
                "const": "cancelled",
                "description": "Cancelled before or after interruption. Terminal.",
                "type": "string"
              }
            ]
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "description": "Result of `run.resume`.",
        "properties": {
          "attempt": {
            "description": "The attempt it will be, from 2.",
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "status": {
            "$ref": "#/$defs/RunStatus",
            "description": "The run's status once it was queued again (`queued`)."
          }
        },
        "required": [
          "status",
          "attempt"
        ],
        "title": "RunResumeResult",
        "type": "object"
      }
    },
    {
      "name": "run.steer",
      "params": {
        "$defs": {
          "RunId": {
            "pattern": "^run_[A-Za-z0-9]{1,64}$",
            "type": "string"
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "description": "Params of `run.steer`.",
        "properties": {
          "prompt": {
            "description": "The steering message, delivered at the executor's next step or turn boundary.",
            "type": "string"
          },
          "runId": {
            "$ref": "#/$defs/RunId",
            "description": "The live run to steer."
          }
        },
        "required": [
          "runId",
          "prompt"
        ],
        "title": "RunSteerParams",
        "type": "object"
      },
      "result": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "description": "Result of `run.steer`: empty.",
        "title": "RunSteerResult",
        "type": "object"
      }
    },
    {
      "name": "approval.list",
      "params": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "description": "Empty params: serialises as `{}`.",
        "title": "NoParams",
        "type": "object"
      },
      "result": {
        "$defs": {
          "ActionClass": {
            "description": "What kind of action an approval is about.",
            "oneOf": [
              {
                "const": "read",
                "description": "Reading files.",
                "type": "string"
              },
              {
                "const": "edit",
                "description": "Editing files.",
                "type": "string"
              },
              {
                "const": "command",
                "description": "Running a command.",
                "type": "string"
              },
              {
                "const": "network",
                "description": "Network access.",
                "type": "string"
              },
              {
                "const": "mcp_tool",
                "description": "An MCP tool call.",
                "type": "string"
              },
              {
                "const": "other",
                "description": "Anything else.",
                "type": "string"
              }
            ]
          },
          "Approval": {
            "description": "An action a harness is held on, waiting for a human decision.",
            "properties": {
              "id": {
                "$ref": "#/$defs/ApprovalId",
                "description": "The approval, as `approval.decide` refers to it."
              },
              "requestedAtMs": {
                "description": "When the action was held, in milliseconds since the Unix epoch.",
                "format": "uint64",
                "minimum": 0,
                "type": "integer"
              },
              "runId": {
                "$ref": "#/$defs/RunId",
                "description": "The run that is held."
              },
              "subject": {
                "$ref": "#/$defs/ApprovalSubject",
                "description": "Exactly what is being approved."
              }
            },
            "required": [
              "id",
              "runId",
              "subject",
              "requestedAtMs"
            ],
            "type": "object"
          },
          "ApprovalId": {
            "pattern": "^appr_[A-Za-z0-9]{1,64}$",
            "type": "string"
          },
          "ApprovalSubject": {
            "description": "The exact thing a human is asked to approve.",
            "properties": {
              "action": {
                "$ref": "#/$defs/ActionClass",
                "description": "Class of the action."
              },
              "command": {
                "description": "The command line, for command actions.",
                "type": [
                  "string",
                  "null"
                ]
              },
              "paths": {
                "default": [],
                "description": "Paths the action touches.",
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "raw": {
                "default": null,
                "description": "The harness's own request, kept for the audit record."
              },
              "tool": {
                "description": "Tool the action goes through.",
                "type": "string"
              }
            },
            "required": [
              "action",
              "tool"
            ],
            "type": "object"
          },
          "RunId": {
            "pattern": "^run_[A-Za-z0-9]{1,64}$",
            "type": "string"
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "description": "Result of `approval.list`.",
        "properties": {
          "approvals": {
            "description": "Pending approvals, oldest first.",
            "items": {
              "$ref": "#/$defs/Approval"
            },
            "type": "array"
          }
        },
        "required": [
          "approvals"
        ],
        "title": "ApprovalListResult",
        "type": "object"
      }
    },
    {
      "name": "approval.decide",
      "params": {
        "$defs": {
          "ApprovalDecision": {
            "description": "A human's answer to an [`Approval`].",
            "oneOf": [
              {
                "const": "approve_once",
                "description": "Allow this one action; the next similar action asks again.",
                "type": "string"
              },
              {
                "const": "deny",
                "description": "Refuse the action.",
                "type": "string"
              }
            ]
          },
          "ApprovalId": {
            "pattern": "^appr_[A-Za-z0-9]{1,64}$",
            "type": "string"
          },
          "Remember": {
            "description": "What `approval.decide` may add: keep this decision as a standing rule.",
            "properties": {
              "expiresInSecs": {
                "description": "The rule stops applying this many seconds after it is made. Absent: it holds until\nrevoked (a `run` rule ends with its run in any case). At most [`RULE_MAX_EXPIRY_SECS`];\nzero is refused.",
                "format": "uint64",
                "minimum": 0,
                "type": [
                  "integer",
                  "null"
                ]
              },
              "scope": {
                "$ref": "#/$defs/RememberScope",
                "description": "How far the rule reaches."
              }
            },
            "required": [
              "scope"
            ],
            "type": "object"
          },
          "RememberScope": {
            "description": "How far a person's answer reaches. `once` is a plain answer with no `remember`.",
            "oneOf": [
              {
                "const": "run",
                "description": "Every later matching action of this run.",
                "type": "string"
              },
              {
                "const": "bot",
                "description": "Every later matching action of any run of this run's bot. Refused for a run with no bot.",
                "type": "string"
              },
              {
                "const": "always",
                "description": "Every later matching action, whatever the run or bot.",
                "type": "string"
              }
            ]
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "description": "Params of `approval.decide`.",
        "properties": {
          "approvalId": {
            "$ref": "#/$defs/ApprovalId",
            "description": "The approval to answer."
          },
          "decision": {
            "$ref": "#/$defs/ApprovalDecision",
            "description": "The answer."
          },
          "message": {
            "description": "Why, for a denial: it reaches the harness (as a rule's message does), is journalled in\n`ApprovalResolved.message` and shows in `approval.history`. Refused with an approval.\nAt most [`APPROVAL_MESSAGE_MAX_CHARS`] characters; blank counts as absent. Needs feature\n`approval.message`.",
            "type": [
              "string",
              "null"
            ]
          },
          "remember": {
            "anyOf": [
              {
                "$ref": "#/$defs/Remember"
              },
              {
                "type": "null"
              }
            ],
            "description": "Keep this answer as a standing rule: the rule's matcher is derived from the approval's\nsubject and is never broader than it. Absent is \"once\": this one request only. Refused\nwith scope `bot` for a run that has no bot. Needs feature `rules`."
          }
        },
        "required": [
          "approvalId",
          "decision"
        ],
        "title": "ApprovalDecideParams",
        "type": "object"
      },
      "result": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "description": "Result of `approval.decide`: empty.",
        "title": "ApprovalDecideResult",
        "type": "object"
      }
    },
    {
      "name": "approval.history",
      "params": {
        "$defs": {
          "RunId": {
            "pattern": "^run_[A-Za-z0-9]{1,64}$",
            "type": "string"
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "description": "Params of `approval.history`.",
        "properties": {
          "limit": {
            "description": "Most records, newest decision first. Defaults to [`APPROVAL_HISTORY_DEFAULT_LIMIT`] and\nis cut to [`APPROVAL_HISTORY_MAX_LIMIT`].",
            "format": "uint32",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "run": {
            "anyOf": [
              {
                "$ref": "#/$defs/RunId"
              },
              {
                "type": "null"
              }
            ],
            "description": "Only this run's approvals; every run's when absent."
          }
        },
        "title": "ApprovalHistoryParams",
        "type": "object"
      },
      "result": {
        "$defs": {
          "ActionClass": {
            "description": "What kind of action an approval is about.",
            "oneOf": [
              {
                "const": "read",
                "description": "Reading files.",
                "type": "string"
              },
              {
                "const": "edit",
                "description": "Editing files.",
                "type": "string"
              },
              {
                "const": "command",
                "description": "Running a command.",
                "type": "string"
              },
              {
                "const": "network",
                "description": "Network access.",
                "type": "string"
              },
              {
                "const": "mcp_tool",
                "description": "An MCP tool call.",
                "type": "string"
              },
              {
                "const": "other",
                "description": "Anything else.",
                "type": "string"
              }
            ]
          },
          "ApprovalId": {
            "pattern": "^appr_[A-Za-z0-9]{1,64}$",
            "type": "string"
          },
          "ApprovalRecord": {
            "description": "The stored record of one approval request: what was asked, and how it was resolved.",
            "properties": {
              "createdAtMs": {
                "description": "When it was raised, in milliseconds since the Unix epoch.",
                "format": "uint64",
                "minimum": 0,
                "type": "integer"
              },
              "decidedAtMs": {
                "description": "When it was decided. Absent while pending.",
                "format": "uint64",
                "minimum": 0,
                "type": [
                  "integer",
                  "null"
                ]
              },
              "decidedBy": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/ResolvedBy"
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "Who or what decided. Absent while the approval is pending."
              },
              "expiresAtMs": {
                "description": "The deadline after which an undecided approval is denied as expired.",
                "format": "uint64",
                "minimum": 0,
                "type": "integer"
              },
              "id": {
                "$ref": "#/$defs/ApprovalId",
                "description": "The approval's id."
              },
              "message": {
                "description": "The reason a human gave with a denial. Only daemons that negotiate `approval.message`\nfill it.",
                "type": [
                  "string",
                  "null"
                ]
              },
              "requestId": {
                "description": "The harness's id for the request (the `requestId` of the `NeedsApproval` event).",
                "type": "string"
              },
              "runId": {
                "$ref": "#/$defs/RunId",
                "description": "The run that raised it."
              },
              "status": {
                "$ref": "#/$defs/ApprovalStatus",
                "description": "Where it stands."
              },
              "subject": {
                "$ref": "#/$defs/ApprovalSubject",
                "description": "Exactly what was asked."
              },
              "subjectDigest": {
                "description": "The subject's digest (SHA-256, 64 lowercase hex digits): what repeat-denial and an\nexact-match comparison go by. Absent from daemons that predate feature `rules`.",
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "id",
              "runId",
              "requestId",
              "subject",
              "status",
              "createdAtMs",
              "expiresAtMs"
            ],
            "type": "object"
          },
          "ApprovalStatus": {
            "description": "Where an approval record stands.",
            "oneOf": [
              {
                "const": "pending",
                "description": "Waiting for a human.",
                "type": "string"
              },
              {
                "const": "approved",
                "description": "The harness was told yes.",
                "type": "string"
              },
              {
                "const": "denied",
                "description": "The harness was told no.",
                "type": "string"
              },
              {
                "const": "expired",
                "description": "Nobody decided in time, or the run ended or the daemon restarted first. The harness, if\nit was still there, was told no.",
                "type": "string"
              }
            ]
          },
          "ApprovalSubject": {
            "description": "The exact thing a human is asked to approve.",
            "properties": {
              "action": {
                "$ref": "#/$defs/ActionClass",
                "description": "Class of the action."
              },
              "command": {
                "description": "The command line, for command actions.",
                "type": [
                  "string",
                  "null"
                ]
              },
              "paths": {
                "default": [],
                "description": "Paths the action touches.",
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "raw": {
                "default": null,
                "description": "The harness's own request, kept for the audit record."
              },
              "tool": {
                "description": "Tool the action goes through.",
                "type": "string"
              }
            },
            "required": [
              "action",
              "tool"
            ],
            "type": "object"
          },
          "ResolvedBy": {
            "description": "Who or what resolved an approval request, and so why the transcript shows the outcome it\ndoes.",
            "oneOf": [
              {
                "description": "A person decided it.",
                "properties": {
                  "type": {
                    "const": "human",
                    "type": "string"
                  }
                },
                "required": [
                  "type"
                ],
                "type": "object"
              },
              {
                "description": "A rule decided it, with no question asked. `name` is a policy rule's `note`, or `rules[N]`\nwhen it has none, or `default` when no rule matched and the policy's default effect\napplied; `standing:<rule id>` for a standing rule a person made (`rule.list`); or\n`builtin:reno-mcp` for a call to one of Reno's own MCP tools.",
                "properties": {
                  "name": {
                    "description": "The rule's name.",
                    "type": "string"
                  },
                  "type": {
                    "const": "rule",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "name"
                ],
                "type": "object"
              },
              {
                "description": "Nobody decided before the approval's time limit, or the run ended or the daemon\nrestarted first. Always an outcome of `denied`.",
                "properties": {
                  "type": {
                    "const": "expired",
                    "type": "string"
                  }
                },
                "required": [
                  "type"
                ],
                "type": "object"
              },
              {
                "description": "The same action was denied earlier in this run, so it was denied again unasked.",
                "properties": {
                  "type": {
                    "const": "repeat_denial",
                    "type": "string"
                  }
                },
                "required": [
                  "type"
                ],
                "type": "object"
              }
            ]
          },
          "RunId": {
            "pattern": "^run_[A-Za-z0-9]{1,64}$",
            "type": "string"
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "description": "Result of `approval.history`.",
        "properties": {
          "approvals": {
            "description": "Decided approvals (never pending ones), newest decision first.",
            "items": {
              "$ref": "#/$defs/ApprovalRecord"
            },
            "type": "array"
          }
        },
        "required": [
          "approvals"
        ],
        "title": "ApprovalHistoryResult",
        "type": "object"
      }
    },
    {
      "name": "def.list",
      "params": {
        "$defs": {
          "DefKind": {
            "description": "The kinds of definition this version loads. Teams and flows join with their tasks.",
            "oneOf": [
              {
                "const": "bot",
                "description": "A bot: `bots/<name>.toml`.",
                "type": "string"
              },
              {
                "const": "trigger",
                "description": "A trigger: `triggers/<name>.toml`.",
                "type": "string"
              },
              {
                "const": "policy",
                "description": "The policy: `policy.toml`.",
                "type": "string"
              }
            ]
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "description": "Params of `def.list`.",
        "properties": {
          "kind": {
            "anyOf": [
              {
                "$ref": "#/$defs/DefKind"
              },
              {
                "type": "null"
              }
            ],
            "description": "Only this kind; all kinds when absent."
          }
        },
        "title": "DefListParams",
        "type": "object"
      },
      "result": {
        "$defs": {
          "DefError": {
            "description": "One problem with a definition, located by file and by a path inside it.\n\nDisplays as `bots/keeper.toml: executors[2]: unknown executor \"x\"`. A problem with the file\nas a whole has an empty `path` and displays as `bots/keeper.toml: <message>`.",
            "properties": {
              "file": {
                "description": "The file, relative to the definitions root.",
                "type": "string"
              },
              "message": {
                "description": "What is wrong, for a person.",
                "type": "string"
              },
              "path": {
                "description": "The field inside it, such as `executors[2]` or `target.bot`; empty for the whole file.",
                "type": "string"
              }
            },
            "required": [
              "file",
              "message"
            ],
            "type": "object"
          },
          "DefKind": {
            "description": "The kinds of definition this version loads. Teams and flows join with their tasks.",
            "oneOf": [
              {
                "const": "bot",
                "description": "A bot: `bots/<name>.toml`.",
                "type": "string"
              },
              {
                "const": "trigger",
                "description": "A trigger: `triggers/<name>.toml`.",
                "type": "string"
              },
              {
                "const": "policy",
                "description": "The policy: `policy.toml`.",
                "type": "string"
              }
            ]
          },
          "DefSummary": {
            "description": "One stored version of one definition, without its body.",
            "properties": {
              "createdAtMs": {
                "description": "When this version was first stored, in milliseconds since the Unix epoch.",
                "format": "uint64",
                "minimum": 0,
                "type": "integer"
              },
              "hash": {
                "description": "The content hash of the version: 64 lowercase hex digits.",
                "type": "string"
              },
              "kind": {
                "$ref": "#/$defs/DefKind",
                "description": "The kind."
              },
              "name": {
                "description": "The name; `policy` for the policy.",
                "type": "string"
              },
              "version": {
                "description": "The version, counted from 1 per name.",
                "format": "uint32",
                "minimum": 0,
                "type": "integer"
              }
            },
            "required": [
              "kind",
              "name",
              "version",
              "hash",
              "createdAtMs"
            ],
            "type": "object"
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "description": "The current definitions and the problems with the files, as the daemon holds them.\n\nWhen `errors` is not empty the files on disk do not validate, and `defs` is the last set that\ndid: the daemon keeps running on it until the files are fixed.",
        "properties": {
          "defs": {
            "description": "The current version of every definition, by kind and then name.",
            "items": {
              "$ref": "#/$defs/DefSummary"
            },
            "type": "array"
          },
          "errors": {
            "default": [],
            "description": "Every problem found in the last load; empty when the files are valid.",
            "items": {
              "$ref": "#/$defs/DefError"
            },
            "type": "array"
          }
        },
        "required": [
          "defs"
        ],
        "title": "DefsSnapshot",
        "type": "object"
      }
    },
    {
      "name": "def.get",
      "params": {
        "$defs": {
          "DefKind": {
            "description": "The kinds of definition this version loads. Teams and flows join with their tasks.",
            "oneOf": [
              {
                "const": "bot",
                "description": "A bot: `bots/<name>.toml`.",
                "type": "string"
              },
              {
                "const": "trigger",
                "description": "A trigger: `triggers/<name>.toml`.",
                "type": "string"
              },
              {
                "const": "policy",
                "description": "The policy: `policy.toml`.",
                "type": "string"
              }
            ]
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "description": "Params of `def.get`.",
        "properties": {
          "kind": {
            "$ref": "#/$defs/DefKind",
            "description": "The kind."
          },
          "name": {
            "description": "The name; `policy` for the policy.",
            "type": "string"
          },
          "version": {
            "description": "The version; the newest when absent.",
            "format": "uint32",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          }
        },
        "required": [
          "kind",
          "name"
        ],
        "title": "DefGetParams",
        "type": "object"
      },
      "result": {
        "$defs": {
          "DefKind": {
            "description": "The kinds of definition this version loads. Teams and flows join with their tasks.",
            "oneOf": [
              {
                "const": "bot",
                "description": "A bot: `bots/<name>.toml`.",
                "type": "string"
              },
              {
                "const": "trigger",
                "description": "A trigger: `triggers/<name>.toml`.",
                "type": "string"
              },
              {
                "const": "policy",
                "description": "The policy: `policy.toml`.",
                "type": "string"
              }
            ]
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "description": "Result of `def.get`: one version with its body.",
        "properties": {
          "body": {
            "description": "The definition, in the shape of its file."
          },
          "createdAtMs": {
            "description": "When this version was first stored, in milliseconds since the Unix epoch.",
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "hash": {
            "description": "The content hash.",
            "type": "string"
          },
          "kind": {
            "$ref": "#/$defs/DefKind",
            "description": "The kind."
          },
          "latest": {
            "description": "Whether this is the newest stored version of the name.",
            "type": "boolean"
          },
          "name": {
            "description": "The name.",
            "type": "string"
          },
          "version": {
            "description": "The version.",
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "kind",
          "name",
          "version",
          "hash",
          "body",
          "createdAtMs",
          "latest"
        ],
        "title": "DefRecord",
        "type": "object"
      }
    },
    {
      "name": "def.validate",
      "params": {
        "$defs": {
          "DefKind": {
            "description": "The kinds of definition this version loads. Teams and flows join with their tasks.",
            "oneOf": [
              {
                "const": "bot",
                "description": "A bot: `bots/<name>.toml`.",
                "type": "string"
              },
              {
                "const": "trigger",
                "description": "A trigger: `triggers/<name>.toml`.",
                "type": "string"
              },
              {
                "const": "policy",
                "description": "The policy: `policy.toml`.",
                "type": "string"
              }
            ]
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "description": "Params of `def.validate`.",
        "properties": {
          "body": {
            "description": "The definition, in the shape of its file."
          },
          "kind": {
            "$ref": "#/$defs/DefKind",
            "description": "The kind."
          },
          "name": {
            "description": "The name the body would be saved under: the file stem.",
            "type": "string"
          }
        },
        "required": [
          "kind",
          "name",
          "body"
        ],
        "title": "DefValidateParams",
        "type": "object"
      },
      "result": {
        "$defs": {
          "DefError": {
            "description": "One problem with a definition, located by file and by a path inside it.\n\nDisplays as `bots/keeper.toml: executors[2]: unknown executor \"x\"`. A problem with the file\nas a whole has an empty `path` and displays as `bots/keeper.toml: <message>`.",
            "properties": {
              "file": {
                "description": "The file, relative to the definitions root.",
                "type": "string"
              },
              "message": {
                "description": "What is wrong, for a person.",
                "type": "string"
              },
              "path": {
                "description": "The field inside it, such as `executors[2]` or `target.bot`; empty for the whole file.",
                "type": "string"
              }
            },
            "required": [
              "file",
              "message"
            ],
            "type": "object"
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "description": "Result of `def.validate`.",
        "properties": {
          "errors": {
            "description": "Every problem found; empty when `valid`.",
            "items": {
              "$ref": "#/$defs/DefError"
            },
            "type": "array"
          },
          "hash": {
            "description": "The content hash the body would have, when valid.",
            "type": [
              "string",
              "null"
            ]
          },
          "valid": {
            "description": "Whether the body passes every rule, in the context of the current definitions.",
            "type": "boolean"
          }
        },
        "required": [
          "valid",
          "errors"
        ],
        "title": "DefValidateResult",
        "type": "object"
      }
    },
    {
      "name": "trigger.list",
      "params": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "description": "Empty params: serialises as `{}`.",
        "title": "NoParams",
        "type": "object"
      },
      "result": {
        "$defs": {
          "RunId": {
            "pattern": "^run_[A-Za-z0-9]{1,64}$",
            "type": "string"
          },
          "TriggerInfo": {
            "description": "One trigger and its state.",
            "properties": {
              "backoffUntilMs": {
                "description": "Until when it is backed off.",
                "format": "uint64",
                "minimum": 0,
                "type": [
                  "integer",
                  "null"
                ]
              },
              "bot": {
                "description": "The bot it starts.",
                "type": "string"
              },
              "cwd": {
                "description": "The working directory its definition names, as written (`~/` is not expanded). Absent\nwhen the runs use the daemon's own workspace.",
                "type": [
                  "string",
                  "null"
                ]
              },
              "error": {
                "description": "Why it cannot run, when `status` is `failed`.",
                "type": [
                  "string",
                  "null"
                ]
              },
              "failures": {
                "description": "Consecutive account-level failures to start; `0` when healthy.",
                "format": "uint32",
                "minimum": 0,
                "type": "integer"
              },
              "kind": {
                "description": "The `kind` of its `when`: `at`, `after`, `every`, `cron`, `fs` or `manual`.",
                "type": "string"
              },
              "lastFiredAtMs": {
                "description": "When it last started a run (or merged into one).",
                "format": "uint64",
                "minimum": 0,
                "type": [
                  "integer",
                  "null"
                ]
              },
              "lastRunId": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/RunId"
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "The run it last started."
              },
              "name": {
                "description": "The trigger's name.",
                "type": "string"
              },
              "nextDueAtMs": {
                "description": "When it fires next. Absent for `fs`, `manual`, a finished one-shot and a disabled trigger.",
                "format": "uint64",
                "minimum": 0,
                "type": [
                  "integer",
                  "null"
                ]
              },
              "status": {
                "$ref": "#/$defs/TriggerStatus",
                "description": "Where it stands."
              },
              "version": {
                "description": "The version of the definition in force.",
                "format": "uint32",
                "minimum": 0,
                "type": "integer"
              }
            },
            "required": [
              "name",
              "kind",
              "bot",
              "version",
              "status",
              "failures"
            ],
            "type": "object"
          },
          "TriggerStatus": {
            "description": "Where a trigger stands.",
            "oneOf": [
              {
                "const": "scheduled",
                "description": "Waiting for its next due time (`nextDueAtMs`).",
                "type": "string"
              },
              {
                "const": "watching",
                "description": "Watching files (`fs`).",
                "type": "string"
              },
              {
                "const": "manual",
                "description": "Fires only when asked (`manual`).",
                "type": "string"
              },
              {
                "const": "done",
                "description": "A one-shot (`at`, `after`) that has fired.",
                "type": "string"
              },
              {
                "const": "backed_off",
                "description": "Backed off after repeated failures to start; fires again at `backoffUntilMs`.",
                "type": "string"
              },
              {
                "const": "disabled",
                "description": "Disabled in its definition.",
                "type": "string"
              },
              {
                "const": "failed",
                "description": "Cannot run: see `error`.",
                "type": "string"
              }
            ]
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "description": "Result of `trigger.list`.",
        "properties": {
          "triggers": {
            "description": "Every trigger in the definitions in force, by name.",
            "items": {
              "$ref": "#/$defs/TriggerInfo"
            },
            "type": "array"
          }
        },
        "required": [
          "triggers"
        ],
        "title": "TriggerListResult",
        "type": "object"
      }
    },
    {
      "name": "trigger.fire",
      "params": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "description": "Params of `trigger.fire`.",
        "properties": {
          "name": {
            "description": "The trigger to fire now. A `manual` trigger or any enabled one.",
            "type": "string"
          }
        },
        "required": [
          "name"
        ],
        "title": "TriggerFireParams",
        "type": "object"
      },
      "result": {
        "$defs": {
          "FiringOutcome": {
            "description": "What became of one occurrence of a trigger.",
            "oneOf": [
              {
                "const": "fired",
                "description": "A run was started for it.",
                "type": "string"
              },
              {
                "const": "coalesced",
                "description": "The trigger's previous run is still going, so no run was started: the occurrence is\nmerged into that run.",
                "type": "string"
              },
              {
                "const": "duplicate",
                "description": "This occurrence had already been fired (its nonce exists), so nothing was done. Returned\nby `trigger.fire`; never stored, because the nonce is unique.",
                "type": "string"
              },
              {
                "const": "backed_off",
                "description": "The run it started could not start for an account-level reason (not installed, not\nsigned in, no eligible executor), and the trigger was backed off.",
                "type": "string"
              }
            ]
          },
          "RunId": {
            "pattern": "^run_[A-Za-z0-9]{1,64}$",
            "type": "string"
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "description": "Result of `trigger.fire`.",
        "properties": {
          "outcome": {
            "$ref": "#/$defs/FiringOutcome",
            "description": "What became of it."
          },
          "runId": {
            "anyOf": [
              {
                "$ref": "#/$defs/RunId"
              },
              {
                "type": "null"
              }
            ],
            "description": "The run started, or, for `coalesced`, the run it was merged into."
          },
          "scheduledAtMs": {
            "description": "The occurrence it fired for.",
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "outcome",
          "scheduledAtMs"
        ],
        "title": "TriggerFireResult",
        "type": "object"
      }
    },
    {
      "name": "workspace.list",
      "params": {
        "$defs": {
          "WorkspaceStatus": {
            "description": "Where a workspace stands.",
            "oneOf": [
              {
                "const": "preparing",
                "description": "Recorded, and being created. A workspace found in this state at start-up is a crash\nleftover and is reconciled.",
                "type": "string"
              },
              {
                "const": "active",
                "description": "Created, and its run has not ended (or may be resumed).",
                "type": "string"
              },
              {
                "const": "kept",
                "description": "Its run ended and it holds commits or uncommitted changes, so the worktree and the branch\nare kept for a later integration step.",
                "type": "string"
              },
              {
                "const": "removed",
                "description": "Its worktree and branch were removed.",
                "type": "string"
              },
              {
                "const": "lost",
                "description": "Its directory vanished and was pruned; the branch may remain.",
                "type": "string"
              }
            ]
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "description": "Params of `workspace.list`.",
        "properties": {
          "status": {
            "description": "Only workspaces in one of these statuses; every workspace when absent.",
            "items": {
              "$ref": "#/$defs/WorkspaceStatus"
            },
            "type": [
              "array",
              "null"
            ]
          }
        },
        "title": "WorkspaceListParams",
        "type": "object"
      },
      "result": {
        "$defs": {
          "RunId": {
            "pattern": "^run_[A-Za-z0-9]{1,64}$",
            "type": "string"
          },
          "WorkspaceChanges": {
            "description": "What a workspace holds beyond its base commit.",
            "properties": {
              "commits": {
                "description": "Commits on the branch that its base commit does not have.",
                "format": "uint32",
                "minimum": 0,
                "type": "integer"
              },
              "dirty": {
                "description": "Whether the worktree has uncommitted changes or untracked files.",
                "type": "boolean"
              }
            },
            "required": [
              "commits",
              "dirty"
            ],
            "type": "object"
          },
          "WorkspaceInfo": {
            "description": "One run's workspace.",
            "properties": {
              "baseSha": {
                "description": "The commit the branch was cut from.",
                "type": "string"
              },
              "branch": {
                "description": "The branch, `reno/<run id>`.",
                "type": "string"
              },
              "changes": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/WorkspaceChanges"
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "What it held when its run last ended."
              },
              "createdAtMs": {
                "description": "When it was recorded.",
                "format": "uint64",
                "minimum": 0,
                "type": "integer"
              },
              "path": {
                "description": "The worktree's root.",
                "type": "string"
              },
              "repo": {
                "description": "The repository's working tree root the task targeted.",
                "type": "string"
              },
              "repoKey": {
                "description": "The stable, collision-free key of the repository in the worktrees directory.",
                "type": "string"
              },
              "runId": {
                "$ref": "#/$defs/RunId",
                "description": "The run it belongs to."
              },
              "status": {
                "$ref": "#/$defs/WorkspaceStatus",
                "description": "Where it stands."
              },
              "subdir": {
                "description": "The directory inside the repository the task targeted, relative to its root; empty for the\nroot. The run's working directory is `path` joined with it.",
                "type": "string"
              },
              "updatedAtMs": {
                "description": "When it last changed.",
                "format": "uint64",
                "minimum": 0,
                "type": "integer"
              }
            },
            "required": [
              "runId",
              "repo",
              "repoKey",
              "path",
              "branch",
              "baseSha",
              "status",
              "createdAtMs",
              "updatedAtMs"
            ],
            "type": "object"
          },
          "WorkspaceStatus": {
            "description": "Where a workspace stands.",
            "oneOf": [
              {
                "const": "preparing",
                "description": "Recorded, and being created. A workspace found in this state at start-up is a crash\nleftover and is reconciled.",
                "type": "string"
              },
              {
                "const": "active",
                "description": "Created, and its run has not ended (or may be resumed).",
                "type": "string"
              },
              {
                "const": "kept",
                "description": "Its run ended and it holds commits or uncommitted changes, so the worktree and the branch\nare kept for a later integration step.",
                "type": "string"
              },
              {
                "const": "removed",
                "description": "Its worktree and branch were removed.",
                "type": "string"
              },
              {
                "const": "lost",
                "description": "Its directory vanished and was pruned; the branch may remain.",
                "type": "string"
              }
            ]
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "description": "Result of `workspace.list`.",
        "properties": {
          "workspaces": {
            "description": "The workspaces, newest first.",
            "items": {
              "$ref": "#/$defs/WorkspaceInfo"
            },
            "type": "array"
          }
        },
        "required": [
          "workspaces"
        ],
        "title": "WorkspaceListResult",
        "type": "object"
      }
    },
    {
      "name": "workspace.get",
      "params": {
        "$defs": {
          "RunId": {
            "pattern": "^run_[A-Za-z0-9]{1,64}$",
            "type": "string"
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "description": "Params of `workspace.get`.",
        "properties": {
          "runId": {
            "$ref": "#/$defs/RunId",
            "description": "The run whose workspace to return."
          }
        },
        "required": [
          "runId"
        ],
        "title": "WorkspaceGetParams",
        "type": "object"
      },
      "result": {
        "$defs": {
          "RunId": {
            "pattern": "^run_[A-Za-z0-9]{1,64}$",
            "type": "string"
          },
          "WorkspaceChanges": {
            "description": "What a workspace holds beyond its base commit.",
            "properties": {
              "commits": {
                "description": "Commits on the branch that its base commit does not have.",
                "format": "uint32",
                "minimum": 0,
                "type": "integer"
              },
              "dirty": {
                "description": "Whether the worktree has uncommitted changes or untracked files.",
                "type": "boolean"
              }
            },
            "required": [
              "commits",
              "dirty"
            ],
            "type": "object"
          },
          "WorkspaceStatus": {
            "description": "Where a workspace stands.",
            "oneOf": [
              {
                "const": "preparing",
                "description": "Recorded, and being created. A workspace found in this state at start-up is a crash\nleftover and is reconciled.",
                "type": "string"
              },
              {
                "const": "active",
                "description": "Created, and its run has not ended (or may be resumed).",
                "type": "string"
              },
              {
                "const": "kept",
                "description": "Its run ended and it holds commits or uncommitted changes, so the worktree and the branch\nare kept for a later integration step.",
                "type": "string"
              },
              {
                "const": "removed",
                "description": "Its worktree and branch were removed.",
                "type": "string"
              },
              {
                "const": "lost",
                "description": "Its directory vanished and was pruned; the branch may remain.",
                "type": "string"
              }
            ]
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "description": "One run's workspace.",
        "properties": {
          "baseSha": {
            "description": "The commit the branch was cut from.",
            "type": "string"
          },
          "branch": {
            "description": "The branch, `reno/<run id>`.",
            "type": "string"
          },
          "changes": {
            "anyOf": [
              {
                "$ref": "#/$defs/WorkspaceChanges"
              },
              {
                "type": "null"
              }
            ],
            "description": "What it held when its run last ended."
          },
          "createdAtMs": {
            "description": "When it was recorded.",
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "path": {
            "description": "The worktree's root.",
            "type": "string"
          },
          "repo": {
            "description": "The repository's working tree root the task targeted.",
            "type": "string"
          },
          "repoKey": {
            "description": "The stable, collision-free key of the repository in the worktrees directory.",
            "type": "string"
          },
          "runId": {
            "$ref": "#/$defs/RunId",
            "description": "The run it belongs to."
          },
          "status": {
            "$ref": "#/$defs/WorkspaceStatus",
            "description": "Where it stands."
          },
          "subdir": {
            "description": "The directory inside the repository the task targeted, relative to its root; empty for the\nroot. The run's working directory is `path` joined with it.",
            "type": "string"
          },
          "updatedAtMs": {
            "description": "When it last changed.",
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "runId",
          "repo",
          "repoKey",
          "path",
          "branch",
          "baseSha",
          "status",
          "createdAtMs",
          "updatedAtMs"
        ],
        "title": "WorkspaceInfo",
        "type": "object"
      }
    },
    {
      "name": "workspace.clean",
      "params": {
        "$defs": {
          "CleanTarget": {
            "description": "Which workspaces `workspace.clean` looks at.",
            "oneOf": [
              {
                "description": "One run's workspace.",
                "properties": {
                  "runId": {
                    "$ref": "#/$defs/RunId",
                    "description": "The run."
                  },
                  "type": {
                    "const": "run",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "runId"
                ],
                "type": "object"
              },
              {
                "description": "Workspaces whose branch is merged into their repository's current `HEAD`.",
                "properties": {
                  "type": {
                    "const": "merged",
                    "type": "string"
                  }
                },
                "required": [
                  "type"
                ],
                "type": "object"
              },
              {
                "description": "Workspaces with no commits and no uncommitted changes.",
                "properties": {
                  "type": {
                    "const": "all_clean",
                    "type": "string"
                  }
                },
                "required": [
                  "type"
                ],
                "type": "object"
              }
            ]
          },
          "RunId": {
            "pattern": "^run_[A-Za-z0-9]{1,64}$",
            "type": "string"
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "description": "Params of `workspace.clean`.",
        "properties": {
          "force": {
            "default": false,
            "description": "Remove a workspace even when it holds unmerged commits or uncommitted changes, deleting\nits branch. The only way to lose work.",
            "type": "boolean"
          },
          "target": {
            "$ref": "#/$defs/CleanTarget",
            "description": "What to clean."
          }
        },
        "required": [
          "target"
        ],
        "title": "WorkspaceCleanParams",
        "type": "object"
      },
      "result": {
        "$defs": {
          "CleanItem": {
            "description": "One workspace `workspace.clean` looked at.",
            "properties": {
              "outcome": {
                "$ref": "#/$defs/CleanOutcome",
                "description": "What was done."
              },
              "reason": {
                "description": "Why it was kept, in words.",
                "type": [
                  "string",
                  "null"
                ]
              },
              "runId": {
                "$ref": "#/$defs/RunId",
                "description": "The run."
              }
            },
            "required": [
              "runId",
              "outcome"
            ],
            "type": "object"
          },
          "CleanOutcome": {
            "description": "What `workspace.clean` did with one workspace.",
            "oneOf": [
              {
                "const": "removed",
                "description": "The worktree and the branch were removed.",
                "type": "string"
              },
              {
                "const": "kept",
                "description": "Left as it was: see `reason`.",
                "type": "string"
              }
            ]
          },
          "RunId": {
            "pattern": "^run_[A-Za-z0-9]{1,64}$",
            "type": "string"
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "description": "Result of `workspace.clean`.",
        "properties": {
          "items": {
            "description": "Each workspace looked at.",
            "items": {
              "$ref": "#/$defs/CleanItem"
            },
            "type": "array"
          }
        },
        "required": [
          "items"
        ],
        "title": "WorkspaceCleanResult",
        "type": "object"
      }
    },
    {
      "name": "secret.list",
      "params": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "description": "Empty params: serialises as `{}`.",
        "title": "NoParams",
        "type": "object"
      },
      "result": {
        "$defs": {
          "SecretInfo": {
            "description": "One secret `secret.list` knows of.",
            "properties": {
              "name": {
                "description": "The secret's name.",
                "type": "string"
              },
              "set": {
                "description": "Whether the Keychain holds a value for it. A name that a bot asks for and nobody has set\nis listed with `false`.",
                "type": "boolean"
              },
              "usedBy": {
                "description": "The bots whose definitions ask for it, sorted.",
                "items": {
                  "type": "string"
                },
                "type": "array"
              }
            },
            "required": [
              "name",
              "set"
            ],
            "type": "object"
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "description": "Result of `secret.list`: names and whether each is set, never a value.",
        "properties": {
          "secrets": {
            "description": "Every secret in the Keychain or asked for by a bot, sorted by name.",
            "items": {
              "$ref": "#/$defs/SecretInfo"
            },
            "type": "array"
          }
        },
        "required": [
          "secrets"
        ],
        "title": "SecretListResult",
        "type": "object"
      }
    },
    {
      "name": "secret.set",
      "params": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "description": "Params of `secret.set`. The value is stored straight into the Keychain; it never appears in a\nlog, an error or this type's `Debug`.",
        "properties": {
          "name": {
            "description": "The secret's name.",
            "type": "string"
          },
          "value": {
            "description": "The value.",
            "type": "string"
          }
        },
        "required": [
          "name",
          "value"
        ],
        "title": "SecretSetParams",
        "type": "object"
      },
      "result": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "description": "Result of `secret.set`.",
        "properties": {
          "replaced": {
            "description": "The secret already had a value, which is now replaced.",
            "type": "boolean"
          }
        },
        "required": [
          "replaced"
        ],
        "title": "SecretSetResult",
        "type": "object"
      }
    },
    {
      "name": "secret.delete",
      "params": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "description": "Params of `secret.delete`.",
        "properties": {
          "name": {
            "description": "The secret's name.",
            "type": "string"
          }
        },
        "required": [
          "name"
        ],
        "title": "SecretDeleteParams",
        "type": "object"
      },
      "result": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "description": "Result of `secret.delete`.",
        "properties": {
          "deleted": {
            "description": "The Keychain had it. Deleting a name that is not there is not an error.",
            "type": "boolean"
          }
        },
        "required": [
          "deleted"
        ],
        "title": "SecretDeleteResult",
        "type": "object"
      }
    },
    {
      "name": "rule.list",
      "params": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "description": "Params of `rule.list`.",
        "properties": {
          "includeInactive": {
            "default": false,
            "description": "Also return revoked and expired rules. Default: only the ones in force.",
            "type": "boolean"
          }
        },
        "title": "RuleListParams",
        "type": "object"
      },
      "result": {
        "$defs": {
          "ActionClass": {
            "description": "What kind of action an approval is about.",
            "oneOf": [
              {
                "const": "read",
                "description": "Reading files.",
                "type": "string"
              },
              {
                "const": "edit",
                "description": "Editing files.",
                "type": "string"
              },
              {
                "const": "command",
                "description": "Running a command.",
                "type": "string"
              },
              {
                "const": "network",
                "description": "Network access.",
                "type": "string"
              },
              {
                "const": "mcp_tool",
                "description": "An MCP tool call.",
                "type": "string"
              },
              {
                "const": "other",
                "description": "Anything else.",
                "type": "string"
              }
            ]
          },
          "ApprovalId": {
            "pattern": "^appr_[A-Za-z0-9]{1,64}$",
            "type": "string"
          },
          "CommandPattern": {
            "description": "How a rule matches a command line.",
            "oneOf": [
              {
                "description": "The line, character for character. What a rule derived from a subject holds.",
                "properties": {
                  "command": {
                    "description": "The command line.",
                    "type": "string"
                  },
                  "type": {
                    "const": "exact",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "command"
                ],
                "type": "object"
              },
              {
                "description": "A policy `command` glob (`cargo *`), read by the policy's compound-command rules. Only a\nperson who edits a rule gets one; nothing derives it.",
                "properties": {
                  "pattern": {
                    "description": "The glob.",
                    "type": "string"
                  },
                  "type": {
                    "const": "glob",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "pattern"
                ],
                "type": "object"
              }
            ]
          },
          "RuleId": {
            "pattern": "^rule_[A-Za-z0-9]{1,64}$",
            "type": "string"
          },
          "RuleMatcher": {
            "description": "What a standing rule matches. See the module docs for what each part means and what leaving\none out means.",
            "properties": {
              "action": {
                "$ref": "#/$defs/ActionClass",
                "description": "The action class, equal."
              },
              "command": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/CommandPattern"
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "The command; absent means the subject has no command."
              },
              "paths": {
                "default": [],
                "description": "Path globs; empty means the subject has no paths.",
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "tool": {
                "description": "The tool name, equal.",
                "type": "string"
              }
            },
            "required": [
              "action",
              "tool"
            ],
            "type": "object"
          },
          "RunId": {
            "pattern": "^run_[A-Za-z0-9]{1,64}$",
            "type": "string"
          },
          "StandingEffect": {
            "description": "What a standing rule does when it matches.",
            "oneOf": [
              {
                "const": "allow",
                "description": "The harness is told yes, unasked.",
                "type": "string"
              },
              {
                "const": "deny",
                "description": "The harness is told no, unasked.",
                "type": "string"
              }
            ]
          },
          "StandingRule": {
            "description": "A standing rule as stored and as `rule.list` returns it.",
            "properties": {
              "createdAtMs": {
                "description": "When, in milliseconds since the Unix epoch.",
                "format": "uint64",
                "minimum": 0,
                "type": "integer"
              },
              "createdBy": {
                "description": "Who made it: `human`.",
                "type": "string"
              },
              "effect": {
                "$ref": "#/$defs/StandingEffect",
                "description": "What it does."
              },
              "expiresAtMs": {
                "description": "When it stops applying. Absent: when revoked.",
                "format": "uint64",
                "minimum": 0,
                "type": [
                  "integer",
                  "null"
                ]
              },
              "id": {
                "$ref": "#/$defs/RuleId",
                "description": "The rule's id, as `rule.revoke` refers to it."
              },
              "matcher": {
                "$ref": "#/$defs/RuleMatcher",
                "description": "What it matches."
              },
              "revokedAtMs": {
                "description": "When it was revoked. Absent while it is not.",
                "format": "uint64",
                "minimum": 0,
                "type": [
                  "integer",
                  "null"
                ]
              },
              "scope": {
                "$ref": "#/$defs/StandingScope",
                "description": "Where it applies."
              },
              "sourceApproval": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/ApprovalId"
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "The approval whose answer it came from."
              }
            },
            "required": [
              "id",
              "scope",
              "effect",
              "matcher",
              "createdBy",
              "createdAtMs"
            ],
            "type": "object"
          },
          "StandingScope": {
            "description": "Where a standing rule applies.",
            "oneOf": [
              {
                "description": "One run.",
                "properties": {
                  "run": {
                    "$ref": "#/$defs/RunId",
                    "description": "The run."
                  },
                  "type": {
                    "const": "run",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "run"
                ],
                "type": "object"
              },
              {
                "description": "Every run of one bot.",
                "properties": {
                  "bot": {
                    "description": "The bot's name.",
                    "type": "string"
                  },
                  "type": {
                    "const": "bot",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "bot"
                ],
                "type": "object"
              },
              {
                "description": "Every run.",
                "properties": {
                  "type": {
                    "const": "always",
                    "type": "string"
                  }
                },
                "required": [
                  "type"
                ],
                "type": "object"
              }
            ]
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "description": "Result of `rule.list`.",
        "properties": {
          "rules": {
            "description": "Newest first.",
            "items": {
              "$ref": "#/$defs/StandingRule"
            },
            "type": "array"
          }
        },
        "required": [
          "rules"
        ],
        "title": "RuleListResult",
        "type": "object"
      }
    },
    {
      "name": "rule.revoke",
      "params": {
        "$defs": {
          "RuleId": {
            "pattern": "^rule_[A-Za-z0-9]{1,64}$",
            "type": "string"
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "description": "Params of `rule.revoke`.",
        "properties": {
          "id": {
            "$ref": "#/$defs/RuleId",
            "description": "The rule to revoke."
          }
        },
        "required": [
          "id"
        ],
        "title": "RuleRevokeParams",
        "type": "object"
      },
      "result": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "description": "Result of `rule.revoke`: empty.",
        "title": "RuleRevokeResult",
        "type": "object"
      }
    },
    {
      "name": "executor.list",
      "params": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "description": "Empty params: serialises as `{}`.",
        "title": "NoParams",
        "type": "object"
      },
      "result": {
        "$defs": {
          "AccessMode": {
            "description": "How much a harness may do without asking. Never run with more than requested (ARCH-15).",
            "oneOf": [
              {
                "const": "supervised",
                "description": "Every consequential action needs approval.",
                "type": "string"
              },
              {
                "const": "auto_accept_edits",
                "description": "File edits proceed; commands and network still ask.",
                "type": "string"
              },
              {
                "const": "full_access",
                "description": "The harness asks nothing.",
                "type": "string"
              }
            ]
          },
          "ExecutorCaps": {
            "description": "What an executor declares it can do. Nothing is trusted beyond this (ARCH-15).",
            "properties": {
              "accessModes": {
                "description": "Access modes the executor can honour.",
                "items": {
                  "$ref": "#/$defs/AccessMode"
                },
                "type": "array"
              },
              "deterministicTurnEnd": {
                "description": "Whether the end of a turn is reported deterministically.",
                "type": "boolean"
              },
              "isolatesUserConfig": {
                "default": false,
                "description": "Whether a run is kept from loading the owner's personal configuration for that harness\n(its user-level settings, hooks, plugins, memory and instructions) unless the bot opts in\n(`inherit_user_config`). Only claimed where the driver enforces it; false means a run\nloads whatever the owner's own CLI would (ARCH-15).",
                "type": "boolean"
              },
              "mcpInjection": {
                "description": "False means it cannot join a team or use boards.",
                "type": "boolean"
              },
              "modelAliases": {
                "description": "Names the CLI accepts for a model besides the ids in `models`: short aliases that\nresolve on the CLI's side (`sonnet`, `opus`), so they are never reported as unknown.\nEmpty when the harness has none.",
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "models": {
                "description": "Models on offer.",
                "items": {
                  "$ref": "#/$defs/ModelInfo"
                },
                "type": "array"
              },
              "planMode": {
                "description": "Whether a plan mode exists.",
                "type": "boolean"
              },
              "resume": {
                "description": "Whether sessions can be resumed.",
                "type": "boolean"
              },
              "sandboxLevels": {
                "description": "Sandbox levels the executor can honour: a run is only started at a level listed here. An\nexecutor with no sandbox of its own honours only `Unrestricted`.",
                "items": {
                  "$ref": "#/$defs/SandboxLevel"
                },
                "type": "array"
              },
              "steering": {
                "$ref": "#/$defs/Steering",
                "description": "When steering messages can land."
              },
              "structuredOutput": {
                "description": "Whether `output_schema` is honoured.",
                "type": "boolean"
              }
            },
            "required": [
              "steering",
              "resume",
              "accessModes",
              "sandboxLevels",
              "mcpInjection",
              "structuredOutput",
              "deterministicTurnEnd",
              "planMode",
              "models"
            ],
            "type": "object"
          },
          "ExecutorDescriptor": {
            "description": "An installed harness and what it can do.",
            "properties": {
              "adapterVersion": {
                "description": "Driver version plus the detected harness CLI version.",
                "type": "string"
              },
              "caps": {
                "$ref": "#/$defs/ExecutorCaps",
                "description": "Declared capabilities."
              },
              "cliVerified": {
                "$ref": "#/$defs/VersionRange",
                "description": "Supported harness CLI versions."
              },
              "contractVersion": {
                "description": "Version of the Reno executor contract the adapter implements.",
                "format": "uint32",
                "minimum": 0,
                "type": "integer"
              },
              "id": {
                "$ref": "#/$defs/ExecutorId",
                "description": "Executor id, for example `claude-code`."
              }
            },
            "required": [
              "id",
              "contractVersion",
              "adapterVersion",
              "cliVerified",
              "caps"
            ],
            "type": "object"
          },
          "ExecutorHealth": {
            "description": "What the daemon last found out about one executor.",
            "properties": {
              "checkedAtMs": {
                "description": "When the probe finished, in milliseconds since the Unix epoch.",
                "format": "uint64",
                "minimum": 0,
                "type": "integer"
              },
              "installed": {
                "$ref": "#/$defs/InstallStatus",
                "description": "Whether and where the harness is installed."
              },
              "models": {
                "$ref": "#/$defs/ModelCatalog",
                "description": "The models on offer, and whether they came from the live harness or the adapter's list."
              },
              "signedIn": {
                "$ref": "#/$defs/SignedIn",
                "description": "Whether the harness is signed in."
              },
              "versionGate": {
                "$ref": "#/$defs/VersionGate",
                "description": "The installed version against the verified range."
              }
            },
            "required": [
              "installed",
              "versionGate",
              "signedIn",
              "models",
              "checkedAtMs"
            ],
            "type": "object"
          },
          "ExecutorId": {
            "pattern": "^[A-Za-z0-9._-]{1,64}$",
            "type": "string"
          },
          "ExecutorInfo": {
            "description": "One executor as `executor.list` shows it.",
            "properties": {
              "descriptor": {
                "$ref": "#/$defs/ExecutorDescriptor",
                "description": "What the executor declares it can do. Its `caps.models` is the list `health.models`\nlabels: the live list when a probe got one, else the curated list."
              },
              "health": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/ExecutorHealth"
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "The last probe. Absent until the first probe of this executor has finished."
              }
            },
            "required": [
              "descriptor"
            ],
            "type": "object"
          },
          "InstallStatus": {
            "description": "Whether the harness can be launched, and from where.",
            "oneOf": [
              {
                "description": "A launchable program was found.",
                "properties": {
                  "path": {
                    "description": "The program a run would launch.",
                    "type": "string"
                  },
                  "type": {
                    "const": "installed",
                    "type": "string"
                  },
                  "version": {
                    "description": "Its version, when it could be read.",
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                },
                "required": [
                  "type",
                  "path"
                ],
                "type": "object"
              },
              {
                "description": "Nothing launchable.",
                "properties": {
                  "type": {
                    "const": "not_installed",
                    "type": "string"
                  },
                  "why": {
                    "$ref": "#/$defs/NotInstalledReason",
                    "description": "Why."
                  }
                },
                "required": [
                  "type",
                  "why"
                ],
                "type": "object"
              }
            ]
          },
          "ModelCatalog": {
            "description": "The models an executor offers and where the list came from.",
            "properties": {
              "models": {
                "description": "The models.",
                "items": {
                  "$ref": "#/$defs/ModelInfo"
                },
                "type": "array"
              },
              "source": {
                "$ref": "#/$defs/ModelSource",
                "description": "Where the list came from."
              }
            },
            "required": [
              "source",
              "models"
            ],
            "type": "object"
          },
          "ModelInfo": {
            "description": "A model an executor offers.",
            "properties": {
              "displayName": {
                "description": "Display name.",
                "type": [
                  "string",
                  "null"
                ]
              },
              "id": {
                "description": "Model id as passed to the harness.",
                "type": "string"
              }
            },
            "required": [
              "id"
            ],
            "type": "object"
          },
          "ModelSource": {
            "description": "Where a list of models came from.",
            "oneOf": [
              {
                "const": "curated",
                "description": "The adapter's built-in list.",
                "type": "string"
              },
              {
                "const": "live",
                "description": "Asked of the live harness by the last probe.",
                "type": "string"
              }
            ]
          },
          "NotInstalledReason": {
            "description": "Why a harness cannot be launched.",
            "oneOf": [
              {
                "description": "No program was found where the driver looks.",
                "properties": {
                  "hint": {
                    "description": "Where it looks and how to get it, for a person.",
                    "type": "string"
                  },
                  "type": {
                    "const": "not_found",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "hint"
                ],
                "type": "object"
              },
              {
                "description": "The agent's launcher needs a managed install (an adapter package or a release archive)\nthat has not been done. A run never installs: this is an explicit step.",
                "properties": {
                  "type": {
                    "const": "needs_install",
                    "type": "string"
                  },
                  "what": {
                    "description": "What would be installed.",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "what"
                ],
                "type": "object"
              },
              {
                "description": "Something is there but cannot be launched (an override that points at nothing, a file\nthat is not executable).",
                "properties": {
                  "detail": {
                    "description": "What is wrong with it.",
                    "type": "string"
                  },
                  "type": {
                    "const": "unusable",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "detail"
                ],
                "type": "object"
              },
              {
                "description": "The probe itself failed, so nothing is known.",
                "properties": {
                  "detail": {
                    "description": "What happened.",
                    "type": "string"
                  },
                  "type": {
                    "const": "probe_failed",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "detail"
                ],
                "type": "object"
              }
            ]
          },
          "SandboxLevel": {
            "description": "The sandbox the harness itself enforces around its tools: a ceiling below the access mode.\nA run that asks for `ReadOnly` or `WorkspaceWrite` goes only to an executor that enforces that\nlevel; `Unrestricted` asks for no ceiling beyond the access mode, so every executor can take it.",
            "oneOf": [
              {
                "const": "read_only",
                "description": "No writes.",
                "type": "string"
              },
              {
                "const": "workspace_write",
                "description": "Writes confined to the workspace.",
                "type": "string"
              },
              {
                "const": "unrestricted",
                "description": "No sandbox ceiling beyond the access mode (and the run's worktree).",
                "type": "string"
              }
            ]
          },
          "SignedIn": {
            "description": "Whether the harness has a login.",
            "oneOf": [
              {
                "description": "A login exists.",
                "properties": {
                  "account": {
                    "description": "Who, when the harness says.",
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "type": {
                    "const": "yes",
                    "type": "string"
                  }
                },
                "required": [
                  "type"
                ],
                "type": "object"
              },
              {
                "description": "No login: not eligible.",
                "properties": {
                  "hint": {
                    "description": "What to do about it.",
                    "type": "string"
                  },
                  "type": {
                    "const": "no",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "hint"
                ],
                "type": "object"
              },
              {
                "description": "The harness offers no way to tell without running a model call. Stays eligible.",
                "properties": {
                  "type": {
                    "const": "unknown",
                    "type": "string"
                  }
                },
                "required": [
                  "type"
                ],
                "type": "object"
              }
            ]
          },
          "Steering": {
            "description": "When a running harness can accept a steering message.",
            "oneOf": [
              {
                "const": "none",
                "description": "Cannot be steered mid-run.",
                "type": "string"
              },
              {
                "const": "turn_boundary",
                "description": "Steering lands at the next turn.",
                "type": "string"
              },
              {
                "const": "step_boundary",
                "description": "Steering lands at the next step.",
                "type": "string"
              }
            ]
          },
          "VersionGate": {
            "description": "The installed version against the adapter's verified range.",
            "oneOf": [
              {
                "description": "At least the minimum, and no newer than the last version the adapter was verified on.",
                "properties": {
                  "type": {
                    "const": "ok",
                    "type": "string"
                  }
                },
                "required": [
                  "type"
                ],
                "type": "object"
              },
              {
                "description": "Older than the minimum the adapter supports: not eligible.",
                "properties": {
                  "min": {
                    "description": "The oldest supported version.",
                    "type": "string"
                  },
                  "type": {
                    "const": "too_old",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "min"
                ],
                "type": "object"
              },
              {
                "description": "Newer than the last version the adapter was verified on: eligible, but unproven.",
                "properties": {
                  "type": {
                    "const": "untested",
                    "type": "string"
                  },
                  "verified": {
                    "description": "The newest version the conformance suite passed on.",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "verified"
                ],
                "type": "object"
              },
              {
                "description": "There is no version to compare: not installed, or the CLI did not report one.",
                "properties": {
                  "type": {
                    "const": "unchecked",
                    "type": "string"
                  }
                },
                "required": [
                  "type"
                ],
                "type": "object"
              }
            ]
          },
          "VersionRange": {
            "description": "Harness CLI versions an adapter supports.",
            "properties": {
              "min": {
                "description": "Oldest supported version.",
                "type": "string"
              },
              "verified": {
                "description": "Newest version the conformance suite passed against.",
                "type": "string"
              }
            },
            "required": [
              "min",
              "verified"
            ],
            "type": "object"
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "description": "Result of `executor.list` and `executor.refresh`.",
        "properties": {
          "executors": {
            "description": "The executors, by id.",
            "items": {
              "$ref": "#/$defs/ExecutorInfo"
            },
            "type": "array"
          }
        },
        "required": [
          "executors"
        ],
        "title": "ExecutorListResult",
        "type": "object"
      }
    },
    {
      "name": "executor.refresh",
      "params": {
        "$defs": {
          "ExecutorId": {
            "pattern": "^[A-Za-z0-9._-]{1,64}$",
            "type": "string"
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "description": "Params of `executor.refresh`.",
        "properties": {
          "id": {
            "anyOf": [
              {
                "$ref": "#/$defs/ExecutorId"
              },
              {
                "type": "null"
              }
            ],
            "description": "The executor to probe again; every executor when absent."
          }
        },
        "title": "ExecutorRefreshParams",
        "type": "object"
      },
      "result": {
        "$defs": {
          "AccessMode": {
            "description": "How much a harness may do without asking. Never run with more than requested (ARCH-15).",
            "oneOf": [
              {
                "const": "supervised",
                "description": "Every consequential action needs approval.",
                "type": "string"
              },
              {
                "const": "auto_accept_edits",
                "description": "File edits proceed; commands and network still ask.",
                "type": "string"
              },
              {
                "const": "full_access",
                "description": "The harness asks nothing.",
                "type": "string"
              }
            ]
          },
          "ExecutorCaps": {
            "description": "What an executor declares it can do. Nothing is trusted beyond this (ARCH-15).",
            "properties": {
              "accessModes": {
                "description": "Access modes the executor can honour.",
                "items": {
                  "$ref": "#/$defs/AccessMode"
                },
                "type": "array"
              },
              "deterministicTurnEnd": {
                "description": "Whether the end of a turn is reported deterministically.",
                "type": "boolean"
              },
              "isolatesUserConfig": {
                "default": false,
                "description": "Whether a run is kept from loading the owner's personal configuration for that harness\n(its user-level settings, hooks, plugins, memory and instructions) unless the bot opts in\n(`inherit_user_config`). Only claimed where the driver enforces it; false means a run\nloads whatever the owner's own CLI would (ARCH-15).",
                "type": "boolean"
              },
              "mcpInjection": {
                "description": "False means it cannot join a team or use boards.",
                "type": "boolean"
              },
              "modelAliases": {
                "description": "Names the CLI accepts for a model besides the ids in `models`: short aliases that\nresolve on the CLI's side (`sonnet`, `opus`), so they are never reported as unknown.\nEmpty when the harness has none.",
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "models": {
                "description": "Models on offer.",
                "items": {
                  "$ref": "#/$defs/ModelInfo"
                },
                "type": "array"
              },
              "planMode": {
                "description": "Whether a plan mode exists.",
                "type": "boolean"
              },
              "resume": {
                "description": "Whether sessions can be resumed.",
                "type": "boolean"
              },
              "sandboxLevels": {
                "description": "Sandbox levels the executor can honour: a run is only started at a level listed here. An\nexecutor with no sandbox of its own honours only `Unrestricted`.",
                "items": {
                  "$ref": "#/$defs/SandboxLevel"
                },
                "type": "array"
              },
              "steering": {
                "$ref": "#/$defs/Steering",
                "description": "When steering messages can land."
              },
              "structuredOutput": {
                "description": "Whether `output_schema` is honoured.",
                "type": "boolean"
              }
            },
            "required": [
              "steering",
              "resume",
              "accessModes",
              "sandboxLevels",
              "mcpInjection",
              "structuredOutput",
              "deterministicTurnEnd",
              "planMode",
              "models"
            ],
            "type": "object"
          },
          "ExecutorDescriptor": {
            "description": "An installed harness and what it can do.",
            "properties": {
              "adapterVersion": {
                "description": "Driver version plus the detected harness CLI version.",
                "type": "string"
              },
              "caps": {
                "$ref": "#/$defs/ExecutorCaps",
                "description": "Declared capabilities."
              },
              "cliVerified": {
                "$ref": "#/$defs/VersionRange",
                "description": "Supported harness CLI versions."
              },
              "contractVersion": {
                "description": "Version of the Reno executor contract the adapter implements.",
                "format": "uint32",
                "minimum": 0,
                "type": "integer"
              },
              "id": {
                "$ref": "#/$defs/ExecutorId",
                "description": "Executor id, for example `claude-code`."
              }
            },
            "required": [
              "id",
              "contractVersion",
              "adapterVersion",
              "cliVerified",
              "caps"
            ],
            "type": "object"
          },
          "ExecutorHealth": {
            "description": "What the daemon last found out about one executor.",
            "properties": {
              "checkedAtMs": {
                "description": "When the probe finished, in milliseconds since the Unix epoch.",
                "format": "uint64",
                "minimum": 0,
                "type": "integer"
              },
              "installed": {
                "$ref": "#/$defs/InstallStatus",
                "description": "Whether and where the harness is installed."
              },
              "models": {
                "$ref": "#/$defs/ModelCatalog",
                "description": "The models on offer, and whether they came from the live harness or the adapter's list."
              },
              "signedIn": {
                "$ref": "#/$defs/SignedIn",
                "description": "Whether the harness is signed in."
              },
              "versionGate": {
                "$ref": "#/$defs/VersionGate",
                "description": "The installed version against the verified range."
              }
            },
            "required": [
              "installed",
              "versionGate",
              "signedIn",
              "models",
              "checkedAtMs"
            ],
            "type": "object"
          },
          "ExecutorId": {
            "pattern": "^[A-Za-z0-9._-]{1,64}$",
            "type": "string"
          },
          "ExecutorInfo": {
            "description": "One executor as `executor.list` shows it.",
            "properties": {
              "descriptor": {
                "$ref": "#/$defs/ExecutorDescriptor",
                "description": "What the executor declares it can do. Its `caps.models` is the list `health.models`\nlabels: the live list when a probe got one, else the curated list."
              },
              "health": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/ExecutorHealth"
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "The last probe. Absent until the first probe of this executor has finished."
              }
            },
            "required": [
              "descriptor"
            ],
            "type": "object"
          },
          "InstallStatus": {
            "description": "Whether the harness can be launched, and from where.",
            "oneOf": [
              {
                "description": "A launchable program was found.",
                "properties": {
                  "path": {
                    "description": "The program a run would launch.",
                    "type": "string"
                  },
                  "type": {
                    "const": "installed",
                    "type": "string"
                  },
                  "version": {
                    "description": "Its version, when it could be read.",
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                },
                "required": [
                  "type",
                  "path"
                ],
                "type": "object"
              },
              {
                "description": "Nothing launchable.",
                "properties": {
                  "type": {
                    "const": "not_installed",
                    "type": "string"
                  },
                  "why": {
                    "$ref": "#/$defs/NotInstalledReason",
                    "description": "Why."
                  }
                },
                "required": [
                  "type",
                  "why"
                ],
                "type": "object"
              }
            ]
          },
          "ModelCatalog": {
            "description": "The models an executor offers and where the list came from.",
            "properties": {
              "models": {
                "description": "The models.",
                "items": {
                  "$ref": "#/$defs/ModelInfo"
                },
                "type": "array"
              },
              "source": {
                "$ref": "#/$defs/ModelSource",
                "description": "Where the list came from."
              }
            },
            "required": [
              "source",
              "models"
            ],
            "type": "object"
          },
          "ModelInfo": {
            "description": "A model an executor offers.",
            "properties": {
              "displayName": {
                "description": "Display name.",
                "type": [
                  "string",
                  "null"
                ]
              },
              "id": {
                "description": "Model id as passed to the harness.",
                "type": "string"
              }
            },
            "required": [
              "id"
            ],
            "type": "object"
          },
          "ModelSource": {
            "description": "Where a list of models came from.",
            "oneOf": [
              {
                "const": "curated",
                "description": "The adapter's built-in list.",
                "type": "string"
              },
              {
                "const": "live",
                "description": "Asked of the live harness by the last probe.",
                "type": "string"
              }
            ]
          },
          "NotInstalledReason": {
            "description": "Why a harness cannot be launched.",
            "oneOf": [
              {
                "description": "No program was found where the driver looks.",
                "properties": {
                  "hint": {
                    "description": "Where it looks and how to get it, for a person.",
                    "type": "string"
                  },
                  "type": {
                    "const": "not_found",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "hint"
                ],
                "type": "object"
              },
              {
                "description": "The agent's launcher needs a managed install (an adapter package or a release archive)\nthat has not been done. A run never installs: this is an explicit step.",
                "properties": {
                  "type": {
                    "const": "needs_install",
                    "type": "string"
                  },
                  "what": {
                    "description": "What would be installed.",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "what"
                ],
                "type": "object"
              },
              {
                "description": "Something is there but cannot be launched (an override that points at nothing, a file\nthat is not executable).",
                "properties": {
                  "detail": {
                    "description": "What is wrong with it.",
                    "type": "string"
                  },
                  "type": {
                    "const": "unusable",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "detail"
                ],
                "type": "object"
              },
              {
                "description": "The probe itself failed, so nothing is known.",
                "properties": {
                  "detail": {
                    "description": "What happened.",
                    "type": "string"
                  },
                  "type": {
                    "const": "probe_failed",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "detail"
                ],
                "type": "object"
              }
            ]
          },
          "SandboxLevel": {
            "description": "The sandbox the harness itself enforces around its tools: a ceiling below the access mode.\nA run that asks for `ReadOnly` or `WorkspaceWrite` goes only to an executor that enforces that\nlevel; `Unrestricted` asks for no ceiling beyond the access mode, so every executor can take it.",
            "oneOf": [
              {
                "const": "read_only",
                "description": "No writes.",
                "type": "string"
              },
              {
                "const": "workspace_write",
                "description": "Writes confined to the workspace.",
                "type": "string"
              },
              {
                "const": "unrestricted",
                "description": "No sandbox ceiling beyond the access mode (and the run's worktree).",
                "type": "string"
              }
            ]
          },
          "SignedIn": {
            "description": "Whether the harness has a login.",
            "oneOf": [
              {
                "description": "A login exists.",
                "properties": {
                  "account": {
                    "description": "Who, when the harness says.",
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "type": {
                    "const": "yes",
                    "type": "string"
                  }
                },
                "required": [
                  "type"
                ],
                "type": "object"
              },
              {
                "description": "No login: not eligible.",
                "properties": {
                  "hint": {
                    "description": "What to do about it.",
                    "type": "string"
                  },
                  "type": {
                    "const": "no",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "hint"
                ],
                "type": "object"
              },
              {
                "description": "The harness offers no way to tell without running a model call. Stays eligible.",
                "properties": {
                  "type": {
                    "const": "unknown",
                    "type": "string"
                  }
                },
                "required": [
                  "type"
                ],
                "type": "object"
              }
            ]
          },
          "Steering": {
            "description": "When a running harness can accept a steering message.",
            "oneOf": [
              {
                "const": "none",
                "description": "Cannot be steered mid-run.",
                "type": "string"
              },
              {
                "const": "turn_boundary",
                "description": "Steering lands at the next turn.",
                "type": "string"
              },
              {
                "const": "step_boundary",
                "description": "Steering lands at the next step.",
                "type": "string"
              }
            ]
          },
          "VersionGate": {
            "description": "The installed version against the adapter's verified range.",
            "oneOf": [
              {
                "description": "At least the minimum, and no newer than the last version the adapter was verified on.",
                "properties": {
                  "type": {
                    "const": "ok",
                    "type": "string"
                  }
                },
                "required": [
                  "type"
                ],
                "type": "object"
              },
              {
                "description": "Older than the minimum the adapter supports: not eligible.",
                "properties": {
                  "min": {
                    "description": "The oldest supported version.",
                    "type": "string"
                  },
                  "type": {
                    "const": "too_old",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "min"
                ],
                "type": "object"
              },
              {
                "description": "Newer than the last version the adapter was verified on: eligible, but unproven.",
                "properties": {
                  "type": {
                    "const": "untested",
                    "type": "string"
                  },
                  "verified": {
                    "description": "The newest version the conformance suite passed on.",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "verified"
                ],
                "type": "object"
              },
              {
                "description": "There is no version to compare: not installed, or the CLI did not report one.",
                "properties": {
                  "type": {
                    "const": "unchecked",
                    "type": "string"
                  }
                },
                "required": [
                  "type"
                ],
                "type": "object"
              }
            ]
          },
          "VersionRange": {
            "description": "Harness CLI versions an adapter supports.",
            "properties": {
              "min": {
                "description": "Oldest supported version.",
                "type": "string"
              },
              "verified": {
                "description": "Newest version the conformance suite passed against.",
                "type": "string"
              }
            },
            "required": [
              "min",
              "verified"
            ],
            "type": "object"
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "description": "Result of `executor.list` and `executor.refresh`.",
        "properties": {
          "executors": {
            "description": "The executors, by id.",
            "items": {
              "$ref": "#/$defs/ExecutorInfo"
            },
            "type": "array"
          }
        },
        "required": [
          "executors"
        ],
        "title": "ExecutorListResult",
        "type": "object"
      }
    },
    {
      "name": "executor.install",
      "params": {
        "$defs": {
          "ExecutorId": {
            "pattern": "^[A-Za-z0-9._-]{1,64}$",
            "type": "string"
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "description": "Params of `executor.install`.",
        "properties": {
          "id": {
            "$ref": "#/$defs/ExecutorId",
            "description": "The executor whose managed adapter or release archive is to be fetched and verified. Its\nlast probe must say `needs_install`."
          }
        },
        "required": [
          "id"
        ],
        "title": "ExecutorInstallParams",
        "type": "object"
      },
      "result": {
        "$defs": {
          "AccessMode": {
            "description": "How much a harness may do without asking. Never run with more than requested (ARCH-15).",
            "oneOf": [
              {
                "const": "supervised",
                "description": "Every consequential action needs approval.",
                "type": "string"
              },
              {
                "const": "auto_accept_edits",
                "description": "File edits proceed; commands and network still ask.",
                "type": "string"
              },
              {
                "const": "full_access",
                "description": "The harness asks nothing.",
                "type": "string"
              }
            ]
          },
          "ExecutorCaps": {
            "description": "What an executor declares it can do. Nothing is trusted beyond this (ARCH-15).",
            "properties": {
              "accessModes": {
                "description": "Access modes the executor can honour.",
                "items": {
                  "$ref": "#/$defs/AccessMode"
                },
                "type": "array"
              },
              "deterministicTurnEnd": {
                "description": "Whether the end of a turn is reported deterministically.",
                "type": "boolean"
              },
              "isolatesUserConfig": {
                "default": false,
                "description": "Whether a run is kept from loading the owner's personal configuration for that harness\n(its user-level settings, hooks, plugins, memory and instructions) unless the bot opts in\n(`inherit_user_config`). Only claimed where the driver enforces it; false means a run\nloads whatever the owner's own CLI would (ARCH-15).",
                "type": "boolean"
              },
              "mcpInjection": {
                "description": "False means it cannot join a team or use boards.",
                "type": "boolean"
              },
              "modelAliases": {
                "description": "Names the CLI accepts for a model besides the ids in `models`: short aliases that\nresolve on the CLI's side (`sonnet`, `opus`), so they are never reported as unknown.\nEmpty when the harness has none.",
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "models": {
                "description": "Models on offer.",
                "items": {
                  "$ref": "#/$defs/ModelInfo"
                },
                "type": "array"
              },
              "planMode": {
                "description": "Whether a plan mode exists.",
                "type": "boolean"
              },
              "resume": {
                "description": "Whether sessions can be resumed.",
                "type": "boolean"
              },
              "sandboxLevels": {
                "description": "Sandbox levels the executor can honour: a run is only started at a level listed here. An\nexecutor with no sandbox of its own honours only `Unrestricted`.",
                "items": {
                  "$ref": "#/$defs/SandboxLevel"
                },
                "type": "array"
              },
              "steering": {
                "$ref": "#/$defs/Steering",
                "description": "When steering messages can land."
              },
              "structuredOutput": {
                "description": "Whether `output_schema` is honoured.",
                "type": "boolean"
              }
            },
            "required": [
              "steering",
              "resume",
              "accessModes",
              "sandboxLevels",
              "mcpInjection",
              "structuredOutput",
              "deterministicTurnEnd",
              "planMode",
              "models"
            ],
            "type": "object"
          },
          "ExecutorDescriptor": {
            "description": "An installed harness and what it can do.",
            "properties": {
              "adapterVersion": {
                "description": "Driver version plus the detected harness CLI version.",
                "type": "string"
              },
              "caps": {
                "$ref": "#/$defs/ExecutorCaps",
                "description": "Declared capabilities."
              },
              "cliVerified": {
                "$ref": "#/$defs/VersionRange",
                "description": "Supported harness CLI versions."
              },
              "contractVersion": {
                "description": "Version of the Reno executor contract the adapter implements.",
                "format": "uint32",
                "minimum": 0,
                "type": "integer"
              },
              "id": {
                "$ref": "#/$defs/ExecutorId",
                "description": "Executor id, for example `claude-code`."
              }
            },
            "required": [
              "id",
              "contractVersion",
              "adapterVersion",
              "cliVerified",
              "caps"
            ],
            "type": "object"
          },
          "ExecutorHealth": {
            "description": "What the daemon last found out about one executor.",
            "properties": {
              "checkedAtMs": {
                "description": "When the probe finished, in milliseconds since the Unix epoch.",
                "format": "uint64",
                "minimum": 0,
                "type": "integer"
              },
              "installed": {
                "$ref": "#/$defs/InstallStatus",
                "description": "Whether and where the harness is installed."
              },
              "models": {
                "$ref": "#/$defs/ModelCatalog",
                "description": "The models on offer, and whether they came from the live harness or the adapter's list."
              },
