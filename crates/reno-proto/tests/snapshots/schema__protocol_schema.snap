    {
      "name": "run.cancel",
      "params": {
        "$defs": {
          "RunId": {
            "pattern": "^run_[A-Za-z0-9]{1,64}$",
            "type": "string"
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "description": "Params of `run.cancel`.",
        "properties": {
          "reason": {
            "description": "Why, for the audit trail.",
            "type": [
              "string",
              "null"
            ]
          },
          "runId": {
            "$ref": "#/$defs/RunId",
