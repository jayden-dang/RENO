    {
      "name": "approval.list",
      "params": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "description": "Empty params: serialises as `{}`.",
        "title": "NoParams",
        "type": "object"
      },
      "result": {
        "$defs": {
          "ActionClass": {
            "description": "What kind of action an approval is about.",
            "oneOf": [
              {
                "const": "read",
                "description": "Reading files.",
                "type": "string"
              },
              {
                "const": "edit",
                "description": "Editing files.",
                "type": "string"
              },
              {
                "const": "command",
                "description": "Running a command.",
                "type": "string"
              },
              {
                "const": "network",
                "description": "Network access.",
                "type": "string"
              },
              {
                "const": "mcp_tool",
                "description": "An MCP tool call.",
                "type": "string"
              },
              {
                "const": "other",
                "description": "Anything else.",
                "type": "string"
              }
            ]
          },
          "Approval": {
            "description": "An action a harness is held on, waiting for a human decision.",
            "properties": {
              "id": {
                "$ref": "#/$defs/ApprovalId",
                "description": "The approval, as `approval.decide` refers to it."
              },
              "requestedAtMs": {
                "description": "When the action was held, in milliseconds since the Unix epoch.",
                "format": "uint64",
                "minimum": 0,
                "type": "integer"
              },
              "runId": {
                "$ref": "#/$defs/RunId",
                "description": "The run that is held."
              },
              "subject": {
                "$ref": "#/$defs/ApprovalSubject",
                "description": "Exactly what is being approved."
              }
            },
            "required": [
              "id",
              "runId",
              "subject",
              "requestedAtMs"
            ],
            "type": "object"
          },
          "ApprovalId": {
            "pattern": "^appr_[A-Za-z0-9]{1,64}$",
            "type": "string"
          },
          "ApprovalSubject": {
            "description": "The exact thing a human is asked to approve.",
            "properties": {
              "action": {
                "$ref": "#/$defs/ActionClass",
                "description": "Class of the action."
              },
              "command": {
                "description": "The command line, for command actions.",
                "type": [
                  "string",
                  "null"
                ]
              },
              "paths": {
                "default": [],
                "description": "Paths the action touches.",
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "raw": {
                "default": null,
                "description": "The harness's own request, kept for the audit record."
              },
              "tool": {
                "description": "Tool the action goes through.",
                "type": "string"
              }
            },
            "required": [
              "action",
              "tool"
            ],
            "type": "object"
          },
          "RunId": {
            "pattern": "^run_[A-Za-z0-9]{1,64}$",
            "type": "string"
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "description": "Result of `approval.list`.",
        "properties": {
          "approvals": {
            "description": "Pending approvals, oldest first.",
            "items": {
              "$ref": "#/$defs/Approval"
            },
            "type": "array"
          }
        },
        "required": [
          "approvals"
        ],
        "title": "ApprovalListResult",
        "type": "object"
      }
    },
    {
      "name": "approval.decide",
      "params": {
        "$defs": {
          "ApprovalDecision": {
            "description": "A human's answer to an [`Approval`].",
            "oneOf": [
              {
                "const": "approve_once",
                "description": "Allow this one action; the next similar action asks again.",
                "type": "string"
              },
              {
                "const": "deny",
                "description": "Refuse the action.",
                "type": "string"
              }
            ]
          },
          "ApprovalId": {
            "pattern": "^appr_[A-Za-z0-9]{1,64}$",
            "type": "string"
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "description": "Params of `approval.decide`.",
        "properties": {
          "approvalId": {
            "$ref": "#/$defs/ApprovalId",
            "description": "The approval to answer."
          },
          "decision": {
            "$ref": "#/$defs/ApprovalDecision",
            "description": "The answer."
          },
          "message": {
            "description": "Why, for a denial: it reaches the harness (as a rule's message does), is journalled in\n`ApprovalResolved.message` and shows in `approval.history`. Refused with an approval.\nAt most [`APPROVAL_MESSAGE_MAX_CHARS`] characters; blank counts as absent. Needs feature\n`approval.message`.",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "approvalId",
          "decision"
        ],
        "title": "ApprovalDecideParams",
        "type": "object"
      },
      "result": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "description": "Result of `approval.decide`: empty.",
        "title": "ApprovalDecideResult",
        "type": "object"
      }
    },
    {
      "name": "approval.history",
      "params": {
        "$defs": {
          "RunId": {
            "pattern": "^run_[A-Za-z0-9]{1,64}$",
            "type": "string"
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "description": "Params of `approval.history`.",
        "properties": {
          "limit": {
            "description": "Most records, newest decision first. Defaults to [`APPROVAL_HISTORY_DEFAULT_LIMIT`] and\nis cut to [`APPROVAL_HISTORY_MAX_LIMIT`].",
            "format": "uint32",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "run": {
            "anyOf": [
              {
                "$ref": "#/$defs/RunId"
              },
              {
                "type": "null"
              }
            ],
            "description": "Only this run's approvals; every run's when absent."
          }
        },
        "title": "ApprovalHistoryParams",
        "type": "object"
      },
      "result": {
        "$defs": {
          "ActionClass": {
            "description": "What kind of action an approval is about.",
            "oneOf": [
              {
                "const": "read",
                "description": "Reading files.",
                "type": "string"
              },
              {
                "const": "edit",
                "description": "Editing files.",
                "type": "string"
              },
              {
                "const": "command",
                "description": "Running a command.",
                "type": "string"
              },
              {
                "const": "network",
                "description": "Network access.",
                "type": "string"
              },
              {
                "const": "mcp_tool",
                "description": "An MCP tool call.",
                "type": "string"
              },
              {
                "const": "other",
                "description": "Anything else.",
                "type": "string"
              }
            ]
          },
          "ApprovalId": {
            "pattern": "^appr_[A-Za-z0-9]{1,64}$",
            "type": "string"
          },
          "ApprovalRecord": {
            "description": "The stored record of one approval request: what was asked, and how it was resolved.",
            "properties": {
              "createdAtMs": {
                "description": "When it was raised, in milliseconds since the Unix epoch.",
                "format": "uint64",
                "minimum": 0,
                "type": "integer"
              },
              "decidedAtMs": {
                "description": "When it was decided. Absent while pending.",
                "format": "uint64",
                "minimum": 0,
                "type": [
                  "integer",
                  "null"
                ]
              },
              "decidedBy": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/ResolvedBy"
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "Who or what decided. Absent while the approval is pending."
              },
              "expiresAtMs": {
                "description": "The deadline after which an undecided approval is denied as expired.",
                "format": "uint64",
                "minimum": 0,
                "type": "integer"
              },
              "id": {
                "$ref": "#/$defs/ApprovalId",
                "description": "The approval's id."
              },
              "message": {
                "description": "The reason a human gave with a denial. Only daemons that negotiate `approval.message`\nfill it.",
                "type": [
                  "string",
                  "null"
                ]
              },
              "requestId": {
                "description": "The harness's id for the request (the `requestId` of the `NeedsApproval` event).",
                "type": "string"
              },
              "runId": {
                "$ref": "#/$defs/RunId",
                "description": "The run that raised it."
              },
              "status": {
                "$ref": "#/$defs/ApprovalStatus",
                "description": "Where it stands."
              },
              "subject": {
                "$ref": "#/$defs/ApprovalSubject",
                "description": "Exactly what was asked."
              }
            },
            "required": [
              "id",
              "runId",
              "requestId",
              "subject",
              "status",
              "createdAtMs",
              "expiresAtMs"
            ],
            "type": "object"
          },
          "ApprovalStatus": {
            "description": "Where an approval record stands.",
            "oneOf": [
              {
                "const": "pending",
                "description": "Waiting for a human.",
                "type": "string"
              },
              {
                "const": "approved",
                "description": "The harness was told yes.",
                "type": "string"
              },
              {
                "const": "denied",
                "description": "The harness was told no.",
                "type": "string"
              },
              {
                "const": "expired",
                "description": "Nobody decided in time, or the run ended or the daemon restarted first. The harness, if\nit was still there, was told no.",
                "type": "string"
              }
            ]
          },
          "ApprovalSubject": {
            "description": "The exact thing a human is asked to approve.",
            "properties": {
              "action": {
                "$ref": "#/$defs/ActionClass",
                "description": "Class of the action."
              },
              "command": {
                "description": "The command line, for command actions.",
                "type": [
                  "string",
                  "null"
                ]
              },
              "paths": {
                "default": [],
                "description": "Paths the action touches.",
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "raw": {
                "default": null,
                "description": "The harness's own request, kept for the audit record."
              },
              "tool": {
                "description": "Tool the action goes through.",
                "type": "string"
              }
            },
            "required": [
              "action",
              "tool"
            ],
            "type": "object"
          },
          "ResolvedBy": {
            "description": "Who or what resolved an approval request, and so why the transcript shows the outcome it\ndoes.",
            "oneOf": [
              {
                "description": "A person decided it.",
                "properties": {
                  "type": {
                    "const": "human",
                    "type": "string"
                  }
                },
                "required": [
                  "type"
                ],
                "type": "object"
              },
              {
                "description": "A rule of the policy decided it, with no question asked. `name` is the rule's `note`, or\n`rules[N]` when it has none, or `default` when no rule matched and the policy's default\neffect applied.",
                "properties": {
                  "name": {
                    "description": "The rule's name.",
                    "type": "string"
                  },
                  "type": {
                    "const": "rule",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "name"
                ],
                "type": "object"
              },
              {
                "description": "Nobody decided before the approval's time limit, or the run ended or the daemon\nrestarted first. Always an outcome of `denied`.",
                "properties": {
                  "type": {
                    "const": "expired",
                    "type": "string"
                  }
                },
                "required": [
                  "type"
                ],
                "type": "object"
              },
              {
                "description": "The same action was denied earlier in this run, so it was denied again unasked.",
                "properties": {
                  "type": {
                    "const": "repeat_denial",
                    "type": "string"
                  }
                },
                "required": [
                  "type"
                ],
                "type": "object"
              }
            ]
          },
          "RunId": {
            "pattern": "^run_[A-Za-z0-9]{1,64}$",
            "type": "string"
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "description": "Result of `approval.history`.",
        "properties": {
          "approvals": {
            "description": "Decided approvals (never pending ones), newest decision first.",
            "items": {
              "$ref": "#/$defs/ApprovalRecord"
            },
            "type": "array"
          }
        },
        "required": [
          "approvals"
        ],
        "title": "ApprovalHistoryResult",
        "type": "object"
      }
    },
    {
      "name": "def.list",
      "params": {
        "$defs": {
          "DefKind": {
            "description": "The kinds of definition this version loads. Teams and flows join with their tasks.",
            "oneOf": [
              {
                "const": "bot",
                "description": "A bot: `bots/<name>.toml`.",
                "type": "string"
              },
              {
                "const": "trigger",
                "description": "A trigger: `triggers/<name>.toml`.",
                "type": "string"
              },
              {
                "const": "policy",
                "description": "The policy: `policy.toml`.",
                "type": "string"
              }
            ]
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "description": "Params of `def.list`.",
        "properties": {
          "kind": {
            "anyOf": [
              {
                "$ref": "#/$defs/DefKind"
              },
              {
                "type": "null"
              }
            ],
            "description": "Only this kind; all kinds when absent."
          }
        },
        "title": "DefListParams",
        "type": "object"
      },
      "result": {
        "$defs": {
          "DefError": {
            "description": "One problem with a definition, located by file and by a path inside it.\n\nDisplays as `bots/keeper.toml: executors[2]: unknown executor \"x\"`. A problem with the file\nas a whole has an empty `path` and displays as `bots/keeper.toml: <message>`.",
            "properties": {
              "file": {
                "description": "The file, relative to the definitions root.",
                "type": "string"
              },
              "message": {
                "description": "What is wrong, for a person.",
                "type": "string"
              },
              "path": {
                "description": "The field inside it, such as `executors[2]` or `target.bot`; empty for the whole file.",
                "type": "string"
              }
            },
            "required": [
              "file",
              "message"
            ],
            "type": "object"
          },
          "DefKind": {
            "description": "The kinds of definition this version loads. Teams and flows join with their tasks.",
            "oneOf": [
              {
                "const": "bot",
                "description": "A bot: `bots/<name>.toml`.",
                "type": "string"
              },
              {
                "const": "trigger",
                "description": "A trigger: `triggers/<name>.toml`.",
                "type": "string"
              },
              {
                "const": "policy",
                "description": "The policy: `policy.toml`.",
                "type": "string"
              }
            ]
          },
          "DefSummary": {
            "description": "One stored version of one definition, without its body.",
            "properties": {
              "createdAtMs": {
                "description": "When this version was first stored, in milliseconds since the Unix epoch.",
                "format": "uint64",
                "minimum": 0,
                "type": "integer"
              },
              "hash": {
                "description": "The content hash of the version: 64 lowercase hex digits.",
                "type": "string"
              },
              "kind": {
                "$ref": "#/$defs/DefKind",
                "description": "The kind."
              },
              "name": {
                "description": "The name; `policy` for the policy.",
                "type": "string"
              },
              "version": {
                "description": "The version, counted from 1 per name.",
                "format": "uint32",
                "minimum": 0,
                "type": "integer"
              }
            },
            "required": [
              "kind",
              "name",
              "version",
              "hash",
              "createdAtMs"
            ],
            "type": "object"
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "description": "The current definitions and the problems with the files, as the daemon holds them.\n\nWhen `errors` is not empty the files on disk do not validate, and `defs` is the last set that\ndid: the daemon keeps running on it until the files are fixed.",
        "properties": {
          "defs": {
            "description": "The current version of every definition, by kind and then name.",
            "items": {
              "$ref": "#/$defs/DefSummary"
            },
            "type": "array"
          },
          "errors": {
            "default": [],
            "description": "Every problem found in the last load; empty when the files are valid.",
            "items": {
              "$ref": "#/$defs/DefError"
            },
            "type": "array"
          }
        },
        "required": [
          "defs"
        ],
        "title": "DefsSnapshot",
        "type": "object"
      }
    },
    {
      "name": "def.get",
      "params": {
        "$defs": {
          "DefKind": {
            "description": "The kinds of definition this version loads. Teams and flows join with their tasks.",
            "oneOf": [
              {
                "const": "bot",
                "description": "A bot: `bots/<name>.toml`.",
                "type": "string"
              },
              {
                "const": "trigger",
                "description": "A trigger: `triggers/<name>.toml`.",
                "type": "string"
              },
              {
                "const": "policy",
                "description": "The policy: `policy.toml`.",
                "type": "string"
              }
            ]
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "description": "Params of `def.get`.",
        "properties": {
          "kind": {
            "$ref": "#/$defs/DefKind",
            "description": "The kind."
          },
          "name": {
            "description": "The name; `policy` for the policy.",
            "type": "string"
          },
          "version": {
            "description": "The version; the newest when absent.",
            "format": "uint32",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          }
        },
        "required": [
          "kind",
          "name"
        ],
        "title": "DefGetParams",
        "type": "object"
      },
      "result": {
        "$defs": {
          "DefKind": {
            "description": "The kinds of definition this version loads. Teams and flows join with their tasks.",
            "oneOf": [
              {
                "const": "bot",
                "description": "A bot: `bots/<name>.toml`.",
                "type": "string"
              },
              {
                "const": "trigger",
                "description": "A trigger: `triggers/<name>.toml`.",
                "type": "string"
              },
              {
                "const": "policy",
                "description": "The policy: `policy.toml`.",
                "type": "string"
              }
            ]
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "description": "Result of `def.get`: one version with its body.",
        "properties": {
          "body": {
            "description": "The definition, in the shape of its file."
          },
          "createdAtMs": {
            "description": "When this version was first stored, in milliseconds since the Unix epoch.",
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "hash": {
            "description": "The content hash.",
            "type": "string"
          },
          "kind": {
            "$ref": "#/$defs/DefKind",
            "description": "The kind."
          },
          "latest": {
            "description": "Whether this is the newest stored version of the name.",
            "type": "boolean"
          },
          "name": {
            "description": "The name.",
            "type": "string"
          },
          "version": {
            "description": "The version.",
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "kind",
          "name",
          "version",
          "hash",
          "body",
          "createdAtMs",
          "latest"
        ],
        "title": "DefRecord",
        "type": "object"
      }
    },
    {
      "name": "def.validate",
      "params": {
        "$defs": {
          "DefKind": {
            "description": "The kinds of definition this version loads. Teams and flows join with their tasks.",
            "oneOf": [
              {
                "const": "bot",
                "description": "A bot: `bots/<name>.toml`.",
                "type": "string"
              },
              {
                "const": "trigger",
                "description": "A trigger: `triggers/<name>.toml`.",
                "type": "string"
              },
              {
                "const": "policy",
                "description": "The policy: `policy.toml`.",
                "type": "string"
              }
            ]
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "description": "Params of `def.validate`.",
        "properties": {
          "body": {
            "description": "The definition, in the shape of its file."
          },
          "kind": {
            "$ref": "#/$defs/DefKind",
            "description": "The kind."
          },
          "name": {
            "description": "The name the body would be saved under: the file stem.",
            "type": "string"
          }
        },
        "required": [
          "kind",
          "name",
          "body"
        ],
        "title": "DefValidateParams",
        "type": "object"
      },
      "result": {
        "$defs": {
          "DefError": {
            "description": "One problem with a definition, located by file and by a path inside it.\n\nDisplays as `bots/keeper.toml: executors[2]: unknown executor \"x\"`. A problem with the file\nas a whole has an empty `path` and displays as `bots/keeper.toml: <message>`.",
            "properties": {
              "file": {
                "description": "The file, relative to the definitions root.",
                "type": "string"
              },
              "message": {
                "description": "What is wrong, for a person.",
                "type": "string"
              },
              "path": {
                "description": "The field inside it, such as `executors[2]` or `target.bot`; empty for the whole file.",
                "type": "string"
              }
            },
            "required": [
              "file",
              "message"
            ],
            "type": "object"
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "description": "Result of `def.validate`.",
        "properties": {
          "errors": {
            "description": "Every problem found; empty when `valid`.",
            "items": {
              "$ref": "#/$defs/DefError"
            },
            "type": "array"
          },
          "hash": {
            "description": "The content hash the body would have, when valid.",
            "type": [
              "string",
              "null"
            ]
          },
          "valid": {
            "description": "Whether the body passes every rule, in the context of the current definitions.",
            "type": "boolean"
          }
        },
        "required": [
          "valid",
          "errors"
        ],
        "title": "DefValidateResult",
        "type": "object"
      }
    },
    {
      "name": "trigger.list",
      "params": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "description": "Empty params: serialises as `{}`.",
        "title": "NoParams",
        "type": "object"
      },
      "result": {
        "$defs": {
          "RunId": {
            "pattern": "^run_[A-Za-z0-9]{1,64}$",
            "type": "string"
          },
          "TriggerInfo": {
            "description": "One trigger and its state.",
            "properties": {
              "backoffUntilMs": {
                "description": "Until when it is backed off.",
                "format": "uint64",
                "minimum": 0,
                "type": [
                  "integer",
                  "null"
                ]
              },
              "bot": {
                "description": "The bot it starts.",
                "type": "string"
              },
              "error": {
                "description": "Why it cannot run, when `status` is `failed`.",
                "type": [
                  "string",
                  "null"
                ]
              },
              "failures": {
                "description": "Consecutive account-level failures to start; `0` when healthy.",
                "format": "uint32",
                "minimum": 0,
                "type": "integer"
              },
              "kind": {
                "description": "The `kind` of its `when`: `at`, `after`, `every`, `cron`, `fs` or `manual`.",
                "type": "string"
              },
              "lastFiredAtMs": {
                "description": "When it last started a run (or merged into one).",
                "format": "uint64",
                "minimum": 0,
                "type": [
                  "integer",
                  "null"
                ]
              },
              "lastRunId": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/RunId"
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "The run it last started."
              },
              "name": {
                "description": "The trigger's name.",
                "type": "string"
              },
              "nextDueAtMs": {
                "description": "When it fires next. Absent for `fs`, `manual`, a finished one-shot and a disabled trigger.",
                "format": "uint64",
                "minimum": 0,
                "type": [
                  "integer",
                  "null"
                ]
              },
              "status": {
                "$ref": "#/$defs/TriggerStatus",
                "description": "Where it stands."
              },
              "version": {
                "description": "The version of the definition in force.",
                "format": "uint32",
                "minimum": 0,
                "type": "integer"
              }
            },
            "required": [
              "name",
              "kind",
              "bot",
              "version",
              "status",
              "failures"
            ],
            "type": "object"
          },
          "TriggerStatus": {
            "description": "Where a trigger stands.",
            "oneOf": [
              {
                "const": "scheduled",
                "description": "Waiting for its next due time (`nextDueAtMs`).",
                "type": "string"
              },
              {
                "const": "watching",
                "description": "Watching files (`fs`).",
                "type": "string"
              },
              {
                "const": "manual",
                "description": "Fires only when asked (`manual`).",
                "type": "string"
              },
              {
                "const": "done",
                "description": "A one-shot (`at`, `after`) that has fired.",
                "type": "string"
              },
              {
                "const": "backed_off",
                "description": "Backed off after repeated failures to start; fires again at `backoffUntilMs`.",
                "type": "string"
              },
              {
                "const": "disabled",
                "description": "Disabled in its definition.",
                "type": "string"
              },
              {
                "const": "failed",
                "description": "Cannot run: see `error`.",
                "type": "string"
              }
            ]
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "description": "Result of `trigger.list`.",
        "properties": {
          "triggers": {
            "description": "Every trigger in the definitions in force, by name.",
            "items": {
              "$ref": "#/$defs/TriggerInfo"
            },
            "type": "array"
          }
        },
        "required": [
          "triggers"
        ],
        "title": "TriggerListResult",
        "type": "object"
      }
    },
    {
      "name": "trigger.fire",
      "params": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "description": "Params of `trigger.fire`.",
        "properties": {
          "name": {
            "description": "The trigger to fire now. A `manual` trigger or any enabled one.",
            "type": "string"
          }
        },
        "required": [
          "name"
        ],
        "title": "TriggerFireParams",
        "type": "object"
      },
      "result": {
        "$defs": {
          "FiringOutcome": {
            "description": "What became of one occurrence of a trigger.",
            "oneOf": [
              {
                "const": "fired",
                "description": "A run was started for it.",
                "type": "string"
              },
              {
                "const": "coalesced",
                "description": "The trigger's previous run is still going, so no run was started: the occurrence is\nmerged into that run.",
                "type": "string"
              },
              {
                "const": "duplicate",
                "description": "This occurrence had already been fired (its nonce exists), so nothing was done. Returned\nby `trigger.fire`; never stored, because the nonce is unique.",
                "type": "string"
              },
              {
                "const": "backed_off",
                "description": "The run it started could not start for an account-level reason (not installed, not\nsigned in, no eligible executor), and the trigger was backed off.",
                "type": "string"
              }
            ]
          },
          "RunId": {
            "pattern": "^run_[A-Za-z0-9]{1,64}$",
            "type": "string"
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "description": "Result of `trigger.fire`.",
        "properties": {
          "outcome": {
            "$ref": "#/$defs/FiringOutcome",
            "description": "What became of it."
          },
          "runId": {
            "anyOf": [
              {
                "$ref": "#/$defs/RunId"
              },
              {
                "type": "null"
              }
            ],
            "description": "The run started, or, for `coalesced`, the run it was merged into."
          },
          "scheduledAtMs": {
            "description": "The occurrence it fired for.",
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "outcome",
          "scheduledAtMs"
        ],
        "title": "TriggerFireResult",
        "type": "object"
      }
    },
    {
      "name": "workspace.list",
      "params": {
        "$defs": {
          "WorkspaceStatus": {
            "description": "Where a workspace stands.",
            "oneOf": [
              {
                "const": "preparing",
                "description": "Recorded, and being created. A workspace found in this state at start-up is a crash\nleftover and is reconciled.",
                "type": "string"
              },
              {
                "const": "active",
                "description": "Created, and its run has not ended (or may be resumed).",
                "type": "string"
              },
              {
                "const": "kept",
                "description": "Its run ended and it holds commits or uncommitted changes, so the worktree and the branch\nare kept for a later integration step.",
                "type": "string"
              },
              {
                "const": "removed",
                "description": "Its worktree and branch were removed.",
                "type": "string"
              },
              {
                "const": "lost",
                "description": "Its directory vanished and was pruned; the branch may remain.",
                "type": "string"
              }
            ]
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "description": "Params of `workspace.list`.",
        "properties": {
          "status": {
            "description": "Only workspaces in one of these statuses; every workspace when absent.",
            "items": {
              "$ref": "#/$defs/WorkspaceStatus"
            },
            "type": [
              "array",
              "null"
            ]
          }
        },
        "title": "WorkspaceListParams",
        "type": "object"
      },
      "result": {
        "$defs": {
          "RunId": {
            "pattern": "^run_[A-Za-z0-9]{1,64}$",
            "type": "string"
          },
          "WorkspaceChanges": {
            "description": "What a workspace holds beyond its base commit.",
            "properties": {
              "commits": {
                "description": "Commits on the branch that its base commit does not have.",
                "format": "uint32",
                "minimum": 0,
                "type": "integer"
              },
              "dirty": {
                "description": "Whether the worktree has uncommitted changes or untracked files.",
                "type": "boolean"
              }
            },
            "required": [
              "commits",
              "dirty"
            ],
            "type": "object"
          },
          "WorkspaceInfo": {
            "description": "One run's workspace.",
            "properties": {
              "baseSha": {
                "description": "The commit the branch was cut from.",
                "type": "string"
              },
              "branch": {
                "description": "The branch, `reno/<run id>`.",
                "type": "string"
              },
              "changes": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/WorkspaceChanges"
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "What it held when its run last ended."
              },
              "createdAtMs": {
                "description": "When it was recorded.",
                "format": "uint64",
                "minimum": 0,
                "type": "integer"
              },
              "path": {
                "description": "The worktree's root.",
                "type": "string"
              },
              "repo": {
                "description": "The repository's working tree root the task targeted.",
                "type": "string"
              },
              "repoKey": {
                "description": "The stable, collision-free key of the repository in the worktrees directory.",
                "type": "string"
              },
              "runId": {
                "$ref": "#/$defs/RunId",
                "description": "The run it belongs to."
              },
              "status": {
                "$ref": "#/$defs/WorkspaceStatus",
                "description": "Where it stands."
              },
              "subdir": {
                "description": "The directory inside the repository the task targeted, relative to its root; empty for the\nroot. The run's working directory is `path` joined with it.",
                "type": "string"
              },
              "updatedAtMs": {
                "description": "When it last changed.",
                "format": "uint64",
                "minimum": 0,
                "type": "integer"
              }
            },
            "required": [
              "runId",
              "repo",
              "repoKey",
              "path",
              "branch",
              "baseSha",
              "status",
              "createdAtMs",
              "updatedAtMs"
            ],
            "type": "object"
          },
          "WorkspaceStatus": {
            "description": "Where a workspace stands.",
            "oneOf": [
              {
                "const": "preparing",
                "description": "Recorded, and being created. A workspace found in this state at start-up is a crash\nleftover and is reconciled.",
                "type": "string"
              },
              {
                "const": "active",
                "description": "Created, and its run has not ended (or may be resumed).",
                "type": "string"
              },
              {
                "const": "kept",
                "description": "Its run ended and it holds commits or uncommitted changes, so the worktree and the branch\nare kept for a later integration step.",
                "type": "string"
              },
              {
                "const": "removed",
                "description": "Its worktree and branch were removed.",
                "type": "string"
              },
              {
                "const": "lost",
                "description": "Its directory vanished and was pruned; the branch may remain.",
                "type": "string"
              }
            ]
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "description": "Result of `workspace.list`.",
        "properties": {
          "workspaces": {
            "description": "The workspaces, newest first.",
            "items": {
              "$ref": "#/$defs/WorkspaceInfo"
            },
            "type": "array"
          }
        },
        "required": [
          "workspaces"
        ],
        "title": "WorkspaceListResult",
        "type": "object"
      }
    },
    {
      "name": "workspace.get",
      "params": {
        "$defs": {
          "RunId": {
            "pattern": "^run_[A-Za-z0-9]{1,64}$",
            "type": "string"
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "description": "Params of `workspace.get`.",
        "properties": {
          "runId": {
            "$ref": "#/$defs/RunId",
            "description": "The run whose workspace to return."
          }
        },
        "required": [
          "runId"
        ],
        "title": "WorkspaceGetParams",
        "type": "object"
      },
      "result": {
        "$defs": {
          "RunId": {
            "pattern": "^run_[A-Za-z0-9]{1,64}$",
            "type": "string"
          },
          "WorkspaceChanges": {
            "description": "What a workspace holds beyond its base commit.",
            "properties": {
              "commits": {
                "description": "Commits on the branch that its base commit does not have.",
                "format": "uint32",
                "minimum": 0,
                "type": "integer"
              },
              "dirty": {
                "description": "Whether the worktree has uncommitted changes or untracked files.",
                "type": "boolean"
              }
            },
            "required": [
              "commits",
              "dirty"
            ],
            "type": "object"
          },
          "WorkspaceStatus": {
            "description": "Where a workspace stands.",
            "oneOf": [
              {
                "const": "preparing",
                "description": "Recorded, and being created. A workspace found in this state at start-up is a crash\nleftover and is reconciled.",
                "type": "string"
              },
              {
                "const": "active",
                "description": "Created, and its run has not ended (or may be resumed).",
                "type": "string"
              },
              {
                "const": "kept",
                "description": "Its run ended and it holds commits or uncommitted changes, so the worktree and the branch\nare kept for a later integration step.",
                "type": "string"
              },
              {
                "const": "removed",
                "description": "Its worktree and branch were removed.",
                "type": "string"
              },
              {
                "const": "lost",
                "description": "Its directory vanished and was pruned; the branch may remain.",
                "type": "string"
              }
            ]
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "description": "One run's workspace.",
        "properties": {
          "baseSha": {
            "description": "The commit the branch was cut from.",
            "type": "string"
          },
          "branch": {
            "description": "The branch, `reno/<run id>`.",
            "type": "string"
          },
          "changes": {
            "anyOf": [
              {
                "$ref": "#/$defs/WorkspaceChanges"
              },
              {
                "type": "null"
              }
            ],
            "description": "What it held when its run last ended."
          },
          "createdAtMs": {
            "description": "When it was recorded.",
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "path": {
            "description": "The worktree's root.",
            "type": "string"
          },
          "repo": {
            "description": "The repository's working tree root the task targeted.",
            "type": "string"
          },
          "repoKey": {
            "description": "The stable, collision-free key of the repository in the worktrees directory.",
            "type": "string"
          },
          "runId": {
            "$ref": "#/$defs/RunId",
            "description": "The run it belongs to."
          },
          "status": {
            "$ref": "#/$defs/WorkspaceStatus",
            "description": "Where it stands."
          },
          "subdir": {
            "description": "The directory inside the repository the task targeted, relative to its root; empty for the\nroot. The run's working directory is `path` joined with it.",
            "type": "string"
          },
          "updatedAtMs": {
            "description": "When it last changed.",
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "runId",
          "repo",
          "repoKey",
          "path",
          "branch",
          "baseSha",
          "status",
          "createdAtMs",
          "updatedAtMs"
        ],
        "title": "WorkspaceInfo",
        "type": "object"
      }
    },
    {
      "name": "workspace.clean",
      "params": {
        "$defs": {
          "CleanTarget": {
            "description": "Which workspaces `workspace.clean` looks at.",
            "oneOf": [
              {
                "description": "One run's workspace.",
                "properties": {
                  "runId": {
                    "$ref": "#/$defs/RunId",
                    "description": "The run."
                  },
                  "type": {
                    "const": "run",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "runId"
                ],
                "type": "object"
              },
              {
                "description": "Workspaces whose branch is merged into their repository's current `HEAD`.",
                "properties": {
                  "type": {
                    "const": "merged",
                    "type": "string"
                  }
                },
                "required": [
                  "type"
                ],
                "type": "object"
              },
              {
                "description": "Workspaces with no commits and no uncommitted changes.",
                "properties": {
                  "type": {
                    "const": "all_clean",
                    "type": "string"
                  }
                },
                "required": [
                  "type"
                ],
                "type": "object"
              }
            ]
          },
          "RunId": {
            "pattern": "^run_[A-Za-z0-9]{1,64}$",
            "type": "string"
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "description": "Params of `workspace.clean`.",
        "properties": {
          "force": {
            "default": false,
            "description": "Remove a workspace even when it holds unmerged commits or uncommitted changes, deleting\nits branch. The only way to lose work.",
            "type": "boolean"
          },
          "target": {
            "$ref": "#/$defs/CleanTarget",
            "description": "What to clean."
          }
        },
        "required": [
          "target"
        ],
        "title": "WorkspaceCleanParams",
        "type": "object"
      },
      "result": {
        "$defs": {
          "CleanItem": {
            "description": "One workspace `workspace.clean` looked at.",
            "properties": {
              "outcome": {
                "$ref": "#/$defs/CleanOutcome",
                "description": "What was done."
              },
              "reason": {
                "description": "Why it was kept, in words.",
                "type": [
                  "string",
                  "null"
                ]
              },
              "runId": {
                "$ref": "#/$defs/RunId",
                "description": "The run."
              }
            },
            "required": [
              "runId",
              "outcome"
            ],
            "type": "object"
          },
          "CleanOutcome": {
            "description": "What `workspace.clean` did with one workspace.",
            "oneOf": [
              {
                "const": "removed",
                "description": "The worktree and the branch were removed.",
                "type": "string"
              },
              {
                "const": "kept",
                "description": "Left as it was: see `reason`.",
                "type": "string"
              }
            ]
          },
          "RunId": {
            "pattern": "^run_[A-Za-z0-9]{1,64}$",
            "type": "string"
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "description": "Result of `workspace.clean`.",
        "properties": {
          "items": {
            "description": "Each workspace looked at.",
            "items": {
              "$ref": "#/$defs/CleanItem"
            },
            "type": "array"
          }
        },
        "required": [
          "items"
        ],
        "title": "WorkspaceCleanResult",
        "type": "object"
      }
    },
    {
      "name": "executor.list",
      "params": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "description": "Empty params: serialises as `{}`.",
        "title": "NoParams",
        "type": "object"
      },
      "result": {
        "$defs": {
          "AccessMode": {
            "description": "How much a harness may do without asking. Never run with more than requested (ARCH-15).",
            "oneOf": [
              {
                "const": "supervised",
                "description": "Every consequential action needs approval.",
                "type": "string"
              },
              {
                "const": "auto_accept_edits",
                "description": "File edits proceed; commands and network still ask.",
                "type": "string"
              },
              {
                "const": "full_access",
                "description": "The harness asks nothing.",
                "type": "string"
              }
            ]
          },
          "ExecutorCaps": {
            "description": "What an executor declares it can do. Nothing is trusted beyond this (ARCH-15).",
            "properties": {
              "accessModes": {
                "description": "Access modes the executor can honour.",
                "items": {
                  "$ref": "#/$defs/AccessMode"
                },
                "type": "array"
              },
              "deterministicTurnEnd": {
                "description": "Whether the end of a turn is reported deterministically.",
                "type": "boolean"
              },
              "mcpInjection": {
                "description": "False means it cannot join a team or use boards.",
                "type": "boolean"
              },
              "models": {
                "description": "Models on offer.",
                "items": {
                  "$ref": "#/$defs/ModelInfo"
                },
                "type": "array"
              },
              "planMode": {
                "description": "Whether a plan mode exists.",
                "type": "boolean"
              },
              "resume": {
                "description": "Whether sessions can be resumed.",
                "type": "boolean"
              },
              "sandboxLevels": {
                "description": "Sandbox levels the executor can honour: a run is only started at a level listed here. An\nexecutor with no sandbox of its own honours only `Unrestricted`.",
                "items": {
                  "$ref": "#/$defs/SandboxLevel"
                },
                "type": "array"
              },
              "steering": {
                "$ref": "#/$defs/Steering",
                "description": "When steering messages can land."
              },
              "structuredOutput": {
                "description": "Whether `output_schema` is honoured.",
                "type": "boolean"
              }
            },
            "required": [
              "steering",
              "resume",
              "accessModes",
              "sandboxLevels",
              "mcpInjection",
              "structuredOutput",
              "deterministicTurnEnd",
              "planMode",
              "models"
            ],
            "type": "object"
          },
          "ExecutorDescriptor": {
            "description": "An installed harness and what it can do.",
            "properties": {
              "adapterVersion": {
                "description": "Driver version plus the detected harness CLI version.",
                "type": "string"
              },
              "caps": {
                "$ref": "#/$defs/ExecutorCaps",
                "description": "Declared capabilities."
              },
              "cliVerified": {
                "$ref": "#/$defs/VersionRange",
                "description": "Supported harness CLI versions."
              },
              "contractVersion": {
                "description": "Version of the Reno executor contract the adapter implements.",
                "format": "uint32",
                "minimum": 0,
                "type": "integer"
              },
              "id": {
                "$ref": "#/$defs/ExecutorId",
                "description": "Executor id, for example `claude-code`."
              }
            },
            "required": [
              "id",
              "contractVersion",
              "adapterVersion",
              "cliVerified",
              "caps"
            ],
            "type": "object"
          },
          "ExecutorHealth": {
            "description": "What the daemon last found out about one executor.",
            "properties": {
              "checkedAtMs": {
                "description": "When the probe finished, in milliseconds since the Unix epoch.",
                "format": "uint64",
                "minimum": 0,
                "type": "integer"
              },
              "installed": {
                "$ref": "#/$defs/InstallStatus",
                "description": "Whether and where the harness is installed."
              },
              "models": {
                "$ref": "#/$defs/ModelCatalog",
                "description": "The models on offer, and whether they came from the live harness or the adapter's list."
              },
              "signedIn": {
                "$ref": "#/$defs/SignedIn",
                "description": "Whether the harness is signed in."
              },
              "versionGate": {
                "$ref": "#/$defs/VersionGate",
                "description": "The installed version against the verified range."
              }
            },
            "required": [
              "installed",
              "versionGate",
              "signedIn",
              "models",
              "checkedAtMs"
            ],
            "type": "object"
          },
          "ExecutorId": {
            "pattern": "^[A-Za-z0-9._-]{1,64}$",
            "type": "string"
          },
          "ExecutorInfo": {
            "description": "One executor as `executor.list` shows it.",
            "properties": {
              "descriptor": {
                "$ref": "#/$defs/ExecutorDescriptor",
                "description": "What the executor declares it can do. Its `caps.models` is the list `health.models`\nlabels: the live list when a probe got one, else the curated list."
              },
              "health": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/ExecutorHealth"
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "The last probe. Absent until the first probe of this executor has finished."
              }
            },
            "required": [
              "descriptor"
            ],
            "type": "object"
          },
          "InstallStatus": {
            "description": "Whether the harness can be launched, and from where.",
            "oneOf": [
              {
                "description": "A launchable program was found.",
                "properties": {
                  "path": {
                    "description": "The program a run would launch.",
                    "type": "string"
                  },
                  "type": {
                    "const": "installed",
                    "type": "string"
                  },
                  "version": {
                    "description": "Its version, when it could be read.",
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                },
                "required": [
                  "type",
                  "path"
                ],
                "type": "object"
              },
              {
                "description": "Nothing launchable.",
                "properties": {
                  "type": {
                    "const": "not_installed",
                    "type": "string"
                  },
                  "why": {
                    "$ref": "#/$defs/NotInstalledReason",
                    "description": "Why."
                  }
                },
                "required": [
                  "type",
                  "why"
                ],
                "type": "object"
              }
            ]
          },
          "ModelCatalog": {
            "description": "The models an executor offers and where the list came from.",
            "properties": {
              "models": {
                "description": "The models.",
                "items": {
                  "$ref": "#/$defs/ModelInfo"
                },
                "type": "array"
              },
              "source": {
                "$ref": "#/$defs/ModelSource",
                "description": "Where the list came from."
              }
            },
            "required": [
              "source",
              "models"
            ],
            "type": "object"
          },
          "ModelInfo": {
            "description": "A model an executor offers.",
            "properties": {
              "displayName": {
                "description": "Display name.",
                "type": [
                  "string",
                  "null"
                ]
              },
              "id": {
                "description": "Model id as passed to the harness.",
                "type": "string"
              }
            },
            "required": [
              "id"
            ],
            "type": "object"
          },
          "ModelSource": {
            "description": "Where a list of models came from.",
            "oneOf": [
              {
                "const": "curated",
                "description": "The adapter's built-in list.",
                "type": "string"
              },
              {
                "const": "live",
                "description": "Asked of the live harness by the last probe.",
                "type": "string"
              }
            ]
          },
          "NotInstalledReason": {
            "description": "Why a harness cannot be launched.",
            "oneOf": [
              {
                "description": "No program was found where the driver looks.",
                "properties": {
                  "hint": {
                    "description": "Where it looks and how to get it, for a person.",
                    "type": "string"
                  },
                  "type": {
                    "const": "not_found",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "hint"
                ],
                "type": "object"
              },
              {
                "description": "The agent's launcher needs a managed install (an adapter package or a release archive)\nthat has not been done. A run never installs: this is an explicit step.",
                "properties": {
                  "type": {
                    "const": "needs_install",
                    "type": "string"
                  },
                  "what": {
                    "description": "What would be installed.",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "what"
                ],
                "type": "object"
              },
              {
                "description": "Something is there but cannot be launched (an override that points at nothing, a file\nthat is not executable).",
                "properties": {
                  "detail": {
                    "description": "What is wrong with it.",
                    "type": "string"
                  },
                  "type": {
                    "const": "unusable",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "detail"
                ],
                "type": "object"
              },
              {
                "description": "The probe itself failed, so nothing is known.",
                "properties": {
                  "detail": {
                    "description": "What happened.",
                    "type": "string"
                  },
                  "type": {
                    "const": "probe_failed",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "detail"
                ],
                "type": "object"
              }
            ]
          },
          "SandboxLevel": {
            "description": "The sandbox the harness itself enforces around its tools: a ceiling below the access mode.\nA run that asks for `ReadOnly` or `WorkspaceWrite` goes only to an executor that enforces that\nlevel; `Unrestricted` asks for no ceiling beyond the access mode, so every executor can take it.",
            "oneOf": [
              {
                "const": "read_only",
                "description": "No writes.",
                "type": "string"
              },
              {
                "const": "workspace_write",
                "description": "Writes confined to the workspace.",
                "type": "string"
              },
              {
                "const": "unrestricted",
                "description": "No sandbox ceiling beyond the access mode (and the run's worktree).",
                "type": "string"
              }
            ]
          },
          "SignedIn": {
            "description": "Whether the harness has a login.",
            "oneOf": [
              {
                "description": "A login exists.",
                "properties": {
                  "account": {
                    "description": "Who, when the harness says.",
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "type": {
                    "const": "yes",
                    "type": "string"
                  }
                },
                "required": [
                  "type"
                ],
                "type": "object"
              },
              {
                "description": "No login: not eligible.",
                "properties": {
                  "hint": {
                    "description": "What to do about it.",
                    "type": "string"
                  },
                  "type": {
                    "const": "no",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "hint"
                ],
                "type": "object"
              },
              {
                "description": "The harness offers no way to tell without running a model call. Stays eligible.",
                "properties": {
                  "type": {
                    "const": "unknown",
                    "type": "string"
                  }
                },
                "required": [
                  "type"
                ],
                "type": "object"
              }
            ]
          },
          "Steering": {
            "description": "When a running harness can accept a steering message.",
            "oneOf": [
              {
                "const": "none",
                "description": "Cannot be steered mid-run.",
                "type": "string"
              },
              {
                "const": "turn_boundary",
                "description": "Steering lands at the next turn.",
                "type": "string"
              },
              {
                "const": "step_boundary",
                "description": "Steering lands at the next step.",
                "type": "string"
              }
            ]
          },
          "VersionGate": {
            "description": "The installed version against the adapter's verified range.",
            "oneOf": [
              {
                "description": "At least the minimum, and no newer than the last version the adapter was verified on.",
                "properties": {
                  "type": {
                    "const": "ok",
                    "type": "string"
                  }
                },
                "required": [
                  "type"
                ],
                "type": "object"
              },
              {
                "description": "Older than the minimum the adapter supports: not eligible.",
                "properties": {
                  "min": {
                    "description": "The oldest supported version.",
                    "type": "string"
                  },
                  "type": {
                    "const": "too_old",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "min"
                ],
                "type": "object"
              },
              {
                "description": "Newer than the last version the adapter was verified on: eligible, but unproven.",
                "properties": {
                  "type": {
                    "const": "untested",
                    "type": "string"
                  },
                  "verified": {
                    "description": "The newest version the conformance suite passed on.",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "verified"
                ],
                "type": "object"
              },
              {
                "description": "There is no version to compare: not installed, or the CLI did not report one.",
                "properties": {
                  "type": {
                    "const": "unchecked",
                    "type": "string"
                  }
                },
                "required": [
                  "type"
                ],
                "type": "object"
              }
            ]
          },
          "VersionRange": {
            "description": "Harness CLI versions an adapter supports.",
            "properties": {
              "min": {
                "description": "Oldest supported version.",
                "type": "string"
              },
              "verified": {
                "description": "Newest version the conformance suite passed against.",
                "type": "string"
              }
            },
            "required": [
              "min",
              "verified"
            ],
            "type": "object"
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "description": "Result of `executor.list` and `executor.refresh`.",
        "properties": {
          "executors": {
            "description": "The executors, by id.",
            "items": {
              "$ref": "#/$defs/ExecutorInfo"
            },
            "type": "array"
          }
        },
        "required": [
          "executors"
        ],
        "title": "ExecutorListResult",
        "type": "object"
      }
    },
    {
      "name": "executor.refresh",
      "params": {
        "$defs": {
          "ExecutorId": {
            "pattern": "^[A-Za-z0-9._-]{1,64}$",
            "type": "string"
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "description": "Params of `executor.refresh`.",
        "properties": {
          "id": {
            "anyOf": [
              {
                "$ref": "#/$defs/ExecutorId"
              },
              {
                "type": "null"
              }
            ],
            "description": "The executor to probe again; every executor when absent."
          }
        },
        "title": "ExecutorRefreshParams",
        "type": "object"
      },
      "result": {
        "$defs": {
          "AccessMode": {
            "description": "How much a harness may do without asking. Never run with more than requested (ARCH-15).",
            "oneOf": [
              {
                "const": "supervised",
                "description": "Every consequential action needs approval.",
                "type": "string"
              },
              {
                "const": "auto_accept_edits",
                "description": "File edits proceed; commands and network still ask.",
                "type": "string"
              },
              {
                "const": "full_access",
                "description": "The harness asks nothing.",
                "type": "string"
              }
            ]
          },
          "ExecutorCaps": {
            "description": "What an executor declares it can do. Nothing is trusted beyond this (ARCH-15).",
            "properties": {
              "accessModes": {
                "description": "Access modes the executor can honour.",
                "items": {
                  "$ref": "#/$defs/AccessMode"
                },
                "type": "array"
              },
              "deterministicTurnEnd": {
                "description": "Whether the end of a turn is reported deterministically.",
                "type": "boolean"
              },
              "mcpInjection": {
                "description": "False means it cannot join a team or use boards.",
                "type": "boolean"
              },
              "models": {
                "description": "Models on offer.",
                "items": {
                  "$ref": "#/$defs/ModelInfo"
                },
                "type": "array"
              },
              "planMode": {
                "description": "Whether a plan mode exists.",
                "type": "boolean"
              },
              "resume": {
                "description": "Whether sessions can be resumed.",
                "type": "boolean"
              },
              "sandboxLevels": {
                "description": "Sandbox levels the executor can honour: a run is only started at a level listed here. An\nexecutor with no sandbox of its own honours only `Unrestricted`.",
                "items": {
                  "$ref": "#/$defs/SandboxLevel"
                },
                "type": "array"
              },
              "steering": {
                "$ref": "#/$defs/Steering",
                "description": "When steering messages can land."
              },
              "structuredOutput": {
                "description": "Whether `output_schema` is honoured.",
                "type": "boolean"
              }
            },
            "required": [
              "steering",
              "resume",
              "accessModes",
              "sandboxLevels",
              "mcpInjection",
              "structuredOutput",
              "deterministicTurnEnd",
              "planMode",
              "models"
            ],
            "type": "object"
          },
          "ExecutorDescriptor": {
            "description": "An installed harness and what it can do.",
            "properties": {
              "adapterVersion": {
                "description": "Driver version plus the detected harness CLI version.",
                "type": "string"
              },
              "caps": {
                "$ref": "#/$defs/ExecutorCaps",
                "description": "Declared capabilities."
              },
              "cliVerified": {
                "$ref": "#/$defs/VersionRange",
                "description": "Supported harness CLI versions."
              },
              "contractVersion": {
                "description": "Version of the Reno executor contract the adapter implements.",
                "format": "uint32",
                "minimum": 0,
                "type": "integer"
              },
              "id": {
                "$ref": "#/$defs/ExecutorId",
                "description": "Executor id, for example `claude-code`."
              }
            },
            "required": [
              "id",
              "contractVersion",
              "adapterVersion",
              "cliVerified",
              "caps"
            ],
            "type": "object"
          },
          "ExecutorHealth": {
            "description": "What the daemon last found out about one executor.",
            "properties": {
              "checkedAtMs": {
                "description": "When the probe finished, in milliseconds since the Unix epoch.",
                "format": "uint64",
                "minimum": 0,
                "type": "integer"
              },
              "installed": {
                "$ref": "#/$defs/InstallStatus",
                "description": "Whether and where the harness is installed."
              },
              "models": {
                "$ref": "#/$defs/ModelCatalog",
                "description": "The models on offer, and whether they came from the live harness or the adapter's list."
              },
              "signedIn": {
                "$ref": "#/$defs/SignedIn",
                "description": "Whether the harness is signed in."
              },
              "versionGate": {
                "$ref": "#/$defs/VersionGate",
                "description": "The installed version against the verified range."
              }
            },
            "required": [
              "installed",
              "versionGate",
              "signedIn",
              "models",
              "checkedAtMs"
            ],
            "type": "object"
          },
          "ExecutorId": {
            "pattern": "^[A-Za-z0-9._-]{1,64}$",
            "type": "string"
          },
          "ExecutorInfo": {
            "description": "One executor as `executor.list` shows it.",
            "properties": {
              "descriptor": {
                "$ref": "#/$defs/ExecutorDescriptor",
                "description": "What the executor declares it can do. Its `caps.models` is the list `health.models`\nlabels: the live list when a probe got one, else the curated list."
              },
              "health": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/ExecutorHealth"
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "The last probe. Absent until the first probe of this executor has finished."
              }
            },
            "required": [
              "descriptor"
            ],
            "type": "object"
          },
          "InstallStatus": {
            "description": "Whether the harness can be launched, and from where.",
            "oneOf": [
              {
                "description": "A launchable program was found.",
                "properties": {
                  "path": {
                    "description": "The program a run would launch.",
                    "type": "string"
                  },
                  "type": {
                    "const": "installed",
                    "type": "string"
                  },
                  "version": {
                    "description": "Its version, when it could be read.",
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                },
                "required": [
                  "type",
                  "path"
                ],
                "type": "object"
              },
              {
                "description": "Nothing launchable.",
                "properties": {
                  "type": {
                    "const": "not_installed",
                    "type": "string"
                  },
                  "why": {
                    "$ref": "#/$defs/NotInstalledReason",
                    "description": "Why."
                  }
                },
                "required": [
                  "type",
                  "why"
                ],
                "type": "object"
              }
            ]
          },
          "ModelCatalog": {
            "description": "The models an executor offers and where the list came from.",
            "properties": {
              "models": {
                "description": "The models.",
                "items": {
                  "$ref": "#/$defs/ModelInfo"
                },
                "type": "array"
              },
              "source": {
                "$ref": "#/$defs/ModelSource",
                "description": "Where the list came from."
              }
            },
            "required": [
              "source",
              "models"
            ],
            "type": "object"
          },
          "ModelInfo": {
            "description": "A model an executor offers.",
            "properties": {
              "displayName": {
                "description": "Display name.",
                "type": [
                  "string",
                  "null"
                ]
              },
              "id": {
                "description": "Model id as passed to the harness.",
                "type": "string"
              }
            },
            "required": [
              "id"
            ],
            "type": "object"
          },
          "ModelSource": {
            "description": "Where a list of models came from.",
            "oneOf": [
              {
                "const": "curated",
                "description": "The adapter's built-in list.",
                "type": "string"
              },
              {
                "const": "live",
                "description": "Asked of the live harness by the last probe.",
                "type": "string"
              }
            ]
          },
          "NotInstalledReason": {
            "description": "Why a harness cannot be launched.",
            "oneOf": [
              {
                "description": "No program was found where the driver looks.",
                "properties": {
                  "hint": {
                    "description": "Where it looks and how to get it, for a person.",
                    "type": "string"
                  },
                  "type": {
                    "const": "not_found",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "hint"
                ],
                "type": "object"
              },
              {
                "description": "The agent's launcher needs a managed install (an adapter package or a release archive)\nthat has not been done. A run never installs: this is an explicit step.",
                "properties": {
                  "type": {
                    "const": "needs_install",
                    "type": "string"
                  },
                  "what": {
                    "description": "What would be installed.",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "what"
                ],
                "type": "object"
              },
              {
                "description": "Something is there but cannot be launched (an override that points at nothing, a file\nthat is not executable).",
                "properties": {
                  "detail": {
                    "description": "What is wrong with it.",
                    "type": "string"
                  },
                  "type": {
                    "const": "unusable",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "detail"
                ],
                "type": "object"
              },
              {
                "description": "The probe itself failed, so nothing is known.",
                "properties": {
                  "detail": {
                    "description": "What happened.",
                    "type": "string"
                  },
                  "type": {
                    "const": "probe_failed",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "detail"
                ],
                "type": "object"
              }
            ]
          },
          "SandboxLevel": {
            "description": "The sandbox the harness itself enforces around its tools: a ceiling below the access mode.\nA run that asks for `ReadOnly` or `WorkspaceWrite` goes only to an executor that enforces that\nlevel; `Unrestricted` asks for no ceiling beyond the access mode, so every executor can take it.",
            "oneOf": [
              {
                "const": "read_only",
                "description": "No writes.",
                "type": "string"
              },
              {
                "const": "workspace_write",
                "description": "Writes confined to the workspace.",
                "type": "string"
              },
              {
                "const": "unrestricted",
                "description": "No sandbox ceiling beyond the access mode (and the run's worktree).",
                "type": "string"
              }
            ]
          },
          "SignedIn": {
            "description": "Whether the harness has a login.",
            "oneOf": [
              {
                "description": "A login exists.",
                "properties": {
                  "account": {
                    "description": "Who, when the harness says.",
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "type": {
                    "const": "yes",
                    "type": "string"
                  }
                },
                "required": [
                  "type"
                ],
                "type": "object"
              },
              {
                "description": "No login: not eligible.",
                "properties": {
                  "hint": {
                    "description": "What to do about it.",
                    "type": "string"
                  },
                  "type": {
                    "const": "no",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "hint"
                ],
                "type": "object"
              },
              {
                "description": "The harness offers no way to tell without running a model call. Stays eligible.",
                "properties": {
                  "type": {
                    "const": "unknown",
                    "type": "string"
                  }
                },
                "required": [
                  "type"
                ],
                "type": "object"
              }
            ]
          },
          "Steering": {
            "description": "When a running harness can accept a steering message.",
            "oneOf": [
              {
                "const": "none",
                "description": "Cannot be steered mid-run.",
                "type": "string"
              },
              {
                "const": "turn_boundary",
                "description": "Steering lands at the next turn.",
                "type": "string"
              },
              {
                "const": "step_boundary",
                "description": "Steering lands at the next step.",
                "type": "string"
              }
            ]
          },
          "VersionGate": {
            "description": "The installed version against the adapter's verified range.",
            "oneOf": [
              {
                "description": "At least the minimum, and no newer than the last version the adapter was verified on.",
                "properties": {
                  "type": {
                    "const": "ok",
                    "type": "string"
                  }
                },
                "required": [
                  "type"
                ],
                "type": "object"
              },
              {
                "description": "Older than the minimum the adapter supports: not eligible.",
                "properties": {
                  "min": {
                    "description": "The oldest supported version.",
                    "type": "string"
                  },
                  "type": {
                    "const": "too_old",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "min"
                ],
                "type": "object"
              },
              {
                "description": "Newer than the last version the adapter was verified on: eligible, but unproven.",
                "properties": {
                  "type": {
                    "const": "untested",
                    "type": "string"
                  },
                  "verified": {
                    "description": "The newest version the conformance suite passed on.",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "verified"
                ],
                "type": "object"
              },
              {
                "description": "There is no version to compare: not installed, or the CLI did not report one.",
                "properties": {
                  "type": {
                    "const": "unchecked",
                    "type": "string"
                  }
                },
                "required": [
                  "type"
                ],
                "type": "object"
              }
            ]
          },
          "VersionRange": {
            "description": "Harness CLI versions an adapter supports.",
            "properties": {
              "min": {
                "description": "Oldest supported version.",
                "type": "string"
              },
              "verified": {
                "description": "Newest version the conformance suite passed against.",
                "type": "string"
              }
            },
            "required": [
              "min",
              "verified"
            ],
            "type": "object"
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "description": "Result of `executor.list` and `executor.refresh`.",
        "properties": {
          "executors": {
            "description": "The executors, by id.",
            "items": {
              "$ref": "#/$defs/ExecutorInfo"
            },
            "type": "array"
          }
        },
        "required": [
          "executors"
        ],
        "title": "ExecutorListResult",
        "type": "object"
      }
    },
    {
      "name": "executor.install",
      "params": {
        "$defs": {
          "ExecutorId": {
            "pattern": "^[A-Za-z0-9._-]{1,64}$",
            "type": "string"
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "description": "Params of `executor.install`.",
        "properties": {
          "id": {
            "$ref": "#/$defs/ExecutorId",
            "description": "The executor whose managed adapter or release archive is to be fetched and verified. Its\nlast probe must say `needs_install`."
          }
        },
        "required": [
          "id"
        ],
        "title": "ExecutorInstallParams",
        "type": "object"
      },
      "result": {
        "$defs": {
          "AccessMode": {
            "description": "How much a harness may do without asking. Never run with more than requested (ARCH-15).",
            "oneOf": [
              {
                "const": "supervised",
                "description": "Every consequential action needs approval.",
                "type": "string"
              },
              {
                "const": "auto_accept_edits",
                "description": "File edits proceed; commands and network still ask.",
                "type": "string"
              },
              {
                "const": "full_access",
                "description": "The harness asks nothing.",
                "type": "string"
              }
            ]
          },
          "ExecutorCaps": {
            "description": "What an executor declares it can do. Nothing is trusted beyond this (ARCH-15).",
            "properties": {
              "accessModes": {
                "description": "Access modes the executor can honour.",
                "items": {
                  "$ref": "#/$defs/AccessMode"
                },
                "type": "array"
              },
              "deterministicTurnEnd": {
                "description": "Whether the end of a turn is reported deterministically.",
                "type": "boolean"
              },
              "mcpInjection": {
                "description": "False means it cannot join a team or use boards.",
                "type": "boolean"
              },
              "models": {
                "description": "Models on offer.",
                "items": {
                  "$ref": "#/$defs/ModelInfo"
                },
                "type": "array"
              },
              "planMode": {
                "description": "Whether a plan mode exists.",
                "type": "boolean"
              },
              "resume": {
                "description": "Whether sessions can be resumed.",
                "type": "boolean"
              },
              "sandboxLevels": {
                "description": "Sandbox levels the executor can honour: a run is only started at a level listed here. An\nexecutor with no sandbox of its own honours only `Unrestricted`.",
                "items": {
                  "$ref": "#/$defs/SandboxLevel"
                },
                "type": "array"
              },
              "steering": {
                "$ref": "#/$defs/Steering",
                "description": "When steering messages can land."
              },
              "structuredOutput": {
                "description": "Whether `output_schema` is honoured.",
                "type": "boolean"
              }
            },
            "required": [
              "steering",
              "resume",
              "accessModes",
              "sandboxLevels",
              "mcpInjection",
              "structuredOutput",
              "deterministicTurnEnd",
              "planMode",
              "models"
            ],
            "type": "object"
          },
          "ExecutorDescriptor": {
            "description": "An installed harness and what it can do.",
            "properties": {
              "adapterVersion": {
                "description": "Driver version plus the detected harness CLI version.",
                "type": "string"
              },
              "caps": {
                "$ref": "#/$defs/ExecutorCaps",
                "description": "Declared capabilities."
              },
              "cliVerified": {
                "$ref": "#/$defs/VersionRange",
                "description": "Supported harness CLI versions."
              },
              "contractVersion": {
                "description": "Version of the Reno executor contract the adapter implements.",
                "format": "uint32",
                "minimum": 0,
                "type": "integer"
              },
              "id": {
                "$ref": "#/$defs/ExecutorId",
                "description": "Executor id, for example `claude-code`."
              }
            },
            "required": [
              "id",
              "contractVersion",
              "adapterVersion",
              "cliVerified",
              "caps"
            ],
            "type": "object"
          },
          "ExecutorHealth": {
            "description": "What the daemon last found out about one executor.",
            "properties": {
              "checkedAtMs": {
                "description": "When the probe finished, in milliseconds since the Unix epoch.",
                "format": "uint64",
                "minimum": 0,
                "type": "integer"
              },
              "installed": {
                "$ref": "#/$defs/InstallStatus",
                "description": "Whether and where the harness is installed."
              },
              "models": {
                "$ref": "#/$defs/ModelCatalog",
                "description": "The models on offer, and whether they came from the live harness or the adapter's list."
              },
              "signedIn": {
                "$ref": "#/$defs/SignedIn",
                "description": "Whether the harness is signed in."
              },
              "versionGate": {
                "$ref": "#/$defs/VersionGate",
                "description": "The installed version against the verified range."
              }
            },
            "required": [
              "installed",
              "versionGate",
              "signedIn",
              "models",
              "checkedAtMs"
            ],
            "type": "object"
          },
          "ExecutorId": {
            "pattern": "^[A-Za-z0-9._-]{1,64}$",
            "type": "string"
          },
          "ExecutorInfo": {
            "description": "One executor as `executor.list` shows it.",
            "properties": {
              "descriptor": {
                "$ref": "#/$defs/ExecutorDescriptor",
                "description": "What the executor declares it can do. Its `caps.models` is the list `health.models`\nlabels: the live list when a probe got one, else the curated list."
              },
              "health": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/ExecutorHealth"
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "The last probe. Absent until the first probe of this executor has finished."
              }
            },
            "required": [
              "descriptor"
            ],
            "type": "object"
          },
          "InstallStatus": {
            "description": "Whether the harness can be launched, and from where.",
            "oneOf": [
              {
                "description": "A launchable program was found.",
                "properties": {
                  "path": {
                    "description": "The program a run would launch.",
                    "type": "string"
                  },
                  "type": {
                    "const": "installed",
                    "type": "string"
                  },
                  "version": {
                    "description": "Its version, when it could be read.",
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                },
                "required": [
                  "type",
                  "path"
                ],
                "type": "object"
              },
              {
                "description": "Nothing launchable.",
                "properties": {
                  "type": {
                    "const": "not_installed",
                    "type": "string"
                  },
                  "why": {
                    "$ref": "#/$defs/NotInstalledReason",
                    "description": "Why."
                  }
                },
                "required": [
                  "type",
                  "why"
                ],
                "type": "object"
              }
            ]
          },
          "ModelCatalog": {
            "description": "The models an executor offers and where the list came from.",
            "properties": {
              "models": {
                "description": "The models.",
                "items": {
                  "$ref": "#/$defs/ModelInfo"
                },
                "type": "array"
              },
              "source": {
                "$ref": "#/$defs/ModelSource",
                "description": "Where the list came from."
              }
            },
            "required": [
              "source",
              "models"
            ],
            "type": "object"
          },
          "ModelInfo": {
            "description": "A model an executor offers.",
            "properties": {
              "displayName": {
                "description": "Display name.",
                "type": [
                  "string",
                  "null"
                ]
              },
              "id": {
                "description": "Model id as passed to the harness.",
                "type": "string"
              }
            },
            "required": [
              "id"
            ],
            "type": "object"
          },
          "ModelSource": {
            "description": "Where a list of models came from.",
            "oneOf": [
              {
                "const": "curated",
                "description": "The adapter's built-in list.",
                "type": "string"
              },
              {
                "const": "live",
                "description": "Asked of the live harness by the last probe.",
                "type": "string"
              }
            ]
          },
          "NotInstalledReason": {
            "description": "Why a harness cannot be launched.",
            "oneOf": [
              {
                "description": "No program was found where the driver looks.",
                "properties": {
                  "hint": {
                    "description": "Where it looks and how to get it, for a person.",
                    "type": "string"
                  },
                  "type": {
                    "const": "not_found",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "hint"
                ],
                "type": "object"
              },
              {
                "description": "The agent's launcher needs a managed install (an adapter package or a release archive)\nthat has not been done. A run never installs: this is an explicit step.",
                "properties": {
                  "type": {
                    "const": "needs_install",
                    "type": "string"
                  },
                  "what": {
                    "description": "What would be installed.",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "what"
                ],
                "type": "object"
              },
              {
                "description": "Something is there but cannot be launched (an override that points at nothing, a file\nthat is not executable).",
                "properties": {
                  "detail": {
                    "description": "What is wrong with it.",
                    "type": "string"
                  },
                  "type": {
                    "const": "unusable",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "detail"
                ],
                "type": "object"
              },
              {
                "description": "The probe itself failed, so nothing is known.",
                "properties": {
                  "detail": {
                    "description": "What happened.",
                    "type": "string"
                  },
                  "type": {
                    "const": "probe_failed",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "detail"
                ],
                "type": "object"
              }
            ]
          },
          "SandboxLevel": {
            "description": "The sandbox the harness itself enforces around its tools: a ceiling below the access mode.\nA run that asks for `ReadOnly` or `WorkspaceWrite` goes only to an executor that enforces that\nlevel; `Unrestricted` asks for no ceiling beyond the access mode, so every executor can take it.",
            "oneOf": [
              {
                "const": "read_only",
                "description": "No writes.",
                "type": "string"
              },
              {
                "const": "workspace_write",
                "description": "Writes confined to the workspace.",
                "type": "string"
              },
              {
                "const": "unrestricted",
                "description": "No sandbox ceiling beyond the access mode (and the run's worktree).",
                "type": "string"
              }
            ]
          },
          "SignedIn": {
            "description": "Whether the harness has a login.",
            "oneOf": [
              {
                "description": "A login exists.",
                "properties": {
                  "account": {
                    "description": "Who, when the harness says.",
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "type": {
                    "const": "yes",
                    "type": "string"
                  }
                },
                "required": [
                  "type"
                ],
                "type": "object"
              },
              {
                "description": "No login: not eligible.",
                "properties": {
                  "hint": {
                    "description": "What to do about it.",
                    "type": "string"
                  },
                  "type": {
                    "const": "no",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "hint"
                ],
                "type": "object"
              },
              {
                "description": "The harness offers no way to tell without running a model call. Stays eligible.",
                "properties": {
                  "type": {
                    "const": "unknown",
                    "type": "string"
                  }
                },
                "required": [
                  "type"
                ],
                "type": "object"
              }
            ]
          },
          "Steering": {
            "description": "When a running harness can accept a steering message.",
            "oneOf": [
              {
                "const": "none",
                "description": "Cannot be steered mid-run.",
                "type": "string"
              },
              {
                "const": "turn_boundary",
                "description": "Steering lands at the next turn.",
                "type": "string"
              },
              {
                "const": "step_boundary",
                "description": "Steering lands at the next step.",
                "type": "string"
              }
            ]
          },
          "VersionGate": {
            "description": "The installed version against the adapter's verified range.",
            "oneOf": [
              {
                "description": "At least the minimum, and no newer than the last version the adapter was verified on.",
                "properties": {
                  "type": {
                    "const": "ok",
                    "type": "string"
                  }
                },
                "required": [
                  "type"
                ],
                "type": "object"
              },
              {
                "description": "Older than the minimum the adapter supports: not eligible.",
                "properties": {
                  "min": {
                    "description": "The oldest supported version.",
                    "type": "string"
                  },
                  "type": {
                    "const": "too_old",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "min"
                ],
                "type": "object"
              },
              {
                "description": "Newer than the last version the adapter was verified on: eligible, but unproven.",
                "properties": {
                  "type": {
                    "const": "untested",
                    "type": "string"
                  },
                  "verified": {
                    "description": "The newest version the conformance suite passed on.",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "verified"
                ],
                "type": "object"
              },
              {
                "description": "There is no version to compare: not installed, or the CLI did not report one.",
                "properties": {
                  "type": {
                    "const": "unchecked",
                    "type": "string"
                  }
                },
                "required": [
                  "type"
                ],
                "type": "object"
              }
            ]
          },
          "VersionRange": {
            "description": "Harness CLI versions an adapter supports.",
            "properties": {
              "min": {
                "description": "Oldest supported version.",
                "type": "string"
              },
              "verified": {
                "description": "Newest version the conformance suite passed against.",
                "type": "string"
              }
            },
            "required": [
              "min",
              "verified"
            ],
            "type": "object"
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "description": "Result of `executor.install`.",
        "properties": {
          "executor": {
            "$ref": "#/$defs/ExecutorInfo",
            "description": "The executor after the install and the probe that followed it."
          }
        },
        "required": [
          "executor"
        ],
        "title": "ExecutorInstallResult",
        "type": "object"
      }
    }
  ],
  "notifications": [
    {
      "name": "sub.gap",
      "params": {
        "$defs": {
          "Seq": {
            "description": "A per-run event sequence number. A run's journal numbers its events from 1 without gaps; a\n`from` of `Seq(0)` therefore means \"from the start\".",
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "SubscriptionId": {
            "pattern": "^sub_[A-Za-z0-9]{1,64}$",
            "type": "string"
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "description": "Params of the `sub.gap` notification (ARCH-12).",
        "properties": {
          "resumeFrom": {
            "$ref": "#/$defs/Seq",
            "description": "Re-subscribe with `fromSeq` set to this to continue without loss."
          },
          "subscription": {
            "$ref": "#/$defs/SubscriptionId",
            "description": "The subscription that fell behind and was cut off."
          }
        },
        "required": [
          "subscription",
          "resumeFrom"
        ],
        "title": "SubGapParams",
        "type": "object"
      }
    }
  ],
  "protocolVersion": 1,
  "subscriptions": [
    {
      "item": {
        "$defs": {
          "ActionClass": {
            "description": "What kind of action an approval is about.",
            "oneOf": [
              {
                "const": "read",
                "description": "Reading files.",
                "type": "string"
              },
              {
                "const": "edit",
                "description": "Editing files.",
                "type": "string"
              },
              {
                "const": "command",
                "description": "Running a command.",
                "type": "string"
              },
              {
                "const": "network",
                "description": "Network access.",
                "type": "string"
              },
              {
                "const": "mcp_tool",
                "description": "An MCP tool call.",
                "type": "string"
              },
              {
                "const": "other",
                "description": "Anything else.",
                "type": "string"
              }
            ]
          },
          "ApprovalOutcome": {
            "description": "How an approval request ended: the executor was told yes or no.",
            "oneOf": [
              {
                "const": "approved",
                "description": "The action may proceed.",
                "type": "string"
              },
              {
                "const": "denied",
                "description": "The action is refused.",
                "type": "string"
              }
            ]
          },
          "ApprovalSubject": {
            "description": "The exact thing a human is asked to approve.",
            "properties": {
              "action": {
                "$ref": "#/$defs/ActionClass",
                "description": "Class of the action."
              },
              "command": {
                "description": "The command line, for command actions.",
                "type": [
                  "string",
                  "null"
                ]
              },
              "paths": {
                "default": [],
                "description": "Paths the action touches.",
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "raw": {
                "default": null,
                "description": "The harness's own request, kept for the audit record."
              },
              "tool": {
                "description": "Tool the action goes through.",
                "type": "string"
              }
            },
            "required": [
              "action",
              "tool"
            ],
            "type": "object"
          },
          "ExecEvent": {
            "description": "One event from a running executor. A failing harness yields `Done { stop: Error }`; the\nstream itself never errors mid-run.",
            "oneOf": [
              {
                "description": "The harness session began.",
                "properties": {
                  "model": {
                    "description": "Model actually in use.",
                    "type": "string"
                  },
                  "session": {
                    "$ref": "#/$defs/SessionRef",
                    "description": "Handle for resuming this session."
                  },
                  "type": {
                    "const": "started",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "session",
                  "model"
                ],
                "type": "object"
              },
              {
                "description": "Assistant text.",
                "properties": {
                  "text": {
                    "description": "The text chunk.",
                    "type": "string"
                  },
                  "type": {
                    "const": "text",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "text"
                ],
                "type": "object"
              },
              {
                "description": "Model reasoning text.",
                "properties": {
                  "text": {
                    "description": "The reasoning chunk.",
                    "type": "string"
                  },
                  "type": {
                    "const": "reasoning",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "text"
                ],
                "type": "object"
              },
              {
                "description": "A tool call began.",
                "properties": {
                  "call": {
                    "$ref": "#/$defs/ToolCall",
                    "description": "The call."
                  },
                  "id": {
                    "description": "Call id, matched by `ToolResult`.",
                    "type": "string"
                  },
                  "type": {
                    "const": "tool",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "id",
                  "call"
                ],
                "type": "object"
              },
              {
                "description": "A tool call finished.",
                "properties": {
                  "id": {
                    "description": "Id of the call.",
                    "type": "string"
                  },
                  "ok": {
                    "description": "Whether it succeeded.",
                    "type": "boolean"
                  },
                  "summary": {
                    "description": "Short human-readable outcome.",
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "type": {
                    "const": "tool_result",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "id",
                  "ok"
                ],
                "type": "object"
              },
              {
                "description": "Token usage so far.",
                "properties": {
                  "inputTokens": {
                    "description": "Input tokens.",
                    "format": "uint64",
                    "minimum": 0,
                    "type": "integer"
                  },
                  "outputTokens": {
                    "description": "Output tokens.",
                    "format": "uint64",
                    "minimum": 0,
                    "type": "integer"
                  },
                  "type": {
                    "const": "usage",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "inputTokens",
                  "outputTokens"
                ],
                "type": "object"
              },
              {
                "description": "The harness asks a human questions.",
                "properties": {
                  "questions": {
                    "description": "The questions.",
                    "items": {
                      "$ref": "#/$defs/Question"
                    },
                    "type": "array"
                  },
                  "requestId": {
                    "description": "Id the answer is sent against.",
                    "type": "string"
                  },
                  "type": {
                    "const": "needs_input",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "requestId",
                  "questions"
                ],
                "type": "object"
              },
              {
                "description": "The harness asks a human to approve an action.",
                "properties": {
                  "requestId": {
                    "description": "Id the decision is sent against.",
                    "type": "string"
                  },
                  "subject": {
                    "$ref": "#/$defs/ApprovalSubject",
                    "description": "What is being approved."
                  },
                  "type": {
                    "const": "needs_approval",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "requestId",
                  "subject"
                ],
                "type": "object"
              },
              {
                "description": "An approval request was resolved, by a person, a policy rule, a time limit or the\nrepeat-denial rule. Follows the `NeedsApproval` it answers, so a transcript shows why the\nharness was told yes or no. Only daemons that negotiate the `approval.history` feature\nemit it.",
                "properties": {
                  "by": {
                    "$ref": "#/$defs/ResolvedBy",
                    "description": "Who or what decided."
                  },
                  "decision": {
                    "$ref": "#/$defs/ApprovalOutcome",
                    "description": "What the harness was told."
                  },
                  "message": {
                    "description": "For a denial, the reason: a rule's message, or the one a human gave with\n`approval.decide`. It also goes to the harness where the harness can take text; the\nharness's own decision type carries none, so this is where the reason is kept.",
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "requestId": {
                    "description": "The `request_id` of the `NeedsApproval` this answers.",
                    "type": "string"
                  },
                  "type": {
                    "const": "approval_resolved",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "requestId",
                  "decision",
                  "by"
                ],
                "type": "object"
              },
              {
                "description": "A message from the human, added by `run.steer`. Only daemons that negotiate the\n`run.steer` feature emit it.",
                "properties": {
                  "text": {
                    "description": "The message text.",
                    "type": "string"
                  },
                  "type": {
                    "const": "user_message",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "text"
                ],
                "type": "object"
              },
              {
                "description": "The run ended; always the last event.",
                "properties": {
                  "diagnostic": {
                    "description": "Failure detail, when `stop` is `error`.",
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "result": {
                    "description": "Final result text.",
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "stop": {
                    "$ref": "#/$defs/StopReason",
                    "description": "Why it stopped."
                  },
                  "type": {
                    "const": "done",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "stop"
                ],
                "type": "object"
              }
            ]
          },
          "Question": {
            "description": "One question put to a human by a harness.",
            "properties": {
              "id": {
                "description": "Identifier the answer refers to.",
                "type": "string"
              },
              "multiSelect": {
                "default": false,
                "description": "Whether more than one option may be chosen.",
                "type": "boolean"
              },
              "options": {
                "default": [],
                "description": "Suggested answers; empty for free text.",
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "prompt": {
                "description": "The question text.",
                "type": "string"
              }
            },
            "required": [
              "id",
              "prompt"
            ],
            "type": "object"
          },
          "ResolvedBy": {
            "description": "Who or what resolved an approval request, and so why the transcript shows the outcome it\ndoes.",
            "oneOf": [
              {
                "description": "A person decided it.",
                "properties": {
                  "type": {
                    "const": "human",
                    "type": "string"
                  }
                },
                "required": [
                  "type"
                ],
                "type": "object"
              },
              {
                "description": "A rule of the policy decided it, with no question asked. `name` is the rule's `note`, or\n`rules[N]` when it has none, or `default` when no rule matched and the policy's default\neffect applied.",
                "properties": {
                  "name": {
                    "description": "The rule's name.",
                    "type": "string"
                  },
                  "type": {
                    "const": "rule",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "name"
                ],
                "type": "object"
              },
              {
                "description": "Nobody decided before the approval's time limit, or the run ended or the daemon\nrestarted first. Always an outcome of `denied`.",
                "properties": {
                  "type": {
                    "const": "expired",
                    "type": "string"
                  }
                },
                "required": [
                  "type"
                ],
                "type": "object"
              },
              {
                "description": "The same action was denied earlier in this run, so it was denied again unasked.",
                "properties": {
                  "type": {
                    "const": "repeat_denial",
                    "type": "string"
                  }
                },
                "required": [
                  "type"
                ],
                "type": "object"
              }
            ]
          },
          "Seq": {
            "description": "A per-run event sequence number. A run's journal numbers its events from 1 without gaps; a\n`from` of `Seq(0)` therefore means \"from the start\".",
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "SessionRef": {
            "description": "An opaque handle a harness gives for resuming a conversation.",
            "type": "string"
          },
          "StopReason": {
            "description": "Why an executor stopped, carried by `ExecEvent::Done`.",
            "oneOf": [
              {
                "const": "completed",
                "description": "The harness finished its turn normally.",
                "type": "string"
              },
              {
                "const": "interrupted",
                "description": "The harness was stopped before finishing.",
                "type": "string"
              },
              {
                "const": "error",
                "description": "The harness failed. A failing harness ends with this, never with a stream error.",
                "type": "string"
              },
              {
                "const": "refusal",
                "description": "The model declined the request.",
                "type": "string"
              },
              {
                "const": "max_tokens",
                "description": "The model hit its output limit.",
                "type": "string"
              }
            ]
          },
          "ToolCall": {
            "description": "A tool invocation as far as Reno needs to know it.",
            "properties": {
              "class": {
                "$ref": "#/$defs/ActionClass",
                "default": "other",
                "description": "What kind of action this is, the same vocabulary approvals use. Every executor fills it,\nso views and policy never need a harness's own tool names. Absent on the wire means\n[`ActionClass::Other`]."
              },
              "input": {
                "default": null,
                "description": "The tool's input, verbatim."
              },
              "name": {
                "description": "Tool name as the harness reports it (`Bash`, `exec`, `mcp__server__tool`, …). Names\ndiffer between harnesses; use [`ToolCall::class`] to treat calls alike.",
                "type": "string"
              }
            },
            "required": [
              "name"
            ],
            "type": "object"
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "description": "One item of the `run.events` subscription.",
        "properties": {
          "event": {
            "$ref": "#/$defs/ExecEvent",
            "description": "The event."
          },
          "seq": {
            "$ref": "#/$defs/Seq",
            "description": "Position in the run's journal, counted from 1."
          }
        },
        "required": [
          "seq",
          "event"
        ],
        "title": "RunEventItem",
        "type": "object"
      },
      "name": "run.events",
      "params": {
        "$defs": {
          "RunId": {
            "pattern": "^run_[A-Za-z0-9]{1,64}$",
            "type": "string"
          },
          "Seq": {
            "description": "A per-run event sequence number. A run's journal numbers its events from 1 without gaps; a\n`from` of `Seq(0)` therefore means \"from the start\".",
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "description": "Params of the `run.events` subscription.",
        "properties": {
          "fromSeq": {
            "anyOf": [
              {
                "$ref": "#/$defs/Seq"
              },
              {
                "type": "null"
              }
            ],
            "description": "First sequence number to deliver, **inclusive** — the value a `sub.gap` names as\n`resumeFrom`. A run's journal numbers its events from 1, so `0` and an absent value both\nstart from the beginning."
          },
          "runId": {
            "$ref": "#/$defs/RunId",
            "description": "The run to follow."
          }
        },
        "required": [
          "runId"
        ],
        "title": "RunEventsParams",
        "type": "object"
      }
    },
    {
      "item": {
        "$defs": {
          "BotPin": {
            "description": "The version of a bot's definition a run is pinned to.",
            "properties": {
              "name": {
                "description": "The bot's name.",
                "type": "string"
              },
              "version": {
                "description": "The version of its definition when the run was submitted.",
                "format": "uint32",
                "minimum": 0,
                "type": "integer"
              }
            },
            "required": [
              "name",
              "version"
            ],
            "type": "object"
          },
          "ExecutorId": {
            "pattern": "^[A-Za-z0-9._-]{1,64}$",
            "type": "string"
          },
          "RunId": {
            "pattern": "^run_[A-Za-z0-9]{1,64}$",
            "type": "string"
          },
          "RunStatus": {
            "description": "Where a run is in its lifecycle. Serialised as a snake_case string.",
            "oneOf": [
              {
                "const": "queued",
                "description": "Waiting for a dispatcher to claim it.",
                "type": "string"
              },
              {
                "const": "leased",
                "description": "Claimed under a lease and fence; the executor is not yet running.",
                "type": "string"
              },
              {
                "const": "running",
                "description": "The executor is working.",
                "type": "string"
              },
              {
                "const": "waiting_input",
                "description": "Paused on an `ExecEvent::NeedsInput`.",
                "type": "string"
              },
              {
                "const": "waiting_approval",
                "description": "Paused on an `ExecEvent::NeedsApproval`.",
                "type": "string"
              },
              {
                "const": "evaluating",
                "description": "The harness finished; checks and verdicts are being gathered.",
                "type": "string"
              },
              {
                "const": "succeeded",
                "description": "Evaluation passed. Terminal.",
                "type": "string"
              },
              {
                "const": "failed",
                "description": "Evaluation failed or the harness errored. Terminal, except that a retry re-queues it.",
                "type": "string"
              },
              {
                "const": "interrupted",
                "description": "The daemon or executor stopped mid-run; resume or human review decides what follows.",
                "type": "string"
              },
              {
                "const": "cancelled",
                "description": "Cancelled before or after interruption. Terminal.",
                "type": "string"
              }
            ]
          },
          "RunSummary": {
            "description": "One run, as shown in lists and watches.",
            "properties": {
              "attempt": {
                "description": "Attempt number, from 1.",
                "format": "uint32",
                "minimum": 0,
                "type": "integer"
              },
              "bot": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/BotPin"
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "The bot the run was submitted for, and the version of its definition the run is pinned\nto. Absent for a run submitted without a bot."
              },
              "createdAtMs": {
                "description": "Creation time, in milliseconds since the Unix epoch.",
                "format": "uint64",
                "minimum": 0,
                "type": "integer"
              },
              "executor": {
                "$ref": "#/$defs/ExecutorId",
                "description": "The executor running it."
              },
              "model": {
                "description": "The model the run was asked for, or the one the executor reported once it started.",
                "type": [
                  "string",
                  "null"
                ]
              },
              "prompt": {
                "description": "The prompt the task was submitted with. Absent from daemons that predate it. In\n`run.list` and `runs.watch` it is cut to [`PROMPT_SUMMARY_CHARS`] characters, ending in\n`…` when cut; `run.get` returns it whole.",
                "type": [
                  "string",
                  "null"
                ]
              },
              "runId": {
                "$ref": "#/$defs/RunId",
                "description": "The run."
              },
              "status": {
                "$ref": "#/$defs/RunStatus",
                "description": "Current lifecycle state."
              },
              "stopReason": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/StopReason"
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "Why it stopped, once it has."
              },
              "taskId": {
                "$ref": "#/$defs/TaskId",
                "description": "The task it attempts."
              },
              "title": {
                "description": "First line of the prompt, for display.",
                "type": "string"
              },
              "updatedAtMs": {
                "description": "Last state change, in milliseconds since the Unix epoch.",
                "format": "uint64",
                "minimum": 0,
                "type": "integer"
              }
            },
            "required": [
              "runId",
              "taskId",
              "executor",
              "status",
              "attempt",
              "title",
              "createdAtMs",
              "updatedAtMs"
            ],
            "type": "object"
          },
          "StopReason": {
            "description": "Why an executor stopped, carried by `ExecEvent::Done`.",
            "oneOf": [
              {
                "const": "completed",
                "description": "The harness finished its turn normally.",
                "type": "string"
              },
              {
                "const": "interrupted",
                "description": "The harness was stopped before finishing.",
                "type": "string"
              },
              {
                "const": "error",
                "description": "The harness failed. A failing harness ends with this, never with a stream error.",
                "type": "string"
              },
              {
                "const": "refusal",
                "description": "The model declined the request.",
                "type": "string"
              },
              {
                "const": "max_tokens",
                "description": "The model hit its output limit.",
                "type": "string"
              }
            ]
          },
          "TaskId": {
            "pattern": "^task_[A-Za-z0-9]{1,64}$",
            "type": "string"
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "description": "One item of the `runs.watch` subscription: the whole current list (latest value wins). The\nfirst item is always the current list, sent immediately on subscribe.",
        "properties": {
          "runs": {
            "description": "Current runs, newest first.",
            "items": {
              "$ref": "#/$defs/RunSummary"
            },
            "type": "array"
          }
        },
        "required": [
          "runs"
        ],
        "title": "RunsSnapshot",
        "type": "object"
      },
      "name": "runs.watch",
      "params": {
        "$defs": {
          "RunStatus": {
            "description": "Where a run is in its lifecycle. Serialised as a snake_case string.",
            "oneOf": [
              {
                "const": "queued",
                "description": "Waiting for a dispatcher to claim it.",
                "type": "string"
              },
              {
                "const": "leased",
                "description": "Claimed under a lease and fence; the executor is not yet running.",
                "type": "string"
              },
              {
                "const": "running",
                "description": "The executor is working.",
                "type": "string"
              },
              {
                "const": "waiting_input",
                "description": "Paused on an `ExecEvent::NeedsInput`.",
                "type": "string"
              },
              {
                "const": "waiting_approval",
                "description": "Paused on an `ExecEvent::NeedsApproval`.",
                "type": "string"
              },
              {
                "const": "evaluating",
                "description": "The harness finished; checks and verdicts are being gathered.",
                "type": "string"
              },
              {
                "const": "succeeded",
                "description": "Evaluation passed. Terminal.",
                "type": "string"
              },
              {
                "const": "failed",
                "description": "Evaluation failed or the harness errored. Terminal, except that a retry re-queues it.",
                "type": "string"
              },
              {
                "const": "interrupted",
                "description": "The daemon or executor stopped mid-run; resume or human review decides what follows.",
                "type": "string"
              },
              {
                "const": "cancelled",
                "description": "Cancelled before or after interruption. Terminal.",
                "type": "string"
              }
            ]
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "description": "Params of the `runs.watch` subscription.",
        "properties": {
          "status": {
            "description": "Only runs in one of these states; all runs when absent.",
            "items": {
              "$ref": "#/$defs/RunStatus"
            },
            "type": [
              "array",
              "null"
            ]
          }
        },
        "title": "RunsWatchParams",
        "type": "object"
      }
    },
    {
      "item": {
        "$defs": {
          "ActionClass": {
            "description": "What kind of action an approval is about.",
            "oneOf": [
              {
                "const": "read",
                "description": "Reading files.",
                "type": "string"
              },
              {
                "const": "edit",
                "description": "Editing files.",
                "type": "string"
              },
              {
                "const": "command",
                "description": "Running a command.",
                "type": "string"
              },
              {
                "const": "network",
                "description": "Network access.",
                "type": "string"
              },
              {
                "const": "mcp_tool",
                "description": "An MCP tool call.",
                "type": "string"
              },
              {
                "const": "other",
                "description": "Anything else.",
                "type": "string"
              }
            ]
          },
          "Approval": {
            "description": "An action a harness is held on, waiting for a human decision.",
            "properties": {
              "id": {
                "$ref": "#/$defs/ApprovalId",
                "description": "The approval, as `approval.decide` refers to it."
              },
              "requestedAtMs": {
                "description": "When the action was held, in milliseconds since the Unix epoch.",
                "format": "uint64",
                "minimum": 0,
                "type": "integer"
              },
              "runId": {
                "$ref": "#/$defs/RunId",
                "description": "The run that is held."
              },
              "subject": {
                "$ref": "#/$defs/ApprovalSubject",
                "description": "Exactly what is being approved."
              }
            },
            "required": [
              "id",
              "runId",
              "subject",
              "requestedAtMs"
            ],
            "type": "object"
          },
          "ApprovalId": {
            "pattern": "^appr_[A-Za-z0-9]{1,64}$",
            "type": "string"
          },
          "ApprovalSubject": {
            "description": "The exact thing a human is asked to approve.",
            "properties": {
              "action": {
                "$ref": "#/$defs/ActionClass",
                "description": "Class of the action."
              },
              "command": {
                "description": "The command line, for command actions.",
                "type": [
                  "string",
                  "null"
                ]
              },
              "paths": {
                "default": [],
                "description": "Paths the action touches.",
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "raw": {
                "default": null,
                "description": "The harness's own request, kept for the audit record."
              },
              "tool": {
                "description": "Tool the action goes through.",
                "type": "string"
              }
            },
            "required": [
              "action",
              "tool"
            ],
            "type": "object"
          },
          "RunId": {
            "pattern": "^run_[A-Za-z0-9]{1,64}$",
            "type": "string"
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "description": "One item of the `approvals.watch` subscription: the whole pending list (latest value wins).\nThe first item is the list as it stands when the subscription starts.",
        "properties": {
          "approvals": {
            "description": "Pending approvals, oldest first.",
            "items": {
              "$ref": "#/$defs/Approval"
            },
            "type": "array"
          }
        },
        "required": [
          "approvals"
        ],
        "title": "ApprovalsSnapshot",
        "type": "object"
      },
      "name": "approvals.watch",
      "params": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "description": "Params of the `approvals.watch` subscription.",
        "title": "ApprovalsWatchParams",
        "type": "object"
      }
    },
    {
      "item": {
        "$defs": {
          "DefError": {
            "description": "One problem with a definition, located by file and by a path inside it.\n\nDisplays as `bots/keeper.toml: executors[2]: unknown executor \"x\"`. A problem with the file\nas a whole has an empty `path` and displays as `bots/keeper.toml: <message>`.",
            "properties": {
              "file": {
                "description": "The file, relative to the definitions root.",
                "type": "string"
              },
              "message": {
                "description": "What is wrong, for a person.",
                "type": "string"
              },
              "path": {
                "description": "The field inside it, such as `executors[2]` or `target.bot`; empty for the whole file.",
                "type": "string"
              }
            },
            "required": [
              "file",
              "message"
            ],
            "type": "object"
          },
          "DefKind": {
            "description": "The kinds of definition this version loads. Teams and flows join with their tasks.",
            "oneOf": [
              {
                "const": "bot",
                "description": "A bot: `bots/<name>.toml`.",
                "type": "string"
              },
              {
                "const": "trigger",
                "description": "A trigger: `triggers/<name>.toml`.",
                "type": "string"
              },
              {
                "const": "policy",
                "description": "The policy: `policy.toml`.",
                "type": "string"
              }
            ]
          },
          "DefSummary": {
            "description": "One stored version of one definition, without its body.",
            "properties": {
              "createdAtMs": {
                "description": "When this version was first stored, in milliseconds since the Unix epoch.",
                "format": "uint64",
                "minimum": 0,
                "type": "integer"
              },
              "hash": {
                "description": "The content hash of the version: 64 lowercase hex digits.",
                "type": "string"
              },
              "kind": {
                "$ref": "#/$defs/DefKind",
                "description": "The kind."
              },
              "name": {
                "description": "The name; `policy` for the policy.",
                "type": "string"
              },
              "version": {
                "description": "The version, counted from 1 per name.",
                "format": "uint32",
                "minimum": 0,
                "type": "integer"
              }
            },
            "required": [
              "kind",
              "name",
              "version",
              "hash",
              "createdAtMs"
            ],
            "type": "object"
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "description": "The current definitions and the problems with the files, as the daemon holds them.\n\nWhen `errors` is not empty the files on disk do not validate, and `defs` is the last set that\ndid: the daemon keeps running on it until the files are fixed.",
        "properties": {
          "defs": {
            "description": "The current version of every definition, by kind and then name.",
            "items": {
              "$ref": "#/$defs/DefSummary"
            },
            "type": "array"
          },
          "errors": {
            "default": [],
            "description": "Every problem found in the last load; empty when the files are valid.",
            "items": {
              "$ref": "#/$defs/DefError"
            },
            "type": "array"
          }
        },
        "required": [
          "defs"
        ],
        "title": "DefsSnapshot",
        "type": "object"
      },
      "name": "defs.watch",
      "params": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "description": "Params of the `defs.watch` subscription: none.",
        "title": "DefsWatchParams",
        "type": "object"
      }
    },
    {
      "item": {
        "$defs": {
          "RunId": {
            "pattern": "^run_[A-Za-z0-9]{1,64}$",
            "type": "string"
          },
          "TriggerInfo": {
            "description": "One trigger and its state.",
            "properties": {
              "backoffUntilMs": {
                "description": "Until when it is backed off.",
                "format": "uint64",
                "minimum": 0,
                "type": [
                  "integer",
                  "null"
                ]
              },
              "bot": {
                "description": "The bot it starts.",
                "type": "string"
              },
              "error": {
                "description": "Why it cannot run, when `status` is `failed`.",
                "type": [
                  "string",
                  "null"
                ]
              },
              "failures": {
                "description": "Consecutive account-level failures to start; `0` when healthy.",
                "format": "uint32",
                "minimum": 0,
                "type": "integer"
              },
              "kind": {
                "description": "The `kind` of its `when`: `at`, `after`, `every`, `cron`, `fs` or `manual`.",
                "type": "string"
              },
              "lastFiredAtMs": {
                "description": "When it last started a run (or merged into one).",
                "format": "uint64",
                "minimum": 0,
                "type": [
                  "integer",
                  "null"
                ]
              },
              "lastRunId": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/RunId"
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "The run it last started."
              },
              "name": {
                "description": "The trigger's name.",
                "type": "string"
              },
              "nextDueAtMs": {
                "description": "When it fires next. Absent for `fs`, `manual`, a finished one-shot and a disabled trigger.",
                "format": "uint64",
                "minimum": 0,
                "type": [
                  "integer",
                  "null"
                ]
              },
              "status": {
                "$ref": "#/$defs/TriggerStatus",
                "description": "Where it stands."
              },
              "version": {
                "description": "The version of the definition in force.",
                "format": "uint32",
                "minimum": 0,
                "type": "integer"
              }
            },
            "required": [
              "name",
              "kind",
              "bot",
              "version",
              "status",
              "failures"
            ],
            "type": "object"
          },
          "TriggerStatus": {
            "description": "Where a trigger stands.",
            "oneOf": [
              {
                "const": "scheduled",
                "description": "Waiting for its next due time (`nextDueAtMs`).",
                "type": "string"
              },
              {
                "const": "watching",
                "description": "Watching files (`fs`).",
                "type": "string"
              },
              {
                "const": "manual",
                "description": "Fires only when asked (`manual`).",
                "type": "string"
              },
              {
                "const": "done",
                "description": "A one-shot (`at`, `after`) that has fired.",
                "type": "string"
              },
              {
                "const": "backed_off",
                "description": "Backed off after repeated failures to start; fires again at `backoffUntilMs`.",
                "type": "string"
              },
              {
                "const": "disabled",
                "description": "Disabled in its definition.",
                "type": "string"
              },
              {
                "const": "failed",
                "description": "Cannot run: see `error`.",
                "type": "string"
              }
            ]
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "description": "One item of the `triggers.watch` subscription: every trigger and its state (latest value\nwins). The first item is the list as it stands when the subscription starts.",
        "properties": {
          "triggers": {
            "description": "Every trigger in the definitions in force, by name.",
            "items": {
              "$ref": "#/$defs/TriggerInfo"
            },
            "type": "array"
          }
        },
        "required": [
          "triggers"
        ],
        "title": "TriggersSnapshot",
        "type": "object"
      },
      "name": "triggers.watch",
      "params": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "description": "Params of the `triggers.watch` subscription.",
        "title": "TriggersWatchParams",
        "type": "object"
      }
    },
    {
      "item": {
        "$defs": {
          "AccessMode": {
            "description": "How much a harness may do without asking. Never run with more than requested (ARCH-15).",
            "oneOf": [
              {
                "const": "supervised",
                "description": "Every consequential action needs approval.",
                "type": "string"
              },
              {
                "const": "auto_accept_edits",
                "description": "File edits proceed; commands and network still ask.",
                "type": "string"
              },
              {
                "const": "full_access",
                "description": "The harness asks nothing.",
                "type": "string"
              }
            ]
          },
          "ExecutorCaps": {
            "description": "What an executor declares it can do. Nothing is trusted beyond this (ARCH-15).",
            "properties": {
              "accessModes": {
                "description": "Access modes the executor can honour.",
                "items": {
                  "$ref": "#/$defs/AccessMode"
                },
                "type": "array"
              },
              "deterministicTurnEnd": {
                "description": "Whether the end of a turn is reported deterministically.",
                "type": "boolean"
              },
              "mcpInjection": {
                "description": "False means it cannot join a team or use boards.",
                "type": "boolean"
              },
              "models": {
                "description": "Models on offer.",
                "items": {
                  "$ref": "#/$defs/ModelInfo"
                },
                "type": "array"
              },
              "planMode": {
                "description": "Whether a plan mode exists.",
                "type": "boolean"
              },
              "resume": {
                "description": "Whether sessions can be resumed.",
                "type": "boolean"
              },
              "sandboxLevels": {
                "description": "Sandbox levels the executor can honour: a run is only started at a level listed here. An\nexecutor with no sandbox of its own honours only `Unrestricted`.",
                "items": {
                  "$ref": "#/$defs/SandboxLevel"
                },
                "type": "array"
              },
              "steering": {
                "$ref": "#/$defs/Steering",
                "description": "When steering messages can land."
              },
              "structuredOutput": {
                "description": "Whether `output_schema` is honoured.",
                "type": "boolean"
              }
            },
            "required": [
              "steering",
              "resume",
              "accessModes",
              "sandboxLevels",
              "mcpInjection",
              "structuredOutput",
              "deterministicTurnEnd",
              "planMode",
              "models"
            ],
            "type": "object"
          },
          "ExecutorDescriptor": {
            "description": "An installed harness and what it can do.",
            "properties": {
              "adapterVersion": {
                "description": "Driver version plus the detected harness CLI version.",
                "type": "string"
              },
              "caps": {
                "$ref": "#/$defs/ExecutorCaps",
                "description": "Declared capabilities."
              },
              "cliVerified": {
                "$ref": "#/$defs/VersionRange",
                "description": "Supported harness CLI versions."
              },
              "contractVersion": {
                "description": "Version of the Reno executor contract the adapter implements.",
                "format": "uint32",
                "minimum": 0,
                "type": "integer"
              },
              "id": {
                "$ref": "#/$defs/ExecutorId",
                "description": "Executor id, for example `claude-code`."
              }
            },
            "required": [
              "id",
              "contractVersion",
              "adapterVersion",
              "cliVerified",
              "caps"
            ],
            "type": "object"
          },
          "ExecutorHealth": {
            "description": "What the daemon last found out about one executor.",
            "properties": {
              "checkedAtMs": {
                "description": "When the probe finished, in milliseconds since the Unix epoch.",
                "format": "uint64",
                "minimum": 0,
                "type": "integer"
              },
              "installed": {
                "$ref": "#/$defs/InstallStatus",
                "description": "Whether and where the harness is installed."
              },
              "models": {
                "$ref": "#/$defs/ModelCatalog",
                "description": "The models on offer, and whether they came from the live harness or the adapter's list."
              },
              "signedIn": {
                "$ref": "#/$defs/SignedIn",
                "description": "Whether the harness is signed in."
              },
              "versionGate": {
                "$ref": "#/$defs/VersionGate",
                "description": "The installed version against the verified range."
              }
            },
            "required": [
              "installed",
              "versionGate",
              "signedIn",
              "models",
              "checkedAtMs"
            ],
            "type": "object"
          },
          "ExecutorId": {
            "pattern": "^[A-Za-z0-9._-]{1,64}$",
            "type": "string"
          },
          "ExecutorInfo": {
            "description": "One executor as `executor.list` shows it.",
            "properties": {
              "descriptor": {
                "$ref": "#/$defs/ExecutorDescriptor",
                "description": "What the executor declares it can do. Its `caps.models` is the list `health.models`\nlabels: the live list when a probe got one, else the curated list."
              },
              "health": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/ExecutorHealth"
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "The last probe. Absent until the first probe of this executor has finished."
              }
            },
            "required": [
              "descriptor"
            ],
            "type": "object"
          },
          "InstallStatus": {
            "description": "Whether the harness can be launched, and from where.",
            "oneOf": [
              {
                "description": "A launchable program was found.",
                "properties": {
                  "path": {
                    "description": "The program a run would launch.",
                    "type": "string"
                  },
                  "type": {
                    "const": "installed",
                    "type": "string"
                  },
                  "version": {
                    "description": "Its version, when it could be read.",
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                },
                "required": [
                  "type",
                  "path"
                ],
                "type": "object"
              },
              {
                "description": "Nothing launchable.",
                "properties": {
                  "type": {
                    "const": "not_installed",
                    "type": "string"
                  },
                  "why": {
                    "$ref": "#/$defs/NotInstalledReason",
                    "description": "Why."
                  }
                },
                "required": [
                  "type",
                  "why"
                ],
                "type": "object"
              }
            ]
          },
          "ModelCatalog": {
            "description": "The models an executor offers and where the list came from.",
            "properties": {
              "models": {
                "description": "The models.",
                "items": {
                  "$ref": "#/$defs/ModelInfo"
                },
                "type": "array"
              },
              "source": {
                "$ref": "#/$defs/ModelSource",
                "description": "Where the list came from."
              }
            },
            "required": [
              "source",
              "models"
            ],
            "type": "object"
          },
          "ModelInfo": {
            "description": "A model an executor offers.",
            "properties": {
              "displayName": {
                "description": "Display name.",
                "type": [
                  "string",
                  "null"
                ]
              },
              "id": {
                "description": "Model id as passed to the harness.",
                "type": "string"
              }
            },
            "required": [
              "id"
            ],
            "type": "object"
          },
          "ModelSource": {
            "description": "Where a list of models came from.",
            "oneOf": [
              {
                "const": "curated",
                "description": "The adapter's built-in list.",
                "type": "string"
              },
              {
                "const": "live",
                "description": "Asked of the live harness by the last probe.",
                "type": "string"
              }
            ]
          },
          "NotInstalledReason": {
            "description": "Why a harness cannot be launched.",
            "oneOf": [
              {
                "description": "No program was found where the driver looks.",
                "properties": {
                  "hint": {
                    "description": "Where it looks and how to get it, for a person.",
                    "type": "string"
                  },
                  "type": {
                    "const": "not_found",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "hint"
                ],
                "type": "object"
              },
              {
                "description": "The agent's launcher needs a managed install (an adapter package or a release archive)\nthat has not been done. A run never installs: this is an explicit step.",
                "properties": {
                  "type": {
                    "const": "needs_install",
                    "type": "string"
                  },
                  "what": {
                    "description": "What would be installed.",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "what"
                ],
                "type": "object"
              },
              {
                "description": "Something is there but cannot be launched (an override that points at nothing, a file\nthat is not executable).",
                "properties": {
                  "detail": {
                    "description": "What is wrong with it.",
                    "type": "string"
                  },
                  "type": {
                    "const": "unusable",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "detail"
                ],
                "type": "object"
              },
              {
                "description": "The probe itself failed, so nothing is known.",
                "properties": {
                  "detail": {
                    "description": "What happened.",
                    "type": "string"
                  },
                  "type": {
                    "const": "probe_failed",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "detail"
                ],
                "type": "object"
              }
            ]
          },
          "SandboxLevel": {
            "description": "The sandbox the harness itself enforces around its tools: a ceiling below the access mode.\nA run that asks for `ReadOnly` or `WorkspaceWrite` goes only to an executor that enforces that\nlevel; `Unrestricted` asks for no ceiling beyond the access mode, so every executor can take it.",
            "oneOf": [
              {
                "const": "read_only",
                "description": "No writes.",
                "type": "string"
              },
              {
                "const": "workspace_write",
                "description": "Writes confined to the workspace.",
                "type": "string"
              },
              {
                "const": "unrestricted",
                "description": "No sandbox ceiling beyond the access mode (and the run's worktree).",
                "type": "string"
              }
            ]
          },
          "SignedIn": {
            "description": "Whether the harness has a login.",
            "oneOf": [
              {
                "description": "A login exists.",
                "properties": {
                  "account": {
                    "description": "Who, when the harness says.",
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "type": {
                    "const": "yes",
                    "type": "string"
                  }
                },
                "required": [
                  "type"
                ],
                "type": "object"
              },
              {
                "description": "No login: not eligible.",
                "properties": {
                  "hint": {
                    "description": "What to do about it.",
                    "type": "string"
                  },
                  "type": {
                    "const": "no",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "hint"
                ],
                "type": "object"
              },
              {
                "description": "The harness offers no way to tell without running a model call. Stays eligible.",
                "properties": {
                  "type": {
                    "const": "unknown",
                    "type": "string"
                  }
                },
                "required": [
                  "type"
                ],
                "type": "object"
              }
            ]
          },
          "Steering": {
            "description": "When a running harness can accept a steering message.",
            "oneOf": [
              {
                "const": "none",
                "description": "Cannot be steered mid-run.",
                "type": "string"
              },
              {
                "const": "turn_boundary",
                "description": "Steering lands at the next turn.",
                "type": "string"
              },
              {
                "const": "step_boundary",
                "description": "Steering lands at the next step.",
                "type": "string"
              }
            ]
          },
          "VersionGate": {
            "description": "The installed version against the adapter's verified range.",
            "oneOf": [
              {
                "description": "At least the minimum, and no newer than the last version the adapter was verified on.",
                "properties": {
                  "type": {
                    "const": "ok",
                    "type": "string"
                  }
                },
                "required": [
                  "type"
                ],
                "type": "object"
              },
              {
                "description": "Older than the minimum the adapter supports: not eligible.",
                "properties": {
                  "min": {
                    "description": "The oldest supported version.",
                    "type": "string"
                  },
                  "type": {
                    "const": "too_old",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "min"
                ],
                "type": "object"
              },
              {
                "description": "Newer than the last version the adapter was verified on: eligible, but unproven.",
                "properties": {
                  "type": {
                    "const": "untested",
                    "type": "string"
                  },
                  "verified": {
                    "description": "The newest version the conformance suite passed on.",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "verified"
                ],
                "type": "object"
              },
              {
                "description": "There is no version to compare: not installed, or the CLI did not report one.",
                "properties": {
                  "type": {
                    "const": "unchecked",
                    "type": "string"
                  }
                },
                "required": [
                  "type"
                ],
                "type": "object"
              }
            ]
          },
          "VersionRange": {
            "description": "Harness CLI versions an adapter supports.",
            "properties": {
              "min": {
                "description": "Oldest supported version.",
                "type": "string"
              },
              "verified": {
                "description": "Newest version the conformance suite passed against.",
                "type": "string"
              }
            },
            "required": [
              "min",
              "verified"
            ],
            "type": "object"
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "description": "One item of the `executors.watch` subscription: every executor and its last health (latest\nvalue wins). The first item is the list as it stands when the subscription starts.",
        "properties": {
          "executors": {
            "description": "The executors, by id.",
            "items": {
              "$ref": "#/$defs/ExecutorInfo"
            },
            "type": "array"
          }
        },
        "required": [
          "executors"
        ],
        "title": "ExecutorsSnapshot",
        "type": "object"
      },
      "name": "executors.watch",
      "params": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "description": "Params of the `executors.watch` subscription.",
        "title": "ExecutorsWatchParams",
        "type": "object"
      }
    }
  ]
}
